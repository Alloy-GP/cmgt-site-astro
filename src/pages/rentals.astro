---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';
import ImageSlot from '~/components/ImageSlot.astro';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'Rentals', url: SITE.url + '/rentals' },
]);
---
<BaseLayout
  title="Rental Property Management — CMGT | Baton Rouge"
  description="Rental property management in Greater Baton Rouge — leasing, screening, rent collection, and maintenance handled. Hands-off ownership for investors."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"Rentals"}]'></nav>

  <!-- HERO -->
  <section class="rn-hero">
    <div class="container rn-hero-grid">
      <div>
        <span class="rn-loc"><span class="pin"></span> Greater Baton Rouge only</span>
        <h1 class="rn-hero-display">Own the property. <span class="u">Skip the headaches.</span></h1>
        <p class="rn-hero-lede">
          Full-service rental management for single-family and small residential investors in
          the Baton Rouge area. <strong>We handle leasing, rent, and maintenance</strong> —
          you collect the deposit and keep your weekends.
        </p>
        <div class="rn-hero-ctas">
          <a class="btn btn-blue" href="/request-a-proposal">Get a rental quote <span class="arrow">→</span></a>
          <a class="btn btn-outline-blue" href="#how">How it works</a>
        </div>
      </div>
      <div class="rn-hero-media">
        <div class="block" aria-hidden="true"></div>
        <ImageSlot src="/photos/rn-hero-photo.webp" alt="A well-kept single-family rental home in the Greater Baton Rouge area with a tidy lawn and inviting front porch" shape="rounded" radius={20} />
      </div>
    </div>
  </section>

  <!-- FIREWALL NOTE -->
  <section class="fw">
    <div class="container fw-in">
      <span class="leaf-ico" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></span>
      <p class="fw-t"><strong>Rental management is a separate service from our HOA community management.</strong> It's offered in the Greater Baton Rouge area only — for property owners and investors, not associations.</p>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="rs">
    <div class="container">
      <div class="rs-head reveal">
        <div class="eyebrow eyebrow-blue">What we handle</div>
        <h2 class="rs-h">Hands-off ownership, done right.</h2>
        <p class="rs-sub">From the first listing photo to the last day of the lease — <strong>one team manages the whole tenancy</strong> so you don't have to field the 9 PM phone calls.</p>
      </div>
      <div class="rs-grid">
        <div class="rs-item reveal"><span class="rs-num">01</span><h3 class="rs-t">Marketing & Leasing</h3><p class="rs-d">Professional listings, showings, and pricing guidance to fill vacancies fast with qualified renters.</p></div>
        <div class="rs-item reveal"><span class="rs-num">02</span><h3 class="rs-t">Tenant Screening</h3><p class="rs-d">Credit, background, income, and rental-history checks — so the right renter signs the lease.</p></div>
        <div class="rs-item reveal"><span class="rs-num">03</span><h3 class="rs-t">Rent Collection</h3><p class="rs-d">On-time online payments, clear owner statements, and direct deposit to your account each month.</p></div>
        <div class="rs-item reveal"><span class="rs-num">04</span><h3 class="rs-t">Maintenance & Repairs</h3><p class="rs-d">Coordinated by our in-house Fix-It Squad — fast, fair, and documented, with your approval on the big stuff.</p></div>
        <div class="rs-item reveal"><span class="rs-num">05</span><h3 class="rs-t">Inspections</h3><p class="rs-d">Move-in, periodic, and move-out inspections with photos — protecting your property and your deposit.</p></div>
        <div class="rs-item reveal"><span class="rs-num">06</span><h3 class="rs-t">Compliance & Renewals</h3><p class="rs-d">Lease paperwork, legal notices, and renewals handled to keep your tenancy smooth and by-the-book.</p></div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="hw" id="how">
    <div class="container">
      <div class="eyebrow eyebrow-blue reveal">How it works</div>
      <h2 class="hw-h reveal">Three steps to a hands-off rental.</h2>
      <div class="hw-steps">
        <div class="hw-step reveal"><div class="hw-step-n">STEP 01</div><h3 class="hw-step-t">Tell us about your property</h3><p class="hw-step-d">Share the address and a few details. We'll assess the rent it should command in today's Baton Rouge market.</p></div>
        <div class="hw-step reveal"><div class="hw-step-n">STEP 02</div><h3 class="hw-step-t">We get it rent-ready & listed</h3><p class="hw-step-d">Make-ready coordination, photos, listing, showings, and screening — we place a qualified tenant.</p></div>
        <div class="hw-step reveal"><div class="hw-step-n">STEP 03</div><h3 class="hw-step-t">You collect, we manage</h3><p class="hw-step-d">Rent hits your account, maintenance is handled, and you get clear statements. That's it.</p></div>
      </div>
    </div>
  </section>

  <!-- OWNER PROOF -->
  <section class="op">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container op-in reveal">
      <div class="eyebrow" style="color: rgba(255,255,255,.6);">From a property owner</div>
      <blockquote class="op-q" style="margin-left:0; margin-right:0;">
        "I own three rentals and used to manage them myself. <span class="g">CMGT gave me my evenings back</span> — and the places have never been better kept."
      </blockquote>
      <div class="op-name">Placeholder — owner name</div>
      <div class="op-meta">Baton Rouge · swap in a real owner quote</div>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="sec-head reveal">
        <div class="eyebrow eyebrow-green">Owner questions</div>
        <h2 class="sec-h">What Baton Rouge owners ask.</h2>
      </div>
      <div class="acc-list reveal">
        <div class="acc-item"><button class="acc-q" type="button">What areas do you cover?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">Rental management is offered in the <strong>Greater Baton Rouge area only</strong>, and it’s a separate service from our HOA community management — built for individual owners and small investors, not associations.</div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">How much does rental management cost?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">We quote each property straightforwardly based on its size and needs — no buried fees. Tell us about your rental and we’ll come back with a clear number within two business days.</div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">How do you screen tenants?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">Every applicant goes through credit, background, income, and rental-history checks before signing — so the right renter ends up in your property.</div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">Who handles repairs and after-hours emergencies?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">Our in-house <a href="/fix-it-squad">Fix-It Squad</a> coordinates maintenance — fast, fair, and documented — with your approval required on the larger jobs.</div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">How and when do I get paid?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">Rent is deposited to your account each month with a clear owner statement, so you always know what came in and what went out.</div></div></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-in">
      <div class="reveal">
        <h2 class="cta-h">Let's talk about your property.</h2>
        <p class="cta-p">Tell us about your Baton Rouge rental and we'll come back with a clear management quote — within two business days.</p>
      </div>
      <div class="cta-actions reveal">
        <a class="btn btn-blue" href="/request-a-proposal">Get a rental quote <span class="arrow">→</span></a>
        <a class="cta-phone" href="tel:2255032648">Or call (225) 503-2648 · Mon–Thu 8:30a–4:30p · Fri 8:30a–4:00p CT</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }

  /* HERO */
  .rn-hero { background: #fff; padding: 84px 0 90px; overflow: hidden; }
  .rn-hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 64px; align-items: center; }
  @media (max-width: 980px) { .rn-hero-grid { grid-template-columns: 1fr; gap: 40px; } }
  .rn-loc { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; letter-spacing: .04em; color: var(--freedom-blue); background: var(--fb-lightest); padding: 7px 14px; border-radius: 999px; }
  .rn-loc .pin { width: 7px; height: 7px; border-radius: 50%; background: var(--landscaping-green); }
  .rn-hero-display { font-family: var(--font-display); font-weight: 900; font-size: clamp(44px, 5.4vw, 80px); line-height: 1.0; letter-spacing: -.025em; color: var(--freedom-blue); margin: 20px 0 24px; text-wrap: balance; }
  .rn-hero-display .u { background: linear-gradient(transparent 80%, var(--landscaping-green) 80%); padding-bottom: .04em; }
  .rn-hero-lede { font-size: 17.5px; line-height: 1.7; color: var(--ink-500); max-width: 500px; margin: 0 0 30px; }
  .rn-hero-lede strong { color: var(--freedom-blue); font-weight: 600; }
  .rn-hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
  .rn-hero-media { position: relative; }
  .rn-hero-media .block { position: absolute; right: -26px; bottom: -26px; width: 66%; height: 54%; background: var(--landscaping-green); border-radius: 20px; z-index: 0; }
  .rn-hero-media :global(.image-slot) { position: relative; z-index: 1; width: 100%; height: 520px; }
  @media (max-width: 980px) { .rn-hero-media :global(.image-slot) { height: 400px; } }

  /* FIREWALL NOTE */
  .fw { background: var(--freedom-blue); color: #fff; padding: 26px 0; }
  .fw-in { display: flex; align-items: center; gap: 16px; justify-content: center; text-align: center; flex-wrap: wrap; }
  .fw-in .leaf-ico { width: 26px; height: 26px; flex: none; }
  .fw-in .leaf-ico img { width: 100%; filter: brightness(0) invert(1); opacity: .8; }
  .fw-t { font-size: 15px; line-height: 1.5; color: rgba(255,255,255,.85); }
  .fw-t strong { color: #fff; font-weight: 600; }

  /* SERVICES */
  .rs { background: #fff; padding: 110px 0; }
  .rs-head { max-width: 680px; margin: 0 0 56px; }
  .rs-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(30px, 3.8vw, 46px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
  .rs-sub { font-size: 16.5px; line-height: 1.7; color: var(--ink-500); margin: 0; }
  .rs-sub strong { color: var(--freedom-blue); font-weight: 600; }
  .rs-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 36px 48px; }
  @media (max-width: 760px) { .rs-grid { grid-template-columns: 1fr; } }
  .rs-item { display: grid; grid-template-columns: 52px 1fr; gap: 2px 18px; padding: 28px 0; border-top: 1.5px solid var(--hairline-strong); }
  .rs-num { font-family: var(--font-display); font-weight: 300; font-style: italic; font-size: 32px; color: var(--landscaping-green); line-height: 1; }
  .rs-t { font-family: var(--font-display); font-weight: 700; font-size: 21px; color: var(--freedom-blue); margin: 0; align-self: center; }
  .rs-d { grid-column: 2; font-size: 15px; line-height: 1.7; color: var(--ink-500); margin: 10px 0 0; }

  /* HOW IT WORKS */
  .hw { background: var(--nb-lightest); padding: 110px 0; }
  .hw-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); max-width: 640px; margin: 16px 0 56px; text-wrap: balance; }
  .hw-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  @media (max-width: 820px) { .hw-steps { grid-template-columns: 1fr; gap: 24px; } }
  .hw-step { position: relative; padding-top: 26px; border-top: 3px solid var(--landscaping-green); }
  .hw-step-n { font-family: var(--font-body); font-weight: 700; font-size: 12px; letter-spacing: .16em; color: var(--ink-400); }
  .hw-step-t { font-family: var(--font-display); font-weight: 700; font-size: 22px; color: var(--freedom-blue); margin: 10px 0 10px; }
  .hw-step-d { font-size: 14.5px; line-height: 1.65; color: var(--ink-500); margin: 0; }

  /* OWNER PROOF */
  .op { background: var(--freedom-blue); color: #fff; padding: 100px 0; position: relative; overflow: hidden; }
  .op .leaf { position: absolute; right: -110px; top: -130px; width: 460px; height: 460px; opacity: .07; transform: rotate(-12deg); pointer-events: none; }
  .op .leaf img { filter: brightness(0) invert(1); }
  .op-in { position: relative; max-width: 880px; }
  .op-q { font-family: var(--font-display); font-weight: 300; font-style: italic; font-size: clamp(26px, 3.4vw, 40px); line-height: 1.3; letter-spacing: -.01em; margin: 16px 0 24px; text-wrap: balance; }
  .op-q .g { color: var(--landscaping-green); font-style: normal; font-weight: 700; }
  .op-name { font-family: var(--font-display); font-weight: 700; font-size: 16px; color: #fff; }
  .op-meta { font-size: 13px; color: rgba(255,255,255,.6); margin-top: 2px; }

  /* CTA */
  .cta { background: var(--landscaping-green); color: var(--freedom-blue); padding: 96px 0; }
  .cta-in { display: flex; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .cta-h { font-family: var(--font-display); font-weight: 900; font-size: clamp(32px, 4.4vw, 56px); line-height: 1.02; letter-spacing: -.02em; margin: 0 0 10px; text-wrap: balance; }
  .cta-p { font-size: 16.5px; line-height: 1.6; max-width: 480px; margin: 0; color: rgba(30,30,119,.82); }
  .cta-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .cta-phone { font-size: 14px; font-weight: 600; color: rgba(30,30,119,.75); text-decoration: none; }
</style>
