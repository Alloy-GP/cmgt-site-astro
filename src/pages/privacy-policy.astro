---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';

const breadcrumb = breadcrumbSchema([
  { name: 'Home',           url: SITE.url + '/' },
  { name: 'Privacy Policy', url: SITE.url + '/privacy-policy' },
]);
---
<BaseLayout
  title="Privacy Policy — CMGT"
  description="CMGT's privacy policy — what information we collect, how we use it, how we share it, and the choices you have. We collect only what we need."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"Privacy Policy"}]'></nav>

  <section class="lg-hero">
    <div class="container lg-hero-in">
      <div class="lg-eyebrow">Legal</div>
      <h1 class="lg-h1">Privacy Policy</h1>
      <p class="lg-intro">CMGT respects your privacy. This policy explains, in plain language, what information we collect, how we use it, and the choices you have. We collect only what we need to serve communities well.</p>
    </div>
  </section>

  <section class="lg-body">
    <div class="container lg-wrap">
      <p class="lg-updated">Last updated: June 2026</p>
      <h2 class="lg-h2">Information we collect</h2><p class="lg-p">When you contact us, request a proposal, or use a homeowner portal, we may collect your name, email, phone number, community details, and the contents of your message. We also collect basic, non-identifying analytics about how our site is used.</p><h2 class="lg-h2">How we use it</h2><p class="lg-p">To respond to your request, route it to the right team, provide management services, and improve our site. We do not sell your personal information. Where you have opted in, we may send occasional updates you can unsubscribe from at any time.</p><h2 class="lg-h2">How we share it</h2><p class="lg-p">We share information only with service providers who help us operate (for example, email, analytics, and form-routing tools), and only as needed to deliver our services. We may disclose information where required by law.</p><h2 class="lg-h2">Your choices</h2><p class="lg-p">You can ask us to access, correct, or delete the personal information we hold about you, and you can opt out of marketing messages at any time. Contact us using the details below and we will respond promptly.</p><h2 class="lg-h2">Data security</h2><p class="lg-p">We use reasonable administrative and technical safeguards to protect your information. No method of transmission is perfectly secure, but we work to keep your data protected.</p><h2 class="lg-h2">Changes to this policy</h2><p class="lg-p">We may update this policy from time to time. Material changes will be reflected by the date below.</p>
      <div class="lg-foot">
        Questions about this policy? Contact us <a href="/request-a-proposal">through our contact page</a>.
        <p class="lg-note">This document is a template provided for the site build and should be reviewed by legal counsel before publication.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  body { background: #fff; }
  .lg-hero { background: var(--nb-lightest); padding: 72px 0 56px; }
  .lg-hero-in { max-width: 760px; }
  .lg-eyebrow { font-family: var(--font-body); font-weight: 700; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--landscaping-green); }
  .lg-h1 { font-family: var(--font-display); font-weight: 400; font-size: clamp(34px, 4.4vw, 58px); line-height: 1.05; letter-spacing: -.025em; color: var(--freedom-blue); margin: 14px 0 18px; }
  .lg-intro { font-size: 17px; line-height: 1.7; color: var(--ink-700); margin: 0; max-width: 640px; }
  .lg-body { background: #fff; padding: 64px 0 96px; }
  .lg-wrap { max-width: 720px; }
  .lg-h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(21px, 2.4vw, 27px); line-height: 1.2; letter-spacing: -.01em; color: var(--freedom-blue); margin: 38px 0 12px; }
  .lg-p { font-size: 16px; line-height: 1.75; color: var(--ink-700); margin: 0; }
  .lg-updated { font-size: 13.5px; color: var(--ink-400); margin: 0 0 8px; }
  .lg-foot { border-top: 1px solid var(--hairline); margin-top: 48px; padding-top: 24px; font-size: 14px; line-height: 1.7; color: var(--ink-500); }
  .lg-foot a { color: var(--freedom-blue); font-weight: 600; text-decoration: none; }
  .lg-note { font-size: 12.5px; color: var(--ink-400); font-style: italic; margin-top: 14px; }
</style>
