---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema, faqSchema, articleSchema } from '~/lib/schema';
import ImageSlot from '~/components/ImageSlot.astro';
import GuideDownload from '~/components/GuideDownload.astro';

// In client review (stg). Companion downloadable: /downloads/cmgt-hoa-annual-meeting-kit.docx.
// NOT on the Resources hub, nav, or review widget yet, and not on prod — add when approved.

const pageUrl = SITE.url + '/resources/hoa-annual-meeting';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'Resources', url: SITE.url + '/resources' },
  { name: 'Governance & Meetings', url: pageUrl },
]);

const article = articleSchema({
  headline: 'How to Prepare for Your HOA Annual Meeting (Timeline, Agenda, and Free Kit)',
  description:
    'How to prepare for your HOA annual meeting: a week-by-week timeline, agenda, notice, quorum and elections, plus a free checklist and templates to download.',
  url: pageUrl,
  datePublished: '2026-09-23',
  image: new URL('/photos/og/hoa-annual-meeting.jpg', SITE.url).toString(),
  about: ['HOA annual meeting', 'HOA board election', 'HOA meeting notice', 'HOA quorum', 'HOA voting rules'],
});

const howTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to prepare for an HOA annual meeting',
  description:
    'A week-by-week timeline that counts backward from the meeting date. Exact days come from your governing documents and state law.',
  tool: [{ '@type': 'HowToTool', name: 'HOA Annual Meeting Kit (free Word file)' }],
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Eight weeks out: confirm the rules and the room', text: "Confirm the date, time, and place, or the virtual format, against your bylaws. Pull your governing documents' rules for notice, quorum, proxies, and voting, and write them down in one place. Then book the room before someone else's baby shower does." },
    { '@type': 'HowToStep', position: 2, name: 'Six to eight weeks out: call for candidates and decide how voting works', text: 'Send the call for board candidates, with a deadline that leaves time to include their statements in the notice. Decide how voting will work: in person, by proxy, by ballot, or electronically where your documents and state law allow it.' },
    { '@type': 'HowToStep', position: 3, name: 'Four to six weeks out: prepare the financials and draft the agenda', text: 'Prepare the financial report and, where applicable, the proposed budget. Draft the agenda; the sample below is a good starting point.' },
    { '@type': 'HowToStep', position: 4, name: 'By your notice deadline: send the official notice', text: 'Send the official meeting notice with the agenda, candidate information, and any proxy or ballot, within the notice period your documents require. Every other date on this list should count backward from that deadline.' },
    { '@type': 'HowToStep', position: 5, name: 'Two weeks out: remind and track', text: 'Send a reminder. Track proxies or ballots received against the quorum you need, so you know early whether to push harder.' },
    { '@type': 'HowToStep', position: 6, name: 'Meeting week: set up and assign roles', text: 'Print sign-in sheets and ballots, confirm who is counting votes, and set up the room or test the meeting link.' },
    { '@type': 'HowToStep', position: 7, name: 'After the meeting: close the loop', text: 'Announce the results, update the board roster, and file the minutes.' },
  ],
};

const faq = faqSchema([
  {
    q: "What happens if an HOA doesn't have an annual meeting?",
    a: 'The board may be out of compliance with its bylaws, directors whose terms have ended may keep serving without a new election, and homeowners may have grounds to request a meeting. The consequences depend on your governing documents and state law.',
  },
  {
    q: 'Is it mandatory for homeowners to attend the HOA annual meeting?',
    a: "Generally, no. But the meeting can't do business without quorum, so every homeowner who attends or returns a proxy or ballot helps the community get its work done, including electing the board.",
  },
  {
    q: 'What is a quorum for an HOA annual meeting?',
    a: "It's the minimum share of members, present or represented, that your bylaws or state law require before the meeting can conduct business. Your governing documents state the number for your community.",
  },
  {
    q: 'How far in advance do you have to send notice of an HOA annual meeting?',
    a: "Whatever your bylaws and state law require, and that varies. Find the deadline first, then build the rest of your timeline backward from it. Your state's HOA law guide in our Resources library is a good place to start.",
  },
  {
    q: 'Can an HOA hold its annual meeting virtually?',
    a: 'Many can, if the governing documents and state law allow it. Check both before you send the notice, since the notice needs to say how homeowners can join.',
  },
]);
---
<BaseLayout
  title="HOA Annual Meeting: Timeline, Agenda & Free Kit | CMGT"
  description="How to prepare for your HOA annual meeting: a week-by-week timeline, agenda, notice, quorum and elections, plus a free checklist and templates to download."
  ogType="article"
  pageSchema={[breadcrumb, article, howTo, faq]}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"Resources","href":"/resources"},{"t":"Governance & Meetings"}]'></nav>

  <article>
    <header class="art-hero">
      <ImageSlot priority src="/photos/hoa-annual-meeting.webp" alt="A Gulf South community clubhouse room set up for an HOA annual meeting, with a sign-in table, agendas, a ballot box, and rows of chairs facing the front table and podium" shape="rect" />
      <div class="container art-hero-in">
        <div class="art-cat">Governance &amp; Meetings</div>
        <h1 class="art-h1">How to prepare for your HOA annual meeting (timeline, agenda, and a free kit).</h1>
        <p class="art-lede">The date&rsquo;s on the calendar, the notice hasn&rsquo;t gone out, and someone at the last board meeting just asked whether you&rsquo;ll have quorum. If your annual meeting is one to three months away, you&rsquo;re right on time.</p>
        <div class="art-meta"><span>8 min read</span><span class="dot"></span><span>Governance &amp; Meetings</span></div>
      </div>
    </header>

    <div class="art-body">
      <div class="container art-wrap">
        <div class="art-take reveal">
          <p class="art-take-h">The short version</p>
          <p class="art-take-p">Start about eight weeks out and plan backward from your notice deadline. Your bylaws set the exact rules; this guide gives you the order: confirm the rules, call for candidates, prepare the financials, send notice on time, chase quorum, run a fair election, and close the loop. The free kit turns it into a checklist, a notice template, and an agenda.</p>
        </div>

        <p class="art-p">This guide gives you a week-by-week timeline, a sample agenda, a plan for quorum and elections, and a free kit you can use this week. No clipboard experience required, though a good pen helps.</p>

        <GuideDownload
          title="Free HOA Annual Meeting Kit"
          blurb="A week-by-week checklist, a notice template, and an agenda template, all in one editable Word file. The checklist opens with a worksheet for the rules in your own governing documents, so you fill those in first."
          href="/downloads/cmgt-hoa-annual-meeting-kit.docx"
          cta="Download the kit"
          meta="Word file · opens in Google Docs · free, no email required"
        />

        <h2 class="art-h2">What is an HOA annual meeting?</h2>
        <p class="art-p">The HOA annual meeting is the once-a-year meeting of all members, usually required by the bylaws, where homeowners elect board members, hear the association&rsquo;s financial report, and often review the budget. Your bylaws probably call it the annual meeting of members.</p>
        <p class="art-p">It&rsquo;s different from a regular board meeting. Board meetings are where directors handle the ongoing work of the association, sometimes with an executive session for sensitive matters. The annual meeting belongs to the homeowners. It&rsquo;s the one time a year the whole community sees the board&rsquo;s work, the financials, and the plan for next year. <strong>Boards that prepare well walk into a room of homeowners who already trust the numbers.</strong></p>
        <p class="art-p">Your bylaws set when the HOA annual meeting happens and what has to be on it, and state law may add requirements. The notice and quorum sections below point to where to check.</p>

        <h2 class="art-h2">Your HOA annual meeting timeline, week by week</h2>
        <p class="art-p">Start about eight weeks out, because notice deadlines and candidate calls take longer than boards expect. <strong>The order is what matters; the exact days come from your governing documents.</strong> The kit&rsquo;s checklist uses these same seven stages and opens with a worksheet for the rules in your documents (notice period, delivery, quorum, proxies, and electronic voting). Fill that in first.</p>

        <h3 class="art-h3">1. Eight weeks out: confirm the rules and the room</h3>
        <p class="art-p">Confirm the date, time, and place, or the virtual format, against your bylaws. Pull your governing documents&rsquo; rules for notice, quorum, proxies, and voting, and write them down in one place. Then book the room before someone else&rsquo;s baby shower does.</p>

        <h3 class="art-h3">2. Six to eight weeks out: call for candidates and decide how voting works</h3>
        <p class="art-p">Send the call for board candidates, with a deadline that leaves time to include their statements in the notice. Decide how voting will work: in person, by proxy, by ballot, or electronically where your documents and state law allow it.</p>

        <h3 class="art-h3">3. Four to six weeks out: prepare the financials and draft the agenda</h3>
        <p class="art-p">Prepare the financial report and, where applicable, the proposed budget. Draft the agenda; the sample below is a good starting point.</p>

        <h3 class="art-h3">4. By your notice deadline: send the official notice</h3>
        <p class="art-p">Send the official meeting notice with the agenda, candidate information, and any proxy or ballot, within the notice period your documents require. Every other date on this list should count backward from that deadline.</p>

        <h3 class="art-h3">5. Two weeks out: remind and track</h3>
        <p class="art-p">Send a reminder. Track proxies or ballots received against the quorum you need, so you know early whether to push harder.</p>

        <h3 class="art-h3">6. Meeting week: set up and assign roles</h3>
        <p class="art-p">Print sign-in sheets and ballots, confirm who is counting votes, and set up the room or test the meeting link.</p>

        <h3 class="art-h3">7. After the meeting: close the loop</h3>
        <p class="art-p">Announce the results, update the board roster, and file the minutes.</p>

        <h2 class="art-h2">What goes on an HOA annual meeting agenda</h2>
        <p class="art-p">A typical HOA annual meeting agenda covers call to order and quorum, approval of last year&rsquo;s minutes, the president&rsquo;s report, the financial report and budget, the election, open forum, and adjournment. Here&rsquo;s the sample from the kit, item for item:</p>
        <ol class="art-ol">
          <li>Call to order</li>
          <li>Establish quorum</li>
          <li>Proof of notice</li>
          <li>Approve last year&rsquo;s annual meeting minutes</li>
          <li>President&rsquo;s report</li>
          <li>Financial report and budget</li>
          <li>Election of directors</li>
          <li>Unfinished and new business, as the bylaws allow</li>
          <li>Open forum</li>
          <li>Announce election results</li>
          <li>Adjourn</li>
        </ol>
        <p class="art-p">If your community presents or ratifies the budget at the HOA annual meeting, give the budget presentation real time on the agenda and have copies ready. Our <a href="/resources/hoa-budget-template">HOA budget template</a> walks through building one homeowners can follow. For open forum, set a time limit per speaker in advance and announce it before the first hand goes up, so everyone gets heard. If your bylaws adopt <a href="https://robertsrules.com/" target="_blank" rel="noopener">Robert&rsquo;s Rules of Order</a>, the official site is a useful reference for motions and procedure. <strong>A clear agenda, sent with the notice, keeps the meeting on schedule and the surprises to a minimum.</strong></p>

        <h2 class="art-h2">HOA meeting notice requirements: get this part right</h2>
        <p class="art-p">Your bylaws and state law set how far in advance notice must go out, how it&rsquo;s delivered, and what it has to include, and a meeting held on defective notice can be challenged. Of all the HOA annual meeting requirements, this is the one where close enough isn&rsquo;t good enough.</p>
        <p class="art-p">A meeting notice typically includes:</p>
        <ul class="art-ul">
          <li>The date, time, and place, or the meeting link</li>
          <li>The agenda</li>
          <li>Board seats up for election and candidate information</li>
          <li>How to vote or give a proxy</li>
          <li>A contact for questions</li>
        </ul>
        <p class="art-p">Electronic notice may be an option where your documents and state law allow it. <strong>Check your HOA meeting notice requirements before the notice goes out, not after.</strong> We manage communities. We don&rsquo;t practice law. For the rules where you are, <a href="/resources">find your state&rsquo;s HOA law guide in our Resources library</a>.</p>

        <h2 class="art-h2">HOA annual meeting quorum: how to reach it, and what to do if you don't</h2>
        <p class="art-p">Quorum is the minimum number of members, present or represented, that the bylaws require for the meeting to conduct business. Without it, the members can&rsquo;t hold the election or vote on anything, and everyone who showed up goes home a little annoyed.</p>

        <h3 class="art-h3">How to reach quorum</h3>
        <p class="art-p">Turnout is mostly a communication job. Start early, send reminders, make proxies or ballots easy to return, and offer a virtual option where your documents allow it. Tell homeowners plainly why it matters: without quorum, the HOA annual meeting can&rsquo;t do its business. In CMGT communities, 70% of homeowners use the portal, which makes reminders easier to send and returns easier to track. <strong>The best quorum plan starts with the first notice, not the week of the meeting.</strong></p>

        <h3 class="art-h3">If you don't reach quorum</h3>
        <p class="art-p">Many bylaws allow the meeting to adjourn and reconvene as an adjourned meeting, sometimes with a lower quorum. Check what yours say before the meeting, so the board walks in with a plan instead of improvising. <strong>Know your documents&rsquo; rule for a missed quorum before you need it.</strong> Your association&rsquo;s attorney and <a href="/resources">your state&rsquo;s HOA law guide</a> can confirm what applies.</p>

        <h2 class="art-h2">Running a fair HOA board election</h2>
        <p class="art-p">A fair board election follows the voting procedures in your documents, treats every candidate the same, and has someone other than a candidate count the votes. HOA voting rules and HOA election rules vary by governing documents and state law, so start there. Most fair elections share the same parts:</p>
        <ul class="art-ul">
          <li>An open candidate call, sent to every homeowner with the same deadline.</li>
          <li>Candidate statements distributed with the notice, in the same format for everyone.</li>
          <li>Ballots and proxies handled exactly as your HOA voting procedures require, including how a proxy form is signed and returned, if proxies are allowed.</li>
          <li>Counting by the manager or volunteer inspectors who aren&rsquo;t on the ballot.</li>
          <li>Results announced at the meeting and recorded in the minutes.</li>
        </ul>
        <p class="art-p">The Community Associations Institute&rsquo;s <a href="https://www.caionline.org/getmedia/6aac5390-af94-41cd-8bbc-d4e41ad6f190/cagovernanceguidelines2021.pdf" target="_blank" rel="noopener">governance guidelines</a> recommend letting each candidate have a representative observe the count, a simple step that heads off most disputes. <strong>A transparent count is what makes people accept the result.</strong></p>

        <h2 class="art-h2">In person, virtual, or hybrid?</h2>
        <p class="art-p">In-person meetings build trust, virtual and hybrid options raise turnout, and which you can use depends on your documents and state law. Some board members and homeowners want a room, a printed agenda, and a handshake. Others would rather join from the kitchen table after the kids are in bed. A hybrid meeting can serve both. <strong>If you go hybrid, hand the technology to one person who isn&rsquo;t also running the meeting.</strong></p>

        <h2 class="art-h2">Your free HOA annual meeting kit</h2>
        <p class="art-p">The kit turns this guide into three fill-in documents, in one Word file that opens in Google Docs:</p>
        <ul class="art-ul">
          <li>A week-by-week checklist with the same seven stages as the timeline above, plus a worksheet for your documents&rsquo; rules.</li>
          <li>An HOA annual meeting notice template, with every legal requirement left as a blank for you to fill in from your documents.</li>
          <li>An HOA annual meeting agenda template that matches the sample agenda, item for item.</li>
        </ul>
        <p class="art-p">Every legal requirement is left as a blank, so you fill it in from your own governing documents. <a href="/downloads/cmgt-hoa-annual-meeting-kit.docx" download>Download the HOA Annual Meeting Kit</a>. It&rsquo;s a Word file that opens in Google Docs, free and no email required.</p>

        <h2 class="art-h2">Frequently asked questions about the HOA annual meeting</h2>
        <h3 class="art-h3">What happens if an HOA doesn&rsquo;t have an annual meeting?</h3>
        <p class="art-p">The board may be out of compliance with its bylaws, directors whose terms have ended may keep serving without a new election, and homeowners may have grounds to request a meeting. The consequences depend on your governing documents and state law.</p>
        <h3 class="art-h3">Is it mandatory for homeowners to attend the HOA annual meeting?</h3>
        <p class="art-p">Generally, no. But the meeting can&rsquo;t do business without quorum, so every homeowner who attends or returns a proxy or ballot helps the community get its work done, including electing the board.</p>
        <h3 class="art-h3">What is a quorum for an HOA annual meeting?</h3>
        <p class="art-p">It&rsquo;s the minimum share of members, present or represented, that your bylaws or state law require before the meeting can conduct business. Your governing documents state the number for your community.</p>
        <h3 class="art-h3">How far in advance do you have to send notice of an HOA annual meeting?</h3>
        <p class="art-p">Whatever your bylaws and state law require, and that varies. Find the deadline first, then build the rest of your timeline backward from it. <a href="/resources">Your state&rsquo;s HOA law guide</a> in our Resources library is a good place to start.</p>
        <h3 class="art-h3">Can an HOA hold its annual meeting virtually?</h3>
        <p class="art-p">Many can, if the governing documents and state law allow it. Check both before you send the notice, since the notice needs to say how homeowners can join.</p>

        <h2 class="art-h2">Start early, follow your documents</h2>
        <p class="art-p">Start eight weeks out, follow your documents, and treat the HOA annual meeting as the year&rsquo;s best chance to show homeowners the board&rsquo;s work. When the notice is right, the numbers are clear, and the election is fair, the meeting mostly runs itself. Board meeting preparation, attendance, and minutes are part of CMGT&rsquo;s <a href="/hoa-management-services">HOA management services</a>.</p>

        <p class="art-disclaimer">This article and kit are free planning resources for HOA boards, not the process CMGT uses to run meetings for the communities it manages, and not legal advice. Notice, quorum, proxy, and voting rules vary by governing documents and state law; confirm your community&rsquo;s requirements with your association&rsquo;s attorney.</p>
      </div>
    </div>
  </article>

  <section class="rel">
    <div class="container">
      <h2 class="rel-h">Keep reading.</h2>
      <div class="rel-grid"><a class="rel-card" href="/resources/hoa-budget-template"><span class="rel-t">HOA Budget Template</span><span class="rel-ar">&rarr;</span></a><a class="rel-card" href="/hoa-management-services"><span class="rel-t">HOA Management Services</span><span class="rel-ar">&rarr;</span></a><a class="rel-card" href="/resources"><span class="rel-t">Board Education Hub</span><span class="rel-ar">&rarr;</span></a></div>
