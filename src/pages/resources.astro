---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';
import ImageSlot from '~/components/ImageSlot.astro';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'Resources', url: SITE.url + '/resources' },
]);
---
<BaseLayout
  title="Board Education Hub — CMGT | Resources for HOA Boards"
  description="The CMGT Board Education Hub — plain-English guides on reserves, budgets, covenants, insurance, and Gulf South HOA law. No industry-speak."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"Resources"}]'></nav>

  <!-- HERO -->
  <section class="rh-hero">
    <div class="container rh-hero-grid">
      <div>
        <div class="eyebrow eyebrow-blue">Board Education Hub</div>
        <h1 class="rh-hero-display">Run your board <span class="u">like a pro.</span></h1>
      </div>
      <p class="rh-hero-lede">
        Plain-language guides for volunteer leaders — reserves, budgets, covenants, insurance,
        and the Gulf South specifics. <strong>No industry-speak, no sales pitch.</strong>
      </p>
    </div>
  </section>

  <!-- FEATURED -->
  <section class="feat">
    <div class="container">
      <div class="feat-card reveal">
        <div class="feat-body">
          <span class="feat-tag">Featured guide</span>
          <h2 class="feat-t">Hurricane prep for Gulf South boards</h2>
          <p class="feat-d">Insurance, reserves, vendor contracts, and the homeowner communication plan — what to lock down before the season hits.</p>
          <a class="btn btn-green feat-cta" href="/resources/hurricane-preparedness-for-hoas">Read the guide <span class="arrow">→</span></a>
        </div>
        <div class="feat-media">
          <ImageSlot src="/photos/res-feat-photo.webp" alt="A Gulf South coastal neighborhood bracing for storm season — palm trees and rooftops under a gathering sky" shape="rect" />
        </div>
      </div>
    </div>
  </section>

  <!-- TOPICS -->
  <section class="top">
    <div class="container">
      <div class="top-head reveal">
        <div class="eyebrow eyebrow-blue">Browse by topic</div>
        <h2 class="top-h">Start where your board needs help.</h2>
        <p class="top-sub">Six topic areas, each a growing library of guides written for volunteers — not industry insiders.</p>
      </div>
      <div class="top-grid">
        <div class="top-card reveal"><div class="top-count">01</div><h3 class="top-t">Finances & Reserves</h3><p class="top-d">Budgets, reserve studies, dues, and delinquency — the money side, demystified.</p></div>
        <div class="top-card reveal"><div class="top-count">02</div><h3 class="top-t">Governance & Meetings</h3><p class="top-d">Board roles, quorums, voting, and running meetings that don't run long.</p></div>
        <div class="top-card reveal"><div class="top-count">03</div><h3 class="top-t">Covenants & Enforcement</h3><p class="top-d">Fair, consistent compliance and architectural review without the friction.</p></div>
        <div class="top-card reveal"><div class="top-count">04</div><h3 class="top-t">Insurance & Risk</h3><p class="top-d">Coverage types, claims, and Gulf South storm realities every board should know.</p></div>
        <div class="top-card reveal"><div class="top-count">05</div><h3 class="top-t">Vendors & Maintenance</h3><p class="top-d">Bidding, contracts, and keeping common areas in great shape.</p></div>
        <div class="top-card reveal"><div class="top-count">06</div><h3 class="top-t">Choosing a Manager</h3><p class="top-d">Self-managed vs. professional, switching companies, and what to ask.</p></div>
      </div>
    </div>
  </section>

  <!-- GUIDES -->
  <section class="guides">
    <div class="container">
      <div class="eyebrow eyebrow-blue reveal">Latest guides</div>
      <h2 class="guides-h reveal">Fresh from the hub.</h2>
      <a class="guide reveal" href="/resources/hoa-budget-template"><span class="guide-cat">Finances</span><h3 class="guide-t">HOA budget templates & best practices: a board's guide</h3><span class="guide-read">Read <span class="arrow">→</span></span></a>
      <a class="guide reveal" href="/resources/hoa-reserve-study"><span class="guide-cat">Finances</span><h3 class="guide-t">HOA reserve studies: the complete board guide</h3><span class="guide-read">Read <span class="arrow">→</span></span></a>
      <a class="guide reveal" href="/resources/hurricane-preparedness-for-hoas"><span class="guide-cat">Insurance</span><h3 class="guide-t">Hurricane preparedness for Gulf South HOAs</h3><span class="guide-read">Read <span class="arrow">→</span></span></a>
      <a class="guide reveal" href="/resources/hoa-rules-enforcement"><span class="guide-cat">Covenants</span><h3 class="guide-t">HOA rules enforcement & violations: what's fair for both sides</h3><span class="guide-read">Read <span class="arrow">→</span></span></a>
    </div>
  </section>

  <!-- INTERACTIVE: Plain-English glossary -->
  <section class="gloss">
    <div class="container">
      <div class="gloss-head reveal">
        <div class="eyebrow eyebrow-blue">No industry-speak</div>
        <h2 class="gloss-h">HOA terms, in plain English.</h2>
        <p class="gloss-sub">The acronyms and jargon boards run into — explained like a neighbor would, not a lawyer. Start typing to find one.</p>
      </div>
      <div class="gloss-search reveal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="gloss-input" placeholder="Search terms — try “reserve” or “CC&Rs”" aria-label="Search glossary">
      </div>
      <p class="gloss-count reveal" id="gloss-count"></p>
      <div class="gloss-grid reveal" id="gloss-grid"></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container cta-in reveal">
      <h2 class="cta-h">Still have questions?</h2>
      <p class="cta-p">Our team has answered them all before. Ask us directly — or have a real conversation about your community.</p>
      <div class="cta-actions">
        <a class="btn btn-green" href="/faq">Browse the FAQ <span class="arrow">→</span></a>
        <a class="btn btn-outline-light" href="/request-a-proposal">Request a proposal</a>
      </div>
    </div>
  </section>

  <script>
    (function () {
      var TERMS = [
        { t: 'CC&Rs', a: 'Covenants, Conditions & Restrictions', d: 'The rulebook your community agreed to — what you can build, paint, park, and do. Recorded against every property.' },
        { t: 'Reserve Study', a: '', d: 'A long-range plan that predicts when big shared items (roofs, roads, pools) wear out and how much to save now so you can pay for them later.' },
        { t: 'Reserves', a: '', d: 'The savings account for major future repairs and replacements — separate from the money that runs the community day to day.' },
        { t: 'Assessment', a: 'Dues', d: 'The regular fee each homeowner pays to fund the community — landscaping, insurance, amenities, and reserves.' },
        { t: 'Special Assessment', a: '', d: 'A one-time charge on top of regular dues, usually when reserves fall short of a big or unexpected expense.' },
        { t: 'Delinquency', a: '', d: 'Assessments that haven’t been paid on time. High delinquency strains the budget and shifts the burden to paying neighbors.' },
        { t: 'Fiduciary Duty', a: '', d: 'The legal obligation board members have to act in the community’s best interest — not their own.' },
        { t: 'Quorum', a: '', d: 'The minimum number of members who must participate for a vote or meeting to count.' },
        { t: 'Architectural Review', a: 'ARC', d: 'The process (and committee) that approves exterior changes — additions, fences, paint colors — so the community stays consistent.' },
        { t: 'Covenant Enforcement', a: '', d: 'Making sure everyone follows the CC&Rs — ideally consistently and compassionately, not heavy-handedly.' },
        { t: 'Declarant', a: 'Developer', d: 'The developer who creates the community and controls the association until enough homes are sold to hand it to homeowners.' },
        { t: 'Turnover', a: 'Transition', d: 'The handoff of association control from the developer to a homeowner-elected board.' },
        { t: 'Common Area', a: '', d: 'The shared spaces every owner has rights to — clubhouses, pools, green space, private roads.' },
        { t: 'Limited Common Element', a: 'LCE', d: 'Shared property reserved for certain units — like the balcony or parking space assigned to one condo.' },
        { t: 'Operating Budget', a: '', d: 'The yearly plan for day-to-day income and expenses — the money that keeps the lights on and the grass cut.' },
        { t: 'Master Policy', a: '', d: 'The association’s insurance covering shared structures and common areas — distinct from an owner’s personal policy.' },
        { t: 'Bylaws', a: '', d: 'The operating manual for the association itself — how the board is elected, how meetings run, how decisions get made.' },
        { t: 'Estoppel / Resale Certificate', a: '', d: 'A document issued at sale showing what a buyer is inheriting — dues owed, violations, and the community’s financial standing.' }
      ].sort(function (a, b) { return a.t.localeCompare(b.t); });
      var grid = document.getElementById('gloss-grid'), input = document.getElementById('gloss-input'), count = document.getElementById('gloss-count');
      function render(q) {
        q = (q || '').trim().toLowerCase();
        var shown = TERMS.filter(function (x) { return !q || x.t.toLowerCase().indexOf(q) > -1 || x.a.toLowerCase().indexOf(q) > -1 || x.d.toLowerCase().indexOf(q) > -1; });
        grid.innerHTML = shown.length ? shown.map(function (x) {
          return '<div class="gloss-term"><h3 class="gloss-term-t">' + x.t + (x.a ? '<span class="abbr">' + x.a + '</span>' : '') + '</h3><p class="gloss-term-d">' + x.d + '</p></div>';
        }).join('') : '<p class="gloss-empty">No match — but ask us and we’ll explain it. That’s the whole point.</p>';
        count.textContent = q ? (shown.length + ' of ' + TERMS.length + ' terms') : (TERMS.length + ' terms and counting');
      }
      input.addEventListener('input', function () { render(input.value); });
      render('');
    })();
  </script>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }

  /* HERO */
  .rh-hero { background: #fff; padding: 84px 0 60px; }
  .rh-hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 56px; align-items: end; }
  @media (max-width: 920px) { .rh-hero-grid { grid-template-columns: 1fr; gap: 28px; } }
  .rh-hero-display { font-family: var(--font-display); font-weight: 900; font-size: clamp(44px, 5.6vw, 84px); line-height: .99; letter-spacing: -.03em; color: var(--freedom-blue); margin: 22px 0 0; text-wrap: balance; }
  .rh-hero-display .u { background: linear-gradient(transparent 80%, var(--landscaping-green) 80%); padding-bottom: .04em; }
  .rh-hero-lede { font-size: 17.5px; line-height: 1.7; color: var(--ink-500); margin: 0 0 8px; }
  .rh-hero-lede strong { color: var(--freedom-blue); font-weight: 600; }

  /* FEATURED */
  .feat { background: #fff; padding: 40px 0 30px; }
  .feat-card { display: grid; grid-template-columns: 1.1fr .9fr; gap: 0; border-radius: 20px; overflow: hidden; background: var(--freedom-blue); color: #fff; }
  @media (max-width: 860px) { .feat-card { grid-template-columns: 1fr; } }
  .feat-body { padding: 52px 48px; display: flex; flex-direction: column; justify-content: center; position: relative; overflow: hidden; }
  .feat-body::after { content: ""; position: absolute; left: -70px; bottom: -90px; width: 260px; height: 260px; background: url('/assets/leaf-mark.svg') no-repeat center / contain; filter: brightness(0) invert(1); opacity: .08; transform: rotate(12deg); pointer-events: none; }
  .feat-tag { font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--landscaping-green); position: relative; }
  .feat-t { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.2vw, 40px); line-height: 1.12; margin: 14px 0 14px; position: relative; text-wrap: balance; }
  .feat-d { font-size: 16px; line-height: 1.65; color: rgba(255,255,255,.78); margin: 0 0 26px; max-width: 460px; position: relative; }
  .feat-cta { align-self: flex-start; position: relative; }
  .feat-media :global(.image-slot) { width: 100%; height: 100%; min-height: 320px; }

  /* TOPICS */
  .top { background: #fff; padding: 80px 0 40px; }
  .top-head { max-width: 680px; margin: 0 0 48px; }
  .top-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
  .top-sub { font-size: 16px; line-height: 1.7; color: var(--ink-500); margin: 0; }
  .top-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  @media (max-width: 880px) { .top-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .top-grid { grid-template-columns: 1fr; } }
  .top-card { border: 1.5px solid var(--hairline-strong); border-radius: 14px; padding: 26px 26px; transition: border-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .top-card:hover { border-color: var(--landscaping-green); transform: translateY(-2px); }
  .top-count { font-family: var(--font-display); font-weight: 300; font-style: italic; font-size: 26px; color: var(--landscaping-green); }
  .top-t { font-family: var(--font-display); font-weight: 700; font-size: 19px; color: var(--freedom-blue); margin: 8px 0 8px; }
  .top-d { font-size: 13.5px; line-height: 1.6; color: var(--ink-500); margin: 0; }

  /* GUIDES LIST */
  .guides { background: var(--nb-lightest); padding: 100px 0; }
  .guides-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.1; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 8px; }
  .guides-note { font-size: 13.5px; color: var(--ink-400); margin: 0 0 40px; }
  .guide { display: grid; grid-template-columns: 84px 1fr auto; gap: 24px; align-items: center; padding: 24px 4px; border-top: 1.5px solid var(--hairline-strong); text-decoration: none; transition: border-color var(--dur-base) var(--ease-out); }
  .guide:last-of-type { border-bottom: 1.5px solid var(--hairline-strong); }
  .guide:hover { border-top-color: var(--landscaping-green); }
  @media (max-width: 680px) { .guide { grid-template-columns: 60px 1fr; } .guide-read { display: none; } }
  .guide-cat { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-400); }
  .guide-t { font-family: var(--font-display); font-weight: 700; font-size: 19px; line-height: 1.25; color: var(--freedom-blue); margin: 0; }
  .guide-read { display: inline-flex; align-items: center; gap: 7px; font-weight: 600; font-size: 14px; color: var(--freedom-blue); white-space: nowrap; }
  .guide-read .arrow { color: var(--landscaping-green); transition: transform var(--dur-base) var(--ease-out); }
  .guide:hover .guide-read .arrow { transform: translateX(4px); }

  /* CTA */
  .cta { background: var(--freedom-blue); color: #fff; padding: 100px 0; position: relative; overflow: hidden; }
  .cta .leaf { position: absolute; right: -90px; top: -100px; width: 420px; height: 420px; opacity: .08; transform: rotate(-12deg); pointer-events: none; }
  .cta .leaf img { filter: brightness(0) invert(1); }
  .cta-in { position: relative; text-align: center; max-width: 720px; margin: 0 auto; }
  .cta-h { font-family: var(--font-display); font-weight: 900; font-size: clamp(34px, 4.4vw, 56px); line-height: 1.04; letter-spacing: -.02em; margin: 0 0 16px; text-wrap: balance; }
  .cta-p { font-size: 16.5px; line-height: 1.65; color: rgba(255,255,255,.75); margin: 0 0 32px; }
  .cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  /* INTERACTIVE: Plain-English glossary */
  .gloss { background: #fff; padding: 30px 0 110px; }
  .gloss-head { max-width: 680px; margin: 0 0 32px; }
  .gloss-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
  .gloss-sub { font-size: 16px; line-height: 1.7; color: var(--ink-500); margin: 0; }
  .gloss-search { position: relative; max-width: 460px; margin: 0 0 14px; }
  .gloss-search input { width: 100%; font-family: var(--font-body); font-size: 16px; color: var(--freedom-blue); background: var(--nb-lightest); border: 1.5px solid var(--hairline-strong); border-radius: 10px; padding: 14px 16px 14px 44px; outline: none; transition: border-color var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out); }
  .gloss-search input:focus { border-color: var(--landscaping-green); background: #fff; }
  .gloss-search input::placeholder { color: var(--ink-400); }
  .gloss-search svg { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: var(--ink-400); pointer-events: none; }
  .gloss-count { font-size: 13px; color: var(--ink-400); margin: 0 0 22px; }
  .gloss-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 44px; }
  @media (max-width: 760px) { .gloss-grid { grid-template-columns: 1fr; } }
  .gloss-term { padding: 22px 2px; border-top: 1.5px solid var(--hairline-strong); }
  .gloss-term-t { font-family: var(--font-display); font-weight: 700; font-size: 18px; color: var(--freedom-blue); margin: 0 0 6px; }
  .gloss-term-t .abbr { color: var(--landscaping-green); font-weight: 600; font-size: 14px; margin-left: 8px; }
  .gloss-term-d { font-size: 14.5px; line-height: 1.65; color: var(--ink-500); margin: 0; }
  .gloss-empty { font-size: 15px; color: var(--ink-400); padding: 28px 2px; border-top: 1.5px solid var(--hairline-strong); grid-column: 1 / -1; }
</style>
