---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';
import ImageSlot from '~/components/ImageSlot.astro';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'Switching Management Companies', url: SITE.url + '/switching-hoa-management-companies' },
]);
---
<BaseLayout
  title="Switching HOA Management Companies, Without the Trauma — CMGT"
  description="Switching HOA management companies without the trauma — a clear Day 1 to Day 90 transition. We handle records, vendors, finances, and communication."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"Switching Management Companies"}]'></nav>

  <!-- HERO -->
  <section class="sol-hero">
    <div class="container sol-hero-grid">
      <div>
        <span class="sol-tag">Solutions</span>
        <h1 class="sol-hero-display">Switching HOA management companies, <span class="u">without the trauma.</span></h1>
        <p class="sol-hero-lede">
          Most boards dread the change more than they dread their current manager. They shouldn't.
          <strong>We've run this transition hundreds of times</strong> — and we carry the weight,
          not your volunteers.
        </p>
        <div class="sol-hero-ctas">
          <a class="btn btn-blue" href="/request-a-proposal">Start the conversation <span class="arrow">→</span></a>
          <a class="btn btn-outline-blue" href="/hoa-management-services">See full-service HOA management</a>
        </div>
      </div>
      <div class="sol-hero-media">
        <div class="block" aria-hidden="true"></div>
        <ImageSlot src="/photos/sw-hero-photo.webp" alt="A relieved HOA board member shaking hands with a calm, capable CMGT community manager outside a community clubhouse — the feeling of weight lifted and trust earned" shape="rounded" radius={20} />
      </div>
    </div>
  </section>

  <!-- TRIGGERS -->
  <section class="trg">
    <div class="container">
      <div class="trg-head reveal">
        <div class="eyebrow eyebrow-blue">Sound familiar?</div>
        <h2 class="trg-h">There are usually two reasons a board starts looking.</h2>
        <p class="trg-sub">In nearly every switch we see, it comes down to one of these two — and both are fixable.</p>
      </div>
      <div class="trg-grid">
        <div class="trg-card reveal">
          <h3 class="trg-t">Communication has gone quiet</h3>
          <p class="trg-d">Emails sit for days. Homeowners can't get answers. The board finds out about problems last. <strong>If you're chasing your manager, something's broken</strong> — and it's the most common reason boards leave.</p>
        </div>
        <div class="trg-card reveal">
          <h3 class="trg-t">Delinquency keeps climbing</h3>
          <p class="trg-d">Unpaid assessments pile up, reserves thin out, and collections never seem to happen. <strong>A consistent process should keep delinquency low</strong> — ours averages around 10%.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TRANSITION ROADMAP -->
  <header class="rm-top">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container">
      <p class="rm-eyebrow">The roadmap</p>
      <h2 class="rm-h">Your first two years with CMGT, <em>mapped out.</em></h2>
      <p class="rm-sub">From the first records request to a community that practically runs itself. Three views of the journey — the 90-day handoff, the rhythm that follows, and where your community lands in two years.</p>
      <nav class="rm-nav">
        <button data-target="v1" class="on"><span class="ix">1</span><span class="nl"><span class="nt">First 90 Days</span><span class="nd">The week-by-week handoff</span></span></button>
        <button data-target="v2"><span class="ix">2</span><span class="nl"><span class="nt">The Quarterly Rhythm</span><span class="nd">Life once you're settled</span></span></button>
        <button data-target="v3"><span class="ix">3</span><span class="nl"><span class="nt">The 2-Year Arc</span><span class="nd">Where your community lands</span></span></button>
      </nav>
    </div>
  </header>

  <!-- VISUAL 1 -->
  <section class="v1" id="v1">
    <div class="container">
      <div class="section-head">
        <p class="sh-kick">Phase 1 — First 90 days</p>
        <h2 class="sh-h">The handoff, day by day — and it falls on us.</h2>
        <p class="sh-p">A documented onboarding nobody else in the Gulf South visualizes. Every milestone is real, sequenced, and supported by check-ins from your CAM, their Supervisor, our COO, and our CEO.</p>
      </div>

      <div class="tl">
        <div class="phase-head p1"><span class="ph-n">Days 1–20</span><span class="ph-t">Securing the handoff</span></div>
        <div class="step">
          <div class="day">Day 1</div>
          <div class="body"><p class="st">Documents obtained</p><p class="sd">We pull every onboarding document from your previous management company. The handoff doesn't depend on them cooperating.</p></div>
        </div>
        <div class="step">
          <div class="day">Day 5</div>
          <div class="body"><p class="st">Homeowners introduced</p><p class="sd">First communication goes out to all homeowners, introducing CMGT and what to expect.</p></div>
        </div>
        <div class="step">
          <div class="day">Day 10</div>
          <div class="body"><p class="st">Financial records secured</p><p class="sd">Financial records and operational information obtained and reviewed.</p></div>
        </div>
        <div class="step">
          <div class="day">Day 15</div>
          <div class="body"><p class="st">Accounts &amp; access</p><p class="sd">Beginning balances checked, homeowner balances confirmed, and gate codes, credentials, and fobs collected.</p></div>
        </div>
        <div class="step">
          <div class="day">Day 20</div>
          <div class="body"><p class="st">Onboarding meeting</p><p class="sd">All department supervisors meet your board — so you can ask questions and understand exactly what each department does.</p></div>
        </div>
        <div class="phase-head p2"><img class="ph-logo" src="/assets/icon-mark.svg" alt="CMGT"><span class="ph-n">Day 30</span><span class="ph-t">Go Live</span></div>
        <div class="step live">
          <div class="day">Day 30</div>
          <div class="body"><p class="st"><span class="golive">Go Live</span> Your CAM takes over</p><p class="sd">Formal introduction mailed and emailed to homeowners. Your board gets a formal email. Contact transfers to your dedicated CAM, who calls your liaison with their Supervisor.</p></div>
        </div>
        <div class="phase-head p3"><span class="ph-n">Days 45–90</span><span class="ph-t">Getting your house in order</span></div>
        <div class="step settle">
          <div class="day">Day 45</div>
          <div class="body"><p class="st">Site inspection &amp; education</p><p class="sd">First site inspection complete. An education letter goes to homeowners on the covenants — before any violation — plus a quick-reference guide. CAM Supervisor checks in.</p></div>
        </div>
        <div class="step settle">
          <div class="day">Day 60</div>
          <div class="body"><p class="st">Leadership check-in</p><p class="sd">Our CEO sends a welcome email and our COO reviews your first 30 days. Homeowners can now log in and see last month's financials.</p></div>
        </div>
        <div class="step settle">
          <div class="day">Day 75</div>
          <div class="body"><p class="st">Supervisor check-in</p><p class="sd">Your CAM Supervisor confirms every need is being met.</p></div>
        </div>
        <div class="step settle">
          <div class="day">Day 90</div>
          <div class="body"><p class="st">Full operations</p><p class="sd">First violation round complete and issued. Your community's house is in order — and the rhythm begins.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- VISUAL 2 -->
  <section class="v2" id="v2">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container">
      <div class="section-head">
        <p class="sh-kick">Phase 2 — The quarterly rhythm</p>
        <h2 class="sh-h">Onboarding ends. The rhythm begins.</h2>
        <p class="sh-p">This is what running your community looks like once you're settled — the same dependable cadence, on repeat, for as long as we're your neighbors.</p>
      </div>

      <div class="cadence">
        <div class="cad">
          <div class="cad-loop"><svg viewBox="0 0 24 24" fill="none" stroke="#4ACF6C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"></path><polyline points="21 3 21 8 16 8"></polyline></svg></div>
          <div class="cad-when">Every month</div>
          <div class="cad-freq">Monthly</div>
          <ul>
            <li>Financial statements posted by the 20th</li>
            <li>Prompt homeowner responses</li>
            <li>Site visits &amp; inspections</li>
            <li>Work orders tracked end to end</li>
            <li>P&amp;L visible to every owner in the portal</li>
          </ul>
        </div>
        <div class="cad">
          <div class="cad-loop"><svg viewBox="0 0 24 24" fill="none" stroke="#4ACF6C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"></path><polyline points="21 3 21 8 16 8"></polyline></svg></div>
          <div class="cad-when">Every quarter</div>
          <div class="cad-freq">Quarterly</div>
          <ul>
            <li>Board reporting &amp; review</li>
            <li>Vendor performance reviews</li>
            <li>CAM Supervisor check-in</li>
            <li>Reserve &amp; budget tracking</li>
          </ul>
        </div>
        <div class="cad">
          <div class="cad-loop"><svg viewBox="0 0 24 24" fill="none" stroke="#4ACF6C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"></path><polyline points="21 3 21 8 16 8"></polyline></svg></div>
          <div class="cad-when">Every year</div>
          <div class="cad-freq">Annually</div>
          <ul>
            <li>Budget preparation</li>
            <li>Reserve study review</li>
            <li>Annual meeting support</li>
            <li>Insurance renewal review</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- VISUAL 3 -->
  <section class="v3" id="v3">
    <div class="container">
      <div class="section-head">
        <p class="sh-kick">Phase 3 — The long view</p>
        <h2 class="sh-h">Relief starts day one — not next year.</h2>
        <p class="sh-p">Most of what keeps your board up at night is handled in the first weeks. Only the things that <em>should</em> take time — like rebuilding reserves — play out across the full two years.</p>
      </div>

      <div class="growth-wrap">
        <div class="relief-panel">
          <div class="relief-in">
            <div class="ttr">
              <div class="ttr-axis">
                <div class="ttr-lead">Time until it's off your plate</div>
                <div class="ttr-scale">
                  <span class="e0">Day 1</span>
                  <span style="left:33%">90 days</span>
                  <span style="left:66%">Year 1</span>
                  <span class="e3">Year 2</span>
                </div>
              </div>

              <div class="ttr-row">
                <div class="ttr-name"><b>Communication</b><span>Portal &amp; contacts → <em>live in week one</em></span></div>
                <div class="ttr-track">
                  <span class="gl" style="left:33%"></span><span class="gl" style="left:66%"></span>
                  <span class="ttr-base"></span>
                  <span class="ttr-bar" style="width:8%"></span>
                  <span class="ttr-dot" style="left:8%"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                  <span class="ttr-when early" style="left:8%">First week</span>
                </div>
              </div>

              <div class="ttr-row">
                <div class="ttr-name"><b>Board workload</b><span>The day-to-day → <em>lifted off you</em></span></div>
                <div class="ttr-track">
                  <span class="gl" style="left:33%"></span><span class="gl" style="left:66%"></span>
                  <span class="ttr-base"></span>
                  <span class="ttr-bar" style="width:17%"></span>
                  <span class="ttr-dot" style="left:17%"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                  <span class="ttr-when early" style="left:17%">Within weeks</span>
                </div>
              </div>

              <div class="ttr-row">
                <div class="ttr-name"><b>Vendors</b><span>Inherited chaos → <em>vetted local network</em></span></div>
                <div class="ttr-track">
                  <span class="gl" style="left:33%"></span><span class="gl" style="left:66%"></span>
                  <span class="ttr-base"></span>
                  <span class="ttr-bar" style="width:36%"></span>
                  <span class="ttr-dot" style="left:36%"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                  <span class="ttr-when" style="left:36%">~90 days</span>
                </div>
              </div>

              <div class="ttr-row">
                <div class="ttr-name"><b>Delinquency</b><span>Inherited backlog → <em>low &amp; steady</em></span></div>
                <div class="ttr-track">
                  <span class="gl" style="left:33%"></span><span class="gl" style="left:66%"></span>
                  <span class="ttr-base"></span>
                  <span class="ttr-bar" style="width:64%"></span>
                  <span class="ttr-dot" style="left:64%"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                  <span class="ttr-when" style="left:64%">On track by year one</span>
                </div>
              </div>

              <div class="ttr-row">
                <div class="ttr-name"><b>Reserves</b><span>Underfunded → <em>a maturing multi-year plan</em></span></div>
                <div class="ttr-track">
                  <span class="gl" style="left:33%"></span><span class="gl" style="left:66%"></span>
                  <span class="ttr-base"></span>
                  <span class="ttr-bar" style="width:93%"></span>
                  <span class="ttr-dot" style="left:93%"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                  <span class="ttr-when rt">The long game</span>
                </div>
              </div>
            </div>
          </div>

          <p class="arc-note"><strong>Nothing waits a year.</strong> The everyday weight is off your board within the first weeks; the only things that run the full arc are the ones that genuinely should — like rebuilding reserves the right way. By year two, you're not managing the manager. You're just living here.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HANDOFF -->
  <section class="ho">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container ho-in reveal">
      <div class="eyebrow" style="color: rgba(255,255,255,.6);">Who does the work</div>
      <p class="ho-q">The records request, the vendor calls, the bank paperwork, the homeowner notices — <span class="g">we handle all of it.</span> Your board's job is to say yes.</p>
    </div>
  </section>

  <!-- COST -->
  <section class="cost">
    <div class="container cost-grid">
      <div class="reveal">
        <div class="eyebrow eyebrow-blue">What about cost?</div>
        <h2 class="cost-h">What does HOA management cost to switch to?</h2>
        <p class="cost-p">
          Every community is different, so we quote custom — never a one-size template. We don't
          compete on being the cheapest; <strong>we compete on value.</strong> Most boards find
          that better collections and fewer fire drills more than cover the difference.
        </p>
        <a class="cost-link" href="/hoa-management-services">See what full-service includes <span class="arrow">→</span></a>
      </div>
      <div class="reveal">
        <p class="cost-p" style="border-left: 3px solid var(--landscaping-green); padding-left: 20px; font-family: var(--font-display); font-style: italic; font-size: 19px; color: var(--freedom-blue); max-width: none;">
          "They don't just report issues — they show up with the answer. Our board meetings are calmer, and our reserves are healthier."
        </p>
        <div style="font-weight: 700; font-size: 15px; color: var(--freedom-blue); padding-left: 23px;">Marcus Theriot</div>
        <div style="font-size: 13px; color: var(--ink-400); padding-left: 23px; margin-top: 2px;">Board President · switched to CMGT</div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container cta-in">
      <div class="reveal">
        <h2 class="cta-h">Ready when you are.</h2>
        <p class="cta-p">Tell us what's not working with your current manager. We'll show you exactly how the switch would go — within two business days.</p>
      </div>
      <div class="cta-actions reveal">
        <a class="btn btn-blue" href="/request-a-proposal">Request a proposal <span class="arrow">→</span></a>
        <a class="cta-phone" href="tel:2255032648">Or call (225) 503-2648 · Mon–Thu 8:30a–4:30p · Fri 8:30a–4:00p CT</a>
      </div>
    </div>
  </section>

  <script>
    (function () {
      var btns = [].slice.call(document.querySelectorAll('.rm-nav button'));
      function go(id) {
        var el = document.getElementById(id);
        if (!el) return;
        var y = el.getBoundingClientRect().top + window.scrollY - 16;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
      btns.forEach(function (b) { b.addEventListener('click', function () { go(b.dataset.target); }); });
      // scroll-synced active state
      var secs = ['v1', 'v2', 'v3'].map(function (id) { return document.getElementById(id); });
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            var id = e.target.id;
            btns.forEach(function (b) { b.classList.toggle('on', b.dataset.target === id); });
          }
        });
      }, { rootMargin: '-45% 0px -50% 0px' });
      secs.forEach(function (s) { if (s) obs.observe(s); });
    })();
  </script>
</BaseLayout>

<style>
    body { background: #fff; }
    .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }

    /* HERO — white solution treatment */
    .sol-hero { background: #fff; padding: 84px 0 70px; overflow: hidden; }
    .sol-hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 64px; align-items: center; }
    @media (max-width: 980px) { .sol-hero-grid { grid-template-columns: 1fr; gap: 40px; } }
    .sol-tag { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--freedom-blue); background: var(--fb-lightest); padding: 7px 14px; border-radius: 999px; }
    .sol-hero-display { font-family: var(--font-display); font-weight: 900; font-size: clamp(42px, 5.2vw, 76px); line-height: 1.0; letter-spacing: -.025em; color: var(--freedom-blue); margin: 20px 0 24px; text-wrap: balance; }
    .sol-hero-display .u { background: linear-gradient(transparent 80%, var(--landscaping-green) 80%); padding-bottom: .04em; }
    .sol-hero-lede { font-size: 17.5px; line-height: 1.7; color: var(--ink-500); max-width: 520px; margin: 0 0 30px; }
    .sol-hero-lede strong { color: var(--freedom-blue); font-weight: 600; }
    .sol-hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
    .sol-hero-media { position: relative; }
    .sol-hero-media .block { position: absolute; right: -26px; bottom: -26px; width: 66%; height: 54%; background: var(--landscaping-green); border-radius: 20px; z-index: 0; }
    .sol-hero-media :global(.image-slot) { position: relative; z-index: 1; width: 100%; height: 460px; }
    @media (max-width: 980px) { .sol-hero-media :global(.image-slot) { height: 380px; } }

    /* TRIGGERS */
    .trg { background: var(--nb-lightest); padding: 104px 0; }
    .trg-head { max-width: 720px; margin: 0 0 48px; }
    .trg-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
    .trg-sub { font-size: 16.5px; line-height: 1.7; color: var(--ink-500); margin: 0; }
    .trg-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @media (max-width: 820px) { .trg-grid { grid-template-columns: 1fr; } }
    .trg-card { background: #fff; border-radius: 16px; padding: 38px 36px; box-shadow: var(--shadow-2); border-left: 4px solid var(--landscaping-green); }
    .trg-t { font-family: var(--font-display); font-weight: 700; font-size: 24px; line-height: 1.14; color: var(--freedom-blue); margin: 0 0 12px; }
    .trg-d { font-size: 15px; line-height: 1.7; color: var(--ink-500); margin: 0; }
    .trg-d strong { color: var(--freedom-blue); font-weight: 600; }

    /* HANDOFF reassurance */
    .ho { background: var(--freedom-blue); color: #fff; padding: 100px 0; position: relative; overflow: hidden; }
    .ho .leaf { position: absolute; right: -110px; top: -130px; width: 460px; height: 460px; opacity: .07; transform: rotate(-12deg); pointer-events: none; }
    .ho .leaf img { filter: brightness(0) invert(1); }
    .ho-in { position: relative; max-width: 880px; }
    .ho-q { font-family: var(--font-display); font-weight: 300; font-style: italic; font-size: clamp(26px, 3.4vw, 40px); line-height: 1.3; letter-spacing: -.01em; margin: 16px 0 0; text-wrap: balance; }
    .ho-q .g { color: var(--landscaping-green); font-style: normal; font-weight: 700; }

    /* COST fold-in */
    .cost { background: var(--nb-lightest); padding: 100px 0; }
    .cost-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
    @media (max-width: 860px) { .cost-grid { grid-template-columns: 1fr; gap: 24px; } }
    .cost-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(26px, 3.2vw, 38px); line-height: 1.14; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 16px; text-wrap: balance; }
    .cost-p { font-size: 16px; line-height: 1.75; color: var(--ink-500); margin: 0 0 16px; }
    .cost-p strong { color: var(--freedom-blue); font-weight: 600; }
    .cost-link { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 15px; color: var(--freedom-blue); text-decoration: none; }
    .cost-link .arrow { color: var(--landscaping-green); transition: transform var(--dur-base) var(--ease-out); }
    .cost-link:hover .arrow { transform: translateX(4px); }

    /* CTA */
    .cta { background: var(--landscaping-green); color: var(--freedom-blue); padding: 100px 0; position: relative; overflow: hidden; }
    .cta .leaf { position: absolute; left: -110px; bottom: -150px; width: 460px; height: 460px; opacity: .14; transform: rotate(14deg); pointer-events: none; }
    .cta .leaf img { filter: brightness(0) saturate(100%) invert(11%) sepia(64%) saturate(4147%) hue-rotate(238deg) brightness(85%) contrast(96%); }
    .cta-in { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
    .cta-h { font-family: var(--font-display); font-weight: 900; font-size: clamp(34px, 4.6vw, 58px); line-height: 1.02; letter-spacing: -.02em; margin: 0 0 12px; text-wrap: balance; }
