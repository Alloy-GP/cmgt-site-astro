---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';
import ImageSlot from '~/components/ImageSlot.astro';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'HOA Management Services', url: SITE.url + '/hoa-management-services' },
]);
---
<BaseLayout
  title="HOA Management Services for Gulf South Communities — CMGT"
  description="Full-service HOA management across the Gulf South — a dedicated manager backed by a specialist team, financials by the 20th, and same-day answers."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"HOA Management Services"}]'></nav>

  <!-- HERO -->
  <section class="ph-hero">
    <div class="container">
      <div class="ph-hero-top">
        <div>
          <div class="eyebrow">HOA Management Services</div>
          <h1 class="ph-hero-display">Full-service HOA management for the <em>Gulf South.</em></h1>
        </div>
        <div>
          <p class="ph-hero-lede">
            Single-family, master-planned, and townhome associations across five states.
            One dedicated manager, a whole specialist team behind them, and
            <strong>answers the same day — not the same month.</strong>
          </p>
          <div class="ph-hero-ctas">
            <a class="btn btn-green" href="/request-a-proposal">Request a proposal <span class="arrow">→</span></a>
            <a class="btn btn-outline-light" href="/how-we-work">How we work</a>
          </div>
        </div>
      </div>
    </div>
    <div class="ph-hero-band">
      <ImageSlot src="/photos/hoa-management-services-hoa-hero-photo.jpg" alt="Wide view of a Gulf South single-family / master-planned community at golden hour" shape="rect" />
    </div>
    <div class="container">
      <div class="ph-hero-stats">
        <div><div class="ph-stat-num" data-count-to="400" data-suffix="+" data-duration="1500">0+</div><div class="ph-stat-label">communities managed</div></div>
        <div><div class="ph-stat-num" data-count-to="60" data-suffix="k+" data-duration="1300">0k+</div><div class="ph-stat-label">homes under management</div></div>
        <div><div class="ph-stat-num" data-count-to="96" data-suffix="%" data-duration="1600">0%</div><div class="ph-stat-label">client retention</div></div>
        <div><div class="ph-stat-num" data-count-to="5" data-duration="900">0</div><div class="ph-stat-label">states, neighbors in every one</div></div>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section class="inc">
    <div class="container">
      <div class="inc-head reveal">
        <div class="eyebrow eyebrow-blue">What full-service means</div>
        <h2 class="inc-h">Everything your board carries — handled.</h2>
        <p class="inc-sub">No à la carte gaps, no "that's not in your plan." <strong>One team owns the whole operation</strong> so your volunteers can get back to living in their community.</p>
      </div>
      <div class="inc-grid">
        <div class="inc-item reveal"><div class="inc-num">01</div><h3 class="inc-t">Financial Management</h3><p class="inc-d">Budgets, reserves, dues collection, delinquency, and audit-ready books — with full transparency for every homeowner.</p></div>
        <div class="inc-item reveal"><div class="inc-num">02</div><h3 class="inc-t">Covenant Enforcement</h3><p class="inc-d">Consistent, compassionate compliance and architectural review — firm where it counts, never heavy-handed.</p></div>
        <div class="inc-item reveal"><div class="inc-num">03</div><h3 class="inc-t">Vendor & Project Oversight</h3><p class="inc-d">Bids, scopes, scheduling, and quality control with trusted local partners — plus our in-house Fix-It Squad.</p></div>
        <div class="inc-item reveal"><div class="inc-num">04</div><h3 class="inc-t">Board & Meeting Support</h3><p class="inc-d">Agendas, packets, minutes, and governance guidance — so meetings are shorter, calmer, and more productive.</p></div>
        <div class="inc-item reveal"><div class="inc-num">05</div><h3 class="inc-t">Homeowner Communication</h3><p class="inc-d">Same-day responses, clear newsletters, and a portal for payments, requests, and documents — 24/7.</p></div>
        <div class="inc-item reveal"><div class="inc-num">06</div><h3 class="inc-t">Emergency & Storm Response</h3><p class="inc-d">Hurricane plans in place before the season, not during it. Vendor mobilization, owner updates, and recovery support when storms hit.</p></div>
      </div>
    </div>
  </section>

  <!-- MODEL -->
  <section class="mdl">
    <div class="container mdl-grid">
      <div class="reveal">
        <div class="eyebrow eyebrow-blue">The team-based model</div>
        <h2 class="mdl-h">A dedicated manager — <em>and no single point of failure.</em></h2>
        <p class="mdl-p">
          You get one name you'll know, backed by specialists in accounting, covenants, vendors,
          and communication. <strong>When one person's out, the work doesn't stop.</strong>
          We built it this way on purpose — the one-overworked-manager model fails boards every day,
          and if your last company left you feeling burned, that's exactly the gap we close.
          Big enough to protect you, approachable enough that you'll never get lost in the shadow.
        </p>
        <a class="mdl-link" href="/how-we-work">See how the pod works <span class="arrow">→</span></a>
      </div>
      <div class="mdl-media reveal">
        <ImageSlot src="/photos/hoa-management-services-hoa-model-photo.jpg" alt="A community manager meeting with HOA board members" shape="rounded" radius={20} />
      </div>
    </div>
  </section>

  <!-- DELIVERY TIERS + NEAR-ME (SEO: "hoa management company", "what does an hoa management company do", "hoa management companies near me") -->
  <section class="tiers">
    <div class="container">
      <div class="tiers-head reveal">
        <div class="eyebrow eyebrow-blue">Full-service or on-site</div>
        <h2 class="inc-h">What an HOA management company does — and how we deliver it.</h2>
        <p class="inc-sub">A great HOA management company runs the finances, enforces the covenants, manages the vendors, and keeps homeowners informed — <strong>so your volunteer board doesn't have to.</strong> How that's delivered depends on your community.</p>
      </div>
      <div class="tier-grid">
        <div class="tier-card reveal">
          <div class="tier-tag">Most communities</div>
          <h3 class="tier-t">Full-Service Management</h3>
          <p class="tier-d">Your dedicated manager and the full specialist bench run the entire operation remotely — backed by our five-state team and technology.</p>
          <ul class="tier-list">
            <li>Dedicated Community Association Manager + specialist team</li>
            <li>Complete financial, covenant, vendor & communication management</li>
            <li>Best fit for single-family, townhome & master-planned HOAs</li>
          </ul>
        </div>
        <div class="tier-card reveal">
          <div class="tier-tag">Larger & amenity-rich</div>
          <h3 class="tier-t">On-Site Management</h3>
          <p class="tier-d">For communities that need staff on the ground, we place dedicated on-site personnel — with the same specialist bench behind them.</p>
          <ul class="tier-list">
            <li>Dedicated on-site manager and/or staff</li>
            <li>Day-to-day presence for large or amenity-heavy communities</li>
            <li>Same financial transparency and team-based backup</li>
          </ul>
        </div>
      </div>
      <div class="local-band reveal">
        <h3 class="local-h">HOA management near you, across the Gulf South.</h3>
        <div>
          <p class="local-p">We're not parachuting in from out of state. CMGT manages communities with local teams in five states — and we license properly in every market before we enter it.</p>
          <div class="local-states">
            <a class="local-chip" href="/louisiana-hoa-management">Louisiana</a>
            <a class="local-chip" href="/texas-hoa-management">Texas</a>
            <a class="local-chip" href="/mississippi-hoa-management">Mississippi</a>
            <a class="local-chip" href="/alabama-hoa-management">Alabama</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INTERACTIVE: What full-service really covers -->
  <section class="cov">
    <div class="container">
      <div class="cov-head reveal">
        <div class="eyebrow eyebrow-blue">Full-service, in detail</div>
        <h2 class="cov-h">What "we handle it" actually means.</h2>
        <p class="cov-sub">"Full-service" gets thrown around a lot. Here's what your board actually hands off.</p>
      </div>
      <div class="cov-grid reveal">
        <div class="cov-tabs" id="cov-tabs" role="tablist"></div>
        <div class="cov-panel">
          <h3 class="cov-panel-t" id="cov-t">Financial management &amp; reporting</h3>
          <p class="cov-panel-p" id="cov-p">The money side is where most boards feel exposed — and where we go deepest. Your community's books are kept current, transparent, and audit-ready, with the full picture shared every month, not just at tax time.</p>
          <ul class="cov-list" id="cov-list">
            <li>Annual budget preparation</li>
            <li>Reserve planning &amp; funding</li>
            <li>Dues billing &amp; collection</li>
            <li>Delinquency management</li>
            <li>Monthly P&amp;L and balance sheet by the 20th</li>
            <li>Bank reconciliations</li>
            <li>Audit &amp; CPA coordination</li>
            <li>Owner-facing financial transparency</li>
          </ul>
        </div>
      </div>
    </div>
    <script>
      (function () {
        var COV = [
          { tab: 'Financials', t: 'Financial management & reporting', p: "The money side is where most boards feel exposed — and where we go deepest. Your community's books are kept current, transparent, and audit-ready, with the full picture shared every month, not just at tax time.", items: ['Annual budget preparation', 'Reserve planning & funding', 'Dues billing & collection', 'Delinquency management', 'Monthly P&L and balance sheet by the 20th', 'Bank reconciliations', 'Audit & CPA coordination', 'Owner-facing financial transparency'] },
          { tab: 'Covenants', t: 'Covenant & architectural enforcement', p: "Rules only work when they're applied the same way for everyone. We enforce your governing documents firmly and consistently — and handle architectural review so changes get answered, not lost.", items: ['Consistent covenant enforcement', 'Architectural review & approvals', 'Violation tracking & notices', 'Hearings & due-process support', 'Governing-document guidance', 'Fair, documented escalation'] },
          { tab: 'Vendors', t: 'Vendor & project oversight', p: "From the weekly landscaper to a full clubhouse renovation, we source, scope, and supervise the work — with vetted local partners and accountable quality control.", items: ['Competitive bidding & scoping', 'Contract negotiation', 'Scheduling & quality control', 'Insurance & license verification', 'Capital project management', 'On-site quality inspections'] },
          { tab: 'Board support', t: 'Board & meeting support', p: "We make volunteer service lighter. Your board sets direction; we handle the prep, the paperwork, and the institutional memory so meetings are shorter and decisions are cleaner.", items: ['Agenda & packet preparation', 'Meeting facilitation', 'Minutes & record-keeping', 'Governance & compliance guidance', 'Election & voting administration', 'Policy resolution drafting'] },
          { tab: 'Communication', t: 'Homeowner communication', p: "Being available isn't enough if you're slow or hard to understand. We answer the same day, in plain language, and give every owner a 24/7 portal for the routine stuff.", items: ['Same-day homeowner responses', 'Newsletters & announcements', 'Online homeowner portal', 'Online payments & requests', 'Document library access', 'Community-wide notifications'] },
          { tab: 'Storm response', t: 'Emergency & storm response', p: "This is the Gulf South — preparation isn't optional. We plan before the season, mobilize trusted vendors when weather hits, and keep owners informed when it matters most.", items: ['Pre-season preparedness planning', 'Emergency vendor mobilization', 'Insurance claim coordination', 'Real-time owner updates', 'Post-storm damage assessment', 'Reserve & deductible planning'] }
        ];
        var tabs = document.getElementById('cov-tabs');
        var t = document.getElementById('cov-t'), p = document.getElementById('cov-p'), list = document.getElementById('cov-list');
        tabs.innerHTML = COV.map(function (c, i) { return '<button class="cov-tab" role="tab" data-i="' + i + '"><span class="n">0' + (i + 1) + '</span>' + c.tab + '</button>'; }).join('');
        function sel(i) {
          var c = COV[i];
          t.textContent = c.t; p.textContent = c.p;
          list.innerHTML = c.items.map(function (x) { return '<li>' + x + '</li>'; }).join('');
          [].forEach.call(tabs.children, function (b, bi) { b.classList.toggle('on', bi === i); });
        }
        [].forEach.call(tabs.children, function (b) { b.addEventListener('click', function () { sel(+b.dataset.i); }); });
        tabs.children[0].classList.add('on'); // Financials baked into static HTML; activate without rewriting
      })();
    </script>
  </section>

  <!-- 3 C's -->
  <section class="ccc">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container ccc-in reveal">
      <div class="eyebrow" style="color: rgba(255,255,255,.6);">Why boards choose CMGT</div>
      <p class="ccc-q">"We <span class="g">commit</span> because communities matter. We <span class="g">communicate</span> because people matter. We <span class="g">care</span> because that's what matters most."</p>
    </div>
  </section>

  <!-- PEER PILLARS -->
  <section class="peers">
    <div class="container">
      <div class="peers-head reveal">
        <div class="eyebrow eyebrow-blue">Not a single-family HOA?</div>
        <h2 class="peers-h">We have a dedicated practice for that.</h2>
        <p class="peers-sub">Different communities need different expertise. These are full practices in their own right — not afterthoughts.</p>
      </div>
      <div class="peers-grid">
        <a class="peer-card reveal" href="/condo-and-townhome-management">
          <h3 class="peer-t">Condo & Townhome Management</h3>
          <p class="peer-d">Condominiums, COAs, and luxury high-rises — with on-site teams where the building calls for it.</p>
          <span class="peer-cta">Explore condo management <span class="arrow">→</span></span>
        </a>
        <a class="peer-card reveal" href="/hoa-financial-management">
          <h3 class="peer-t">HOA Financial Management</h3>
          <p class="peer-d">Professional financial and administrative support for smaller communities that don't need full-service oversight.</p>
          <span class="peer-cta">Explore financial-only <span class="arrow">→</span></span>
        </a>
        <a class="peer-card reveal" href="/developer-hoa-management">
          <h3 class="peer-t">Developer HOA Management</h3>
          <p class="peer-d">Declarant control through homeowner turnover — structured from groundbreaking onward.</p>
          <span class="peer-cta">Explore developer services <span class="arrow">→</span></span>
        </a>
      </div>
      <p class="peers-sub reveal" style="margin-top: 32px;">Looking for management in a specific state? We serve <a href="/louisiana-hoa-management" style="color:var(--freedom-blue);font-weight:600;">Louisiana</a>, <a href="/texas-hoa-management" style="color:var(--freedom-blue);font-weight:600;">Texas</a>, <a href="/mississippi-hoa-management" style="color:var(--freedom-blue);font-weight:600;">Mississippi</a>, and <a href="/alabama-hoa-management" style="color:var(--freedom-blue);font-weight:600;">Alabama</a>.
      </p>
    </div>
  </section>

  <!-- INTERACTIVE: Is CMGT a fit? -->
  <section class="fit">
    <div class="container fit-layout">
      <div class="fit-media reveal">
        <div class="blk" aria-hidden="true"></div>
        <ImageSlot src="/photos/hoa-management-services-hoa-fit-photo.jpg" alt="Warm portrait of an HOA board and community members" shape="rounded" radius={20} />
      </div>
      <div class="fit-main">
        <div class="fit-head reveal">
          <div class="eyebrow eyebrow-blue">60-second fit check</div>
          <h2 class="fit-h">Is CMGT right for your community?</h2>
          <p class="fit-sub">Three quick questions and we'll point you to the service that fits — no email required, no obligation.</p>
        </div>
        <div class="fit-card reveal">
          <div class="fit-bar"><div class="fit-bar-fill" id="fit-fill"></div></div>
          <div class="fit-body" id="fit-body"></div>
        </div>
      </div>
    </div>
    <script>
      (function () {
        var QS = [
          { q: 'What kind of community do you lead?', opts: [
            { label: 'Single-family / master-planned HOA', tag: 'hoa' },
            { label: 'Condominium or high-rise', tag: 'condo' },
            { label: 'Townhome association', tag: 'condo' },
            { label: "I'm a developer building one", tag: 'dev' }
          ]},
          { q: 'What do you need help with?', opts: [
            { label: 'The whole operation — top to bottom', tag: 'full' },
            { label: 'Mostly the financials & books', tag: 'fin' },
            { label: "We're switching from another manager", tag: 'switch' },
            { label: 'Honestly, not sure yet', tag: 'unsure' }
          ]},
          { q: 'How is it going today?', opts: [
            { label: 'Self-managed and stretched thin', tag: 'self' },
            { label: 'Have a manager, but unhappy', tag: 'unhappy' },
            { label: 'Brand-new or pre-construction', tag: 'new' },
            { label: 'Doing okay, just exploring', tag: 'explore' }
          ]}
        ];
        var RESULTS = {
          condo: { e: 'Recommended', t: 'Condo & Townhome Management', d: 'Shared walls and building systems need a dedicated practice — not a single-family playbook. That’s exactly what our condo team does.', href: '/condo-and-townhome-management', cta: 'Explore condo management' },
          dev: { e: 'Recommended', t: 'Developer HOA Management', d: 'From the first pro forma to homeowner turnover, we’re a lifecycle partner — flat $50/month until the first home is occupied.', href: '/developer-hoa-management', cta: 'Explore developer services' },
          fin: { e: 'Recommended', t: 'HOA Financial Management', d: 'Keep running your community and let us run the books — accounting, reporting, and full transparency to every owner by the 20th.', href: '/hoa-financial-management', cta: 'Explore financial-only' },
          switch: { e: 'Recommended', t: 'Switching Management Companies', d: 'We’ve run this transition hundreds of times. See the Day 1 to Day 90 plan that makes the change feel like relief.', href: '/switching-hoa-management-companies', cta: 'See the transition plan' },
          self: { e: 'Recommended', t: 'Self-Managed vs. Professional', d: 'Stretched-thin volunteers have options short of handing over everything. Here’s the honest comparison — and a middle path.', href: '/self-managed-hoa', cta: 'Weigh the options' },
          full: { e: 'Recommended', t: 'Full-Service HOA Management', d: 'One dedicated manager, a whole specialist team, and same-day answers. This is our flagship — and what most communities choose.', href: '/hoa-management-services', cta: 'Explore full-service' }
        };
        var body = document.getElementById('fit-body'), fill = document.getElementById('fit-fill');
        var step = 0, answers = [];
        function decide() {
          var tags = answers.map(function (a) { return a.tag; });
          if (tags.indexOf('condo') > -1) return 'condo';
          if (tags.indexOf('dev') > -1 || tags.indexOf('new') > -1) return 'dev';
          if (tags.indexOf('switch') > -1 || tags.indexOf('unhappy') > -1) return 'switch';
          if (tags.indexOf('fin') > -1) return 'fin';
          if (tags.indexOf('self') > -1) return 'self';
          return 'full';
        }
        function renderQ() {
          fill.style.width = (step / QS.length * 100) + '%';
          var qd = QS[step];
          body.innerHTML = '<div class="fit-step-n">Question ' + (step + 1) + ' of ' + QS.length + '</div>' +
            '<h3 class="fit-q">' + qd.q + '</h3><div class="fit-opts">' +
            qd.opts.map(function (o, i) { return '<button class="fit-opt" data-i="' + i + '"><span>' + o.label + '</span><span class="ar">→</span></button>'; }).join('') +
            '</div>' + (step > 0 ? '<button class="fit-back" id="fit-back">← Back</button>' : '');
          [].forEach.call(body.querySelectorAll('.fit-opt'), function (b) {
            b.addEventListener('click', function () { answers[step] = qd.opts[+b.dataset.i]; step++; step < QS.length ? renderQ() : renderResult(); });
          });
          var back = document.getElementById('fit-back');
          if (back) back.addEventListener('click', function () { step--; renderQ(); });
        }
        function renderResult() {
          fill.style.width = '100%';
          var r = RESULTS[decide()];
          body.innerHTML = '<div class="fit-result-eyebrow">' + r.e + ' for you</div>' +
            '<h3 class="fit-result-t">' + r.t + '</h3><p class="fit-result-d">' + r.d + '</p>' +
            '<div class="fit-result-actions"><a class="btn btn-green" href="' + r.href + '">' + r.cta + ' <span class="arrow">→</span></a>' +
            '<a class="btn btn-outline-blue" href="/request-a-proposal">Request a proposal</a></div>' +
            '<button class="fit-back" id="fit-restart">← Start over</button>';
          document.getElementById('fit-restart').addEventListener('click', function () { step = 0; answers = []; renderQ(); });
        }
        renderQ();
      })();
    </script>
  </section>

  <!-- COST -->
  <section class="cost">
    <div class="container cost-grid">
      <div class="reveal">
        <div class="eyebrow eyebrow-blue">What it costs</div>
        <h2 class="cost-h">How much does HOA management cost?</h2>
        <p class="cost-p">The honest answer: <strong>it depends on your community</strong> — so we quote custom every time, never a one-size template. What we'll never do is compete to be the cheapest name on the list.</p>
        <p class="cost-p">We compete on <strong>value</strong>. Better collections, smarter vendor pricing, and fewer expensive mistakes routinely cover the difference between us and a budget manager — and your board gets its evenings back on top of it.</p>
        <p class="cost-note">Want a real number? Request a proposal and we'll scope a quote to your community — no pressure, no obligation.</p>
      </div>
      <div class="cost-factors reveal">
        <div class="cost-frow"><span class="cost-fnum">01</span><div><h3 class="cost-ft">Size &amp; number of homes</h3><p class="cost-fd">More doors and more shared assets mean more to manage — the single biggest driver of scope.</p></div></div>
        <div class="cost-frow"><span class="cost-fnum">02</span><div><h3 class="cost-ft">Amenities &amp; common areas</h3><p class="cost-fd">Pools, gates, clubhouses, and private roads each add vendor coordination and oversight.</p></div></div>
        <div class="cost-frow"><span class="cost-fnum">03</span><div><h3 class="cost-ft">Service level</h3><p class="cost-fd">Full-service vs. financial-only vs. on-site staffing — you pay for the scope you actually need.</p></div></div>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED IMAGE MOMENT -->
  <section class="fbleed">
    <ImageSlot src="/photos/hoa-management-services-hoa-fullbleed.jpg" alt="Wide landscape of a Gulf South community neighborhood" shape="rect" />
    <div class="container fbleed-in">
      <div class="eyebrow">Why it matters</div>
      <p class="fbleed-q">We manage communities, <span class="g">not just buildings.</span></p>
      <p class="fbleed-sub">Behind every assessment and work order is a family, a board volunteer, a neighbor. <strong>We never forget that the community is people first.</strong></p>
    </div>
  </section>

  <!-- SIGNS — interactive self-assessment -->
  <section class="signs">
    <div class="container">
      <div class="signs-head reveal">
        <div class="eyebrow eyebrow-blue">Is it time?</div>
        <h2 class="signs-h">Signs your board has outgrown self-management.</h2>
        <p class="signs-sub">Tick the ones that sound like your community. There are no wrong answers — just an honest gut-check on whether it's time for help.</p>
      </div>
      <div class="signs-card reveal">
        <div class="signs-list" id="signs-list"></div>
        <div class="signs-result">
          <div class="signs-tally"><span class="big" id="signs-n">0</span> of 6 ring true</div>
          <div class="signs-msg" id="signs-msg">Tap the statements above that match your community.</div>
        </div>
      </div>
    </div>
    <script>
      (function () {
        var SIGNS = [
          'One or two volunteers are doing almost all the work',
          'Homeowner emails and requests pile up unanswered',
          'Our finances have outgrown a spreadsheet',
          'Delinquency keeps climbing and collections rarely happen',
          'Enforcing the rules is straining neighborly relationships',
          'We dread board meetings — they run long and circular'
        ];
        var list = document.getElementById('signs-list');
        var nEl = document.getElementById('signs-n'), msg = document.getElementById('signs-msg');
        var state = SIGNS.map(function () { return false; });
        var check = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        list.innerHTML = SIGNS.map(function (s, i) { return '<button class="sign" data-i="' + i + '"><span class="sign-box">' + check + '</span><span>' + s + '</span></button>'; }).join('');
        function tally() {
          var n = state.filter(Boolean).length;
          nEl.textContent = n;
          if (n === 0) msg.innerHTML = 'Tap the statements above that match your community.';
          else if (n <= 2) msg.innerHTML = "A couple of friction points — worth a conversation. <strong>We can take just the financials</strong> and leave the rest to you.";
