---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';
import ImageSlot from '~/components/ImageSlot.astro';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'About', url: SITE.url + '/about' },
  { name: 'CMGT Cares', url: SITE.url + '/about/cmgt-cares' },
]);
---
<BaseLayout
  title="CMGT Cares — Giving Back to Gulf South Communities"
  description="CMGT Cares — giving back to Gulf South communities since 2012. Community drives, local fundraisers, and showing up, because care is the third C."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"About","href":"/about"},{"t":"CMGT Cares"}]'></nav>

  <!-- HERO -->
  <section class="cc-hero">
    <div class="container">
      <div class="eyebrow eyebrow-blue">CMGT Cares · Since 2012</div>
      <h1 class="cc-hero-display">We care because <em>that's what matters most.</em></h1>
      <p class="cc-hero-lede">
        Managing communities means caring about more than the grass and the gates.
        <strong>CMGT Cares is how we show up for the places and people we serve</strong> —
        beyond the contract, all year long.
      </p>
    </div>
    <div class="cc-hero-band">
      <ImageSlot priority src="/photos/cc-hero-photo.webp" alt="CMGT team members and volunteers gathered at a Gulf South community giving-back event, working side by side outdoors" shape="rect" />
      <span class="tag">Giving back since 2012</span>
    </div>
  </section>

  <!-- INTRO -->
  <section class="cc-intro">
    <div class="container cc-intro-grid">
      <p class="cc-intro-label reveal">It's just who we are.</p>
      <div class="reveal">
        <p class="cc-intro-p">
          We started CMGT Cares in 2012 because the third C isn't a marketing line — it's the
          one that matters most. <strong>The day-to-day management has to be excellent — that's a given.</strong> Caring about the people behind the doors is what we're actually here for.
        </p>
        <p class="cc-intro-p">
          From local fundraisers to seasonal drives to simply showing up when a community needs
          a hand, CMGT Cares is our team putting the "care" in writing — <strong>caring about
          the quality of living, not just the value of the investment.</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- WAYS WE GIVE -->
  <section class="ways">
    <div class="container">
      <div class="ways-head reveal">
        <div class="eyebrow eyebrow-blue">Ways we give</div>
        <h2 class="ways-h">Three ways we show up.</h2>
      </div>
      <div class="ways-grid">
        <div class="way-card reveal">
          <h3 class="way-t">Community drives</h3>
          <p class="way-d">Seasonal giving — toy drives, supply drives, and relief efforts when the Gulf South needs it most.</p>
        </div>
        <div class="way-card reveal">
          <h3 class="way-t">Local fundraisers</h3>
          <p class="way-d">Events that rally our team and partner communities behind causes close to home.</p>
        </div>
        <div class="way-card reveal">
          <h3 class="way-t">Showing up</h3>
          <p class="way-d">Volunteer hours and a helping hand — the kind of support that never makes a press release.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- STORIES -->
  <section class="stories">
    <div class="container">
      <div class="stories-top">
        <div class="reveal">
          <div class="eyebrow eyebrow-blue">Recent stories</div>
          <h2 class="stories-h">A few moments we're proud of.</h2>
        </div>
      </div>
      <div class="stories-grid">
        <article class="story-card reveal">
          <ImageSlot src="/photos/cc-story-1.webp" alt="The Ballin' on Belrose charity basketball fundraiser in Denham Springs, with players and supporters gathered for the Baller Dream Foundation" shape="rounded" radius={14} />
          <div class="story-tag">Community · Event</div>
          <h3 class="story-t">Ballin' on Belrose 2026</h3>
          <p class="story-d">A Denham Springs fundraiser we're proud to take part in — supporting the Baller Dream Foundation and a good cause close to home.</p>
        </article>
        <article class="story-card reveal">
          <ImageSlot src="/photos/cc-story-2.webp" alt="CMGT community manager Natalie Vidrine being recognized for her dedication to The Village of River Ranch" shape="rounded" radius={14} />
          <div class="story-tag">Team · Recognition</div>
          <h3 class="story-t">River Ranch Recognition</h3>
          <p class="story-d">Our own Natalie Vidrine was featured for her dedication to The Village of River Ranch — exactly the kind of relationship with a community we're proud to build.</p>
        </article>
        <article class="story-card reveal">
          <ImageSlot src="/photos/cc-story-3.webp" alt="A roomful of donated toys collected by the CMGT team for the annual Toys for Tots holiday drive" shape="rounded" radius={14} />
          <div class="story-tag">Community · Giving</div>
          <h3 class="story-t">Toys for Tots</h3>
          <p class="story-d">Our team gathered and donated a roomful of toys for the annual Toys for Tots drive — a small way to brighten the holidays for local families.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CARE PULL -->
  <section class="care">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container care-in reveal">
      <div class="eyebrow" style="color: rgba(255,255,255,.6);">Why we do it</div>
      <p class="care-q">We don't just care about your problem. <span class="g">We care about you.</span> That's the whole idea behind everything with our name on it.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-in">
      <div class="reveal">
        <h2 class="cta-h">Have a cause we should know about?</h2>
        <p class="cta-p">If your community is rallying behind something, we'd love to hear about it — and lend a hand.</p>
      </div>
      <div class="reveal">
        <a class="btn btn-blue" href="/request-a-proposal">Get in touch <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }

  /* HERO — warm editorial, image band right of headline */
  .cc-hero { background: #fff; padding: 84px 0 0; }
  .cc-hero-display {
    font-family: var(--font-display); font-weight: 900;
    font-size: clamp(48px, 6.4vw, 100px); line-height: .97; letter-spacing: -.03em;
    color: var(--freedom-blue); margin: 22px 0 24px; max-width: 920px; text-wrap: balance;
  }
  .cc-hero-display em { font-style: italic; font-weight: 300; color: var(--landscaping-green); }
  .cc-hero-lede { font-size: 18px; line-height: 1.7; color: var(--ink-500); max-width: 600px; margin: 0 0 56px; }
  .cc-hero-lede strong { color: var(--freedom-blue); font-weight: 600; }
  .cc-hero-band { position: relative; }
  .cc-hero-band :global(.image-slot) { display: block; width: 100%; height: clamp(300px, 38vw, 500px); }
  .cc-hero-band .tag {
    position: absolute; left: 0; bottom: 0; z-index: 2;
    background: var(--landscaping-green); color: var(--freedom-blue);
    font-family: var(--font-display); font-weight: 700; font-size: 15px;
    padding: 12px 22px; border-top-right-radius: 14px;
  }

  /* INTRO */
  .cc-intro { background: #fff; padding: 100px 0; }
  .cc-intro-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 64px; align-items: start; }
  @media (max-width: 860px) { .cc-intro-grid { grid-template-columns: 1fr; gap: 24px; } }
  .cc-intro-label { font-family: var(--font-display); font-weight: 300; font-style: italic; font-size: clamp(26px, 3vw, 36px); color: var(--landscaping-green); line-height: 1.1; }
  .cc-intro-p { font-size: 17px; line-height: 1.75; color: var(--ink-700); margin: 0 0 18px; }
  .cc-intro-p:last-child { margin-bottom: 0; }
  .cc-intro-p strong { color: var(--freedom-blue); font-weight: 600; }

  /* WAYS WE GIVE */
  .ways { background: var(--nb-lightest); padding: 110px 0; }
  .ways-head { max-width: 680px; margin: 0 0 56px; }
  .ways-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(30px, 3.8vw, 46px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 0; text-wrap: balance; }
  .ways-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media (max-width: 880px) { .ways-grid { grid-template-columns: 1fr; } }
  .way-card { background: #fff; border-radius: 16px; padding: 34px 30px; border-top: 4px solid var(--landscaping-green); box-shadow: var(--shadow-2); }
  .way-t { font-family: var(--font-display); font-weight: 700; font-size: 22px; color: var(--freedom-blue); margin: 0 0 10px; }
  .way-d { font-size: 14.5px; line-height: 1.65; color: var(--ink-500); margin: 0; }

  /* STORIES */
  .stories { background: #fff; padding: 116px 0; }
  .stories-top { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: 48px; }
  .stories-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(30px, 3.8vw, 46px); line-height: 1.1; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 0; }
  .stories-note { font-size: 13.5px; color: var(--ink-400); max-width: 320px; }
  .stories-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
  @media (max-width: 900px) { .stories-grid { grid-template-columns: 1fr; } }
  .story-card :global(.image-slot) { width: 100%; height: 240px; margin-bottom: 20px; }
  a.story-card { display: block; transition: transform var(--dur-base) var(--ease-out); }
  a.story-card:hover { transform: translateY(-3px); }
  a.story-card:hover .story-t { color: var(--landscaping-green); }
  .story-tag { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--landscaping-green); margin-bottom: 8px; }
  .story-t { font-family: var(--font-display); font-weight: 700; font-size: 21px; line-height: 1.25; color: var(--freedom-blue); margin: 0 0 8px; }
  .story-d { font-size: 14.5px; line-height: 1.65; color: var(--ink-500); margin: 0; }

  /* CARE PULL */
  .care { background: var(--freedom-blue); color: #fff; padding: 116px 0; position: relative; overflow: hidden; }
  .care .leaf { position: absolute; left: -120px; bottom: -150px; width: 520px; height: 520px; opacity: .07; transform: rotate(14deg); pointer-events: none; }
  .care .leaf img { filter: brightness(0) invert(1); }
  .care-in { position: relative; max-width: 900px; }
  .care-q { font-family: var(--font-display); font-weight: 300; font-style: italic; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.28; letter-spacing: -.01em; margin: 16px 0 0; text-wrap: balance; }
  .care-q .g { color: var(--landscaping-green); font-style: normal; font-weight: 700; }

  /* CTA */
  .cta { background: var(--landscaping-green); color: var(--freedom-blue); padding: 96px 0; }
  .cta-in { display: flex; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .cta-h { font-family: var(--font-display); font-weight: 900; font-size: clamp(32px, 4.4vw, 56px); line-height: 1.02; letter-spacing: -.02em; margin: 0 0 10px; text-wrap: balance; }
  .cta-p { font-size: 16.5px; line-height: 1.6; max-width: 480px; margin: 0; color: rgba(30,30,119,.82); }
</style>
