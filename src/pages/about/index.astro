---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'About', url: SITE.url + '/about' },
]);
---
<BaseLayout
  title="About CMGT — Independent Gulf South HOA Management"
  description="Meet CMGT — Gulf South HOA management built on three C's: commit, communicate, care. Independently owned since 2007, nearly 400 communities in five states."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"About"}]'></nav>

  <!-- HERO -->
  <section class="hub-hero">
    <div class="container">
      <div class="eyebrow eyebrow-blue">About CMGT</div>
      <h1 class="hub-hero-display">Big, but <span class="u">approachable.</span></h1>
      <p class="hub-hero-lede">
        We're a people-first management company that believes <strong>how you do something matters
        more than what you do — and why.</strong> Big enough to protect you. Approachable enough
        that you'll never get lost in the shadow.
      </p>
    </div>
  </section>

  <!-- SECTION INDEX -->
  <section class="hub-index">
    <div class="container">
      <a class="hub-row reveal" href="/our-story">
        <span class="hub-num">01</span>
        <span>
          <h2 class="hub-t">Our Story</h2>
          <p class="hub-d">From "you couldn't pay me to do that" to nearly 400 communities — the founding, the flood, and the order of the P's.</p>
        </span>
        <span class="hub-arrow" aria-hidden="true">→</span>
      </a>
      <a class="hub-row reveal" href="/how-we-work">
        <span class="hub-num">02</span>
        <span>
          <h2 class="hub-t">How We Work</h2>
          <p class="hub-d">The pod model: one dedicated Community Association Manager, a whole specialist team behind them.</p>
        </span>
        <span class="hub-arrow" aria-hidden="true">→</span>
      </a>
      <a class="hub-row reveal" href="/about/team-careers">
        <span class="hub-num">03</span>
        <span>
          <h2 class="hub-t">Team & Careers</h2>
          <p class="hub-d">~91 people, remote-first, Gulf South roots — and what it takes to join them.</p>
        </span>
        <span class="hub-arrow" aria-hidden="true">→</span>
      </a>
      <a class="hub-row reveal" href="/about/cmgt-cares">
        <span class="hub-num">04</span>
        <span>
          <h2 class="hub-t">CMGT Cares</h2>
          <p class="hub-d">Giving back to the communities we serve since 2012 — toys, tournaments, and showing up.</p>
        </span>
        <span class="hub-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- STATEMENT -->
  <section class="hub-statement">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container hub-statement-in reveal">
      <p class="hub-statement-q">
        "We <span class="c">commit</span> because communities matter. We <span class="c">communicate</span>
        because people matter. We <span class="c">care</span> because that's what matters most."
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="hub-cta">
    <div class="container hub-cta-in">
      <div class="reveal">
        <h2 class="hub-cta-h">Get to know us in person.</h2>
        <p class="hub-cta-p">A conversation about your community — no pitch deck, no pressure, within two business days.</p>
      </div>
      <div class="reveal">
        <a class="btn btn-blue" href="/request-a-proposal">Request a proposal <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }

  /* HERO */
  .hub-hero { background: #fff; padding: 90px 0 70px; }
  .hub-hero-display {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(52px, 7vw, 104px);
    line-height: .98; letter-spacing: -.03em;
    color: var(--freedom-blue);
    margin: 22px 0 28px;
    max-width: 900px;
    text-wrap: balance;
  }
  .hub-hero-display .u { background: linear-gradient(transparent 80%, var(--landscaping-green) 80%); padding-bottom: .04em; }
  .hub-hero-lede { font-size: 18px; line-height: 1.7; color: var(--ink-500); max-width: 620px; margin: 0; }
  .hub-hero-lede strong { color: var(--freedom-blue); font-weight: 600; }

  /* SECTION INDEX */
  .hub-index { background: #fff; padding: 40px 0 110px; }
  .hub-row {
    display: grid; grid-template-columns: 110px 1fr 52px;
    gap: 40px; align-items: center;
    padding: 38px 0;
    border-top: 1.5px solid var(--hairline-strong);
    text-decoration: none;
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .hub-row:last-of-type { border-bottom: 1.5px solid var(--hairline-strong); }
  .hub-row:hover { border-top-color: var(--landscaping-green); }
  @media (max-width: 720px) { .hub-row { grid-template-columns: 56px 1fr; } .hub-arrow { display: none; } }
  .hub-num {
    font-family: var(--font-display); font-weight: 300; font-style: italic;
    font-size: clamp(34px, 4vw, 52px); line-height: 1;
    color: var(--landscaping-green);
  }
  .hub-t {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(26px, 3.4vw, 42px); line-height: 1.1; letter-spacing: -.015em;
    color: var(--freedom-blue);
    margin: 0 0 8px;
  }
  .hub-d { font-size: 15.5px; line-height: 1.6; color: var(--ink-500); margin: 0; max-width: 640px; }
  .hub-arrow {
    width: 52px; height: 52px; border-radius: 50%;
    border: 1.5px solid var(--hairline-strong);
    display: flex; align-items: center; justify-content: center;
    color: var(--freedom-blue);
    transition: all var(--dur-base) var(--ease-out);
    font-size: 20px;
  }
  .hub-row:hover .hub-arrow { background: var(--landscaping-green); border-color: var(--landscaping-green); transform: translateX(4px); }
  .hub-soon {
    display: inline-block;
    font-size: 10.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    color: var(--ink-400);
    border: 1px solid var(--hairline-strong); border-radius: 999px;
    padding: 3px 10px; margin-left: 12px; vertical-align: middle;
  }

  /* STATEMENT */
  .hub-statement { background: var(--freedom-blue); color: #fff; padding: 120px 0; position: relative; overflow: hidden; }
  .hub-statement .leaf { position: absolute; left: -120px; bottom: -140px; width: 520px; height: 520px; opacity: .07; transform: rotate(14deg); pointer-events: none; }
  .hub-statement .leaf img { filter: brightness(0) invert(1); }
  .hub-statement-in { position: relative; max-width: 980px; }
  .hub-statement-q {
    font-family: var(--font-display); font-weight: 300; font-style: italic;
    font-size: clamp(30px, 4.2vw, 52px); line-height: 1.25; letter-spacing: -.015em;
    margin: 0; text-wrap: balance;
  }
  .hub-statement-q .c { color: var(--landscaping-green); font-style: normal; font-weight: 700; }

  /* CTA */
  .hub-cta { background: var(--landscaping-green); color: var(--freedom-blue); padding: 90px 0; }
  .hub-cta-in { display: flex; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .hub-cta-h {
    font-family: var(--font-display); font-weight: 900;
    font-size: clamp(32px, 4.2vw, 54px); line-height: 1.04; letter-spacing: -.02em;
    margin: 0 0 10px; text-wrap: balance;
  }
  .hub-cta-p { font-size: 16.5px; line-height: 1.6; max-width: 480px; margin: 0; color: rgba(30,30,119,.82); }
</style>
