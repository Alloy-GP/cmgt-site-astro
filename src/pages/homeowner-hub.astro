---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';
import { orderDocsUrl } from '~/lib/order-docs';
import { PORTALS as SHARED_PORTALS } from '~/config/portals';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'Homeowner & Board Hub', url: SITE.url + '/homeowner-hub' },
]);

// The homeowner hub — the single account-access destination in the header. It
// replaced three separate utility links (Log In / Pay Dues / Order Documents),
// which all landed somewhere inside this page anyway.
//
// Was /login and noindex while it was an unlinked mockup. Now that the header
// points here it is indexable: a page linked from every page on the site should
// not be telling Google to ignore it. Old URL 301s from astro.config.mjs.
// External portal URLs live in src/config/portals.ts because /rentals deep-links
// straight into the owner and tenant portals; keeping one copy stops the two pages
// drifting apart. `docs` stays local — it is date-dependent, not a fixed URL.
const PORTALS = {
  ...SHARED_PORTALS,
  docs: orderDocsUrl(), // flips HomeWiseDocs → CondoCerts on Aug 1, 2026
};
---
<BaseLayout
  title="Homeowner & Board Hub — CMGT"
  description="One place for CMGT homeowners and board members: pay dues, order documents, submit a maintenance request, and reach your community's financials."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"Homeowner &amp; Board Hub"}]'></nav>

  <!-- HERO -->
  <section class="lh-hero">
    <div class="container">
      <div class="lh-hero-in">
        <!-- Framed as a hub, not a login screen. Logging in is one of several things
             this page does — dues, documents, maintenance requests and, later, board
             training all live here too, so the H1 should not narrow it to "log in". -->
        <div class="eyebrow">Homeowners &amp; boards</div>
        <h1 class="lh-hero-h">Dues, documents, <em>and everything else.</em></h1>
        <p class="lh-hero-p">
          Everything homeowners and board members reach for — dues, documents, financials,
          and requests — with your account and the quick actions all in one place.
        </p>
      </div>
    </div>
  </section>

  <!-- LOGINS BY AUDIENCE -->
  <section class="lh-sec">
    <div class="container">
      <div class="lh-head">
        <div class="eyebrow eyebrow-blue">Log in to your account</div>
        <h2 class="lh-h2">Your community account.</h2>
        <p class="lh-sub">Dues, documents, financials, and requests — all in one place, for homeowners and board members alike.</p>
      </div>

      <div class="lh-two">
        <div class="lh-card">
          <div class="lh-ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10.5 9-7.5 9 7.5"/><path d="M5.5 8.7V20a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V8.7"/><path d="M9.5 21v-6.5a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1V21"/></svg>
          </div>
          <div class="lh-who">HOA homeowners &amp; boards</div>
          <h3 class="lh-t">Homeowner &amp; Board Portal</h3>
          <p class="lh-d">Pay dues, view your community's documents and financials, submit requests, and manage your account.</p>
          <a class="btn btn-blue" href={PORTALS.hoa} target="_blank" rel="noopener noreferrer">Log in <span class="arrow">→</span></a>
        </div>

        <!-- The Owner and Resident portal cards used to sit here. They are rental
             products, Baton Rouge only, and this page is now the HOA homeowner and
             board hub — so they live on /rentals instead, where that audience
             already is. The link below is the way across for anyone who lands here
             by mistake. -->

        <!-- Quick actions used to be a full section of their own below this one. With
             the two rental cards gone, the login card left most of a row empty while
             the actions repeated the same tile shape further down the page. They now
             fill that space as a stacked column, deliberately shaped differently from
             the login card — compact rows rather than a panel — so the hierarchy reads
             as "your account, and the three things you came to do". -->
        <div class="lh-quick">
          <div class="lh-quick-h">In a hurry?</div>

          <a class="lh-action lh-action--dues" href={PORTALS.hoa} target="_blank" rel="noopener noreferrer">
            <span class="lh-action-ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
            </span>
            <span class="lh-action-body"><span class="lh-action-t">Pay Dues</span><span class="lh-action-d">HOA homeowner portal</span></span>
            <span class="lh-action-ar">→</span>
          </a>

          <a class="lh-action lh-action--docs" href={PORTALS.docs} target="_blank" rel="noopener noreferrer">
            <span class="lh-action-ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h8"/></svg>
            </span>
            <span class="lh-action-body"><span class="lh-action-t">Order Documents</span><span class="lh-action-d">Resale &amp; closing docs</span></span>
            <span class="lh-action-ar">→</span>
          </a>

          <!-- Submit a Maintenance Request moved to /rentals. Fix-It Squad is a
               Baton Rouge rental service; HOA homeowners and boards raise requests
               through the community portal above, not through it. -->
        </div>
      </div>
      <p class="lh-cross">Renting from us, or own a rental we manage? Your portals are on the <a href="/rentals">Baton Rouge rental management page</a>.</p>
    </div>
  </section>

  <!-- LEARNING & RESOURCES (future) -->
  <section class="lh-sec lh-sec-divided">
    <div class="container">
      <div class="lh-head">
        <div class="eyebrow eyebrow-green">Coming soon</div>
        <h2 class="lh-h2">Learning &amp; resources.</h2>
        <p class="lh-sub">We're building a library of training and guides — right here, alongside your account. Board education and homeowner how-tos, all in one place.</p>
      </div>

      <div class="lh-res-grid">
        <div class="lh-res-card">
          <span class="lh-soon">Coming soon</span>
          <h3 class="lh-res-t">Board Training</h3>
          <p class="lh-res-d">Short courses for volunteer board members — running meetings, reading financials, enforcing covenants fairly.</p>
        </div>
        <div class="lh-res-card">
          <span class="lh-soon">Coming soon</span>
          <h3 class="lh-res-t">Homeowner Guides</h3>
          <p class="lh-res-d">Plain-language how-tos for homeowners — dues, documents, architectural requests, and what to expect from your association.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- HELP -->
  <section class="lh-help">
    <div class="container lh-help-in">
      <p class="lh-help-t">Not sure where to go?</p>
      <a class="lh-help-phone" href="tel:2255032648">Call us — <strong>(225) 503-2648</strong> · Mon–Fri, 8:30a–4:30p CT</a>
    </div>
  </section>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }
  .eyebrow-green { color: var(--landscaping-green); font-weight: 700; }

  /* HERO */
  .lh-hero { background: var(--freedom-blue); color: #fff; padding: 96px 0 84px; position: relative; overflow: hidden; isolation: isolate; }
  .lh-hero::after { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 16% 18%, rgba(141,189,255,.12) 0%, transparent 55%); z-index: 0; pointer-events: none; }
  .lh-hero-in { position: relative; z-index: 2; max-width: 720px; }
  .lh-hero .eyebrow { color: rgba(255,255,255,.65); }
  .lh-hero-h { font-family: var(--font-display); font-weight: 900; font-size: clamp(42px, 5.6vw, 82px); line-height: 1.0; letter-spacing: -.03em; color: #fff; margin: 18px 0 22px; text-wrap: balance; }
  .lh-hero-h em { font-style: italic; font-weight: 300; color: var(--landscaping-green); }
  .lh-hero-p { font-size: 17.5px; line-height: 1.7; color: rgba(255,255,255,.82); margin: 0; max-width: 560px; }

  /* SECTIONS */
  .lh-sec { background: #fff; padding: 96px 0; }
  .lh-sec-alt { background: var(--nb-lightest); }
/* Both this section and the account section above it are #fff, so without a rule
   they run together as one long block. Same treatment as the city pages use
   between their two white sections. */
.lh-sec-divided { border-top: 1px solid var(--hairline); }
  .lh-head { max-width: 680px; margin: 0 0 44px; }
  .lh-h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 14px 0 12px; text-wrap: balance; }
  .lh-sub { font-size: 16.5px; line-height: 1.7; color: var(--ink-500); margin: 0; }

  /* AUDIENCE LOGIN CARDS */
  /* Account card on the left, quick actions stacked on the right. The card is fixed
   at a card's width so it stays a card; the actions take the rest rather than
   leaving the row half empty, which is what it did when they lived in their own
   section below. */
/* The actions column is capped, not 1fr. Left to fill the container it stretched to
   ~760px and opened a dead gap between each label and its arrow — the same wasted
   space the stacking was meant to remove, just moved. */
.lh-two { display: grid; grid-template-columns: 380px minmax(0, 480px); gap: 28px; align-items: stretch; justify-content: start; }
@media (max-width: 900px) { .lh-two { grid-template-columns: 1fr; } }
/* The two actions divide the card's height between them rather than sitting as
   short rows with dead space beneath. Dropping the third action to /rentals left
   the column noticeably shorter than the card; stretching is what keeps the row
   reading as one balanced unit. Height is not forced on small screens, where the
   columns stack and there is nothing to match. */
.lh-quick { display: flex; flex-direction: column; gap: 12px; }
.lh-quick .lh-action { flex: 1 1 0; }
@media (max-width: 900px) { .lh-quick .lh-action { flex: 0 0 auto; } }
.lh-quick-h { font-family: var(--font-body); font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-400); margin: 2px 0 4px; }
.lh-cross { margin: 26px 0 0; font-size: 15px; line-height: 1.6; color: var(--ink-500); }
.lh-cross a { color: var(--freedom-blue); font-weight: 600; text-decoration: none; border-bottom: 2px solid var(--landscaping-green); }
.lh-cross a:hover { color: var(--landscaping-green); border-bottom-color: var(--freedom-blue); }
  @media (max-width: 900px) { .lh-grid { grid-template-columns: 1fr; } }
  .lh-card { display: flex; flex-direction: column; align-items: flex-start; background: #fff; border: 1.5px solid var(--hairline-strong); border-radius: 16px; padding: 30px 28px; transition: border-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out); }
  .lh-card:hover { border-color: var(--landscaping-green); transform: translateY(-3px); box-shadow: 0 12px 30px rgba(30,30,119,.09); }
  .lh-ic { width: 46px; height: 46px; border-radius: 12px; background: var(--fb-lightest); color: var(--freedom-blue); display: flex; align-items: center; justify-content: center; margin-bottom: 18px; }
  .lh-ic svg { width: 24px; height: 24px; }
  .lh-who { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-400); margin-bottom: 6px; }
  .lh-geo { color: var(--landscaping-green); }
  .lh-t { font-family: var(--font-display); font-weight: 700; font-size: 21px; line-height: 1.15; color: var(--freedom-blue); margin: 0 0 10px; }
  .lh-d { font-size: 14.5px; line-height: 1.65; color: var(--ink-500); margin: 0 0 22px; flex-grow: 1; }
  .lh-card .btn { align-self: flex-start; }

  /* QUICK ACTIONS */
  /* Deliberately not the login card's shape: no thick panel border, a tinted fill
   instead of white, and a left accent bar that differs per action so the three
   read as three distinct errands rather than three copies of the same tile. All
   tints derive from existing brand tokens. */
.lh-action { position: relative; overflow: hidden; }
.lh-action::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; }
.lh-action--dues { background: rgba(74,207,108,.10); border-color: rgba(74,207,108,.42); }
.lh-action--dues::before { background: var(--landscaping-green); }
.lh-action--dues .lh-action-ic { background: rgba(74,207,108,.20); }
.lh-action--docs { background: var(--fb-lightest); border-color: rgba(30,30,119,.20); }
.lh-action--docs::before { background: var(--freedom-blue); }
.lh-action--docs .lh-action-ic { background: rgba(30,30,119,.10); }
.lh-action--fix { background: var(--nb-lightest); border-color: rgba(141,189,255,.62); }
.lh-action--fix::before { background: var(--neighborly-blue); }
.lh-action--fix .lh-action-ic { background: rgba(141,189,255,.34); }
  @media (max-width: 860px) {  }
  .lh-action { display: flex; align-items: center; gap: 14px; background: #fff; border: 1.5px solid var(--hairline-strong); border-radius: 12px; padding: 16px 20px 16px 22px; text-decoration: none; transition: border-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .lh-action:hover { border-color: var(--landscaping-green); transform: translateY(-2px); }
  .lh-action-ic { flex-shrink: 0; width: 44px; height: 44px; border-radius: 12px; background: var(--fb-lightest); color: var(--freedom-blue); display: flex; align-items: center; justify-content: center; }
  .lh-action-ic svg { width: 23px; height: 23px; }
  .lh-action-body { display: flex; flex-direction: column; flex-grow: 1; }
  .lh-action-t { font-family: var(--font-display); font-weight: 700; font-size: 17px; color: var(--freedom-blue); line-height: 1.2; }
  .lh-action-d { font-size: 13.5px; color: var(--ink-400); margin-top: 3px; }
  .lh-action-ar { color: var(--landscaping-green); font-size: 18px; font-weight: 700; }

  /* LEARNING & RESOURCES */
  /* Two cards, not three: the third was written for an audience this page no longer
   serves. They split the row rather than sitting at a third each with a gap where
   the third used to be.

   Keep explanatory notes in this style block, not in HTML comments — Astro emits
   body comments to the browser, so a note describing removed copy would ship the
   very wording that was removed. */
.lh-res-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  @media (max-width: 900px) { .lh-res-grid { grid-template-columns: 1fr; } }
  .lh-res-card { position: relative; background: var(--nb-lightest); border: 1.5px dashed var(--hairline-strong); border-radius: 16px; padding: 28px 26px; }
  .lh-soon { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--landscaping-green); background: rgba(74,207,108,.12); padding: 4px 11px; border-radius: 999px; margin-bottom: 14px; }
  .lh-res-t { font-family: var(--font-display); font-weight: 700; font-size: 19px; color: var(--freedom-blue); margin: 0 0 9px; }
  .lh-res-d { font-size: 14px; line-height: 1.6; color: var(--ink-500); margin: 0; }

  /* HELP */
  .lh-help { background: var(--freedom-blue); color: #fff; padding: 40px 0; }
  .lh-help-in { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .lh-help-t { font-family: var(--font-display); font-weight: 700; font-size: 20px; color: #fff; margin: 0; }
  .lh-help-phone { font-size: 15px; color: rgba(255,255,255,.85); text-decoration: none; }
  .lh-help-phone strong { color: #fff; }
</style>
