---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';
import ImageSlot from '~/components/ImageSlot.astro';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'On-Site Management', url: SITE.url + '/on-site-management' },
]);

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'On-Site HOA & Condo Management',
  serviceType: 'On-site community association management',
  provider: { '@type': 'Organization', name: 'CMGT', url: SITE.url + '/' },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Louisiana' },
    { '@type': 'AdministrativeArea', name: 'Mississippi' },
    { '@type': 'AdministrativeArea', name: 'Alabama' },
    { '@type': 'AdministrativeArea', name: 'Texas' },
    { '@type': 'AdministrativeArea', name: 'Florida' },
  ],
  description: "A standalone on-site management service for large master-planned single-family communities and high-rise and condo associations — a daily on-property team (CAM, on-site maintenance, groundskeeper) backed by CMGT's specialist support departments.",
  url: SITE.url + '/on-site-management',
};
---
<BaseLayout
  title="On-Site HOA & Condo Management — Daily Presence — CMGT"
  description="On-site management for large communities and high-rise condos — a daily on-property team backed by CMGT's specialist departments across five states."
  pageSchema={[breadcrumb, service]}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"On-Site Management"}]'></nav>

  <!-- HERO -->
  <section class="ph-hero">
    <div class="container">
      <div class="ph-hero-top">
        <div>
          <div class="eyebrow">On-Site Management</div>
          <h1 class="ph-hero-display">A team on your property, <em>every day.</em></h1>
        </div>
        <div>
          <p class="ph-hero-lede">
            For large master-planned communities, high-rises, and luxury condos, the best
            management has a team on site every day. On-Site is a <strong>standalone plan</strong>
            built for exactly that — a dedicated manager, in-house maintenance, and a dedicated
            groundskeeper on your property daily, with CMGT's whole specialist bench right behind them.
          </p>
          <div class="ph-hero-ctas">
            <a class="btn btn-green" href="/request-a-proposal">Start the conversation <span class="arrow">→</span></a>
            <a class="btn btn-outline-light" href="/how-we-work">How we work</a>
          </div>
        </div>
      </div>
    </div>
    <div class="ph-hero-band">
      <ImageSlot src="/photos/on-site-management-showing-clubhouse.webp" alt="A CMGT on-site community manager with a tablet showing a resident around a Gulf South clubhouse community" shape="rect" />
    </div>
    <div class="container">
      <div class="ph-hero-stats">
        <div><div class="ph-stat-num">Daily</div><div class="ph-stat-label">a dedicated team on your property — not just for scheduled visits</div></div>
        <div><div class="ph-stat-num" data-count-to="5" data-duration="900">0</div><div class="ph-stat-label">states — On-Site is available in every one</div></div>
        <div><div class="ph-stat-num">Full pod</div><div class="ph-stat-label">specialist departments still on your account</div></div>
        <div><div class="ph-stat-num">In-house</div><div class="ph-stat-label">maintenance, accountable to the same team</div></div>
      </div>
    </div>
  </section>

  <!-- WHAT ON-SITE ADDS -->
  <section class="life">
    <div class="container">
      <div class="life-head reveal">
        <div class="eyebrow eyebrow-blue">A standalone plan</div>
        <h2 class="life-h">What a team on the ground, every day, actually changes.</h2>
        <p class="life-sub">Plenty of communities thrive with a dedicated manager and specialist team working remotely — it's how we deliver, beautifully, at scale. But when a community is large, amenity-rich, or vertical, some things only happen when there's a team right there. <strong>That's the whole point of On-Site — a plan in its own right, not an add-on.</strong></p>
      </div>
      <div class="life-track">
        <div class="life-step reveal"><div class="life-phase">On the ground</div><h3 class="life-t">Daily site inspections</h3><p class="life-d">Eyes on the property every day — catching issues while they're small, not at the next scheduled drive-through.</p></div>
        <div class="life-step reveal"><div class="life-phase">On the ground</div><h3 class="life-t">On-site vendor coordination</h3><p class="life-d">Vendors are met, monitored, and managed in person — routine work approved within budget, larger spend escalated to the board.</p></div>
        <div class="life-step reveal"><div class="life-phase">On the ground</div><h3 class="life-t">In-person covenant enforcement</h3><p class="life-d">Walkthroughs, notices, and the hard conversations handled face to face — consistently, and with compassion.</p></div>
        <div class="life-step reveal"><div class="life-phase">On the ground</div><h3 class="life-t">Direct homeowner interaction</h3><p class="life-d">Someone homeowners can actually find — answering questions and handling concerns in person, on the property.</p></div>
      </div>
    </div>
  </section>

  <!-- THE ON-SITE TEAM -->
  <section class="pr">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container pr-in">
      <div class="eyebrow reveal" style="color: rgba(255,255,255,.6);">The on-site team</div>
      <h2 class="pr-h reveal">A dedicated team — on your property, daily.</h2>
      <p class="pr-lede reveal">On-Site communities get a team built around the property itself. <strong>The on-site maintenance lead is part of that team</strong> — so the person fixing things answers to the same company managing your community, not an outside vendor you'd have to chase. For most communities, that kind of maintenance accountability isn't available any other way.</p>
      <div class="pr-grid">
        <div class="reveal">
          <div class="pr-big">Community<br>Association Manager</div>
          <h3 class="pr-t">The face on the property</h3>
          <p class="pr-d">A dedicated CAM who knows the community because they're in it — running the day-to-day and owning the board relationship.</p>
        </div>
        <div class="reveal">
          <div class="pr-big">On-Site<br>Maintenance</div>
          <h3 class="pr-t">In-house, on call</h3>
          <p class="pr-d">A maintenance team member on the property — handling the work, and accountable to the same company managing the community.</p>
        </div>
        <div class="reveal">
          <div class="pr-big">Dedicated<br>Groundskeeper</div>
          <h3 class="pr-t">The look of the place</h3>
          <p class="pr-d">Common areas, amenities, and landscaping kept to standard by someone whose job is this community — every day.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON: Full-Service vs On-Site -->
  <section class="cmp">
    <div class="container">
      <div class="cmp-head reveal">
        <div class="eyebrow eyebrow-blue">Full-Service vs. On-Site</div>
        <h2 class="cmp-h">Two strong plans. The difference is presence.</h2>
        <p class="cmp-sub">Most communities are a perfect fit for Full-Service — a dedicated manager and specialist team running everything for them. <strong>On-Site is the choice when a community is large or complex enough to want that same team physically on the property, every day.</strong></p>
      </div>
      <div class="cmp-scroll reveal">
        <table class="cmp-table">
          <thead>
            <tr>
              <th></th>
              <th class="cmp-th-fs">Full-Service Management</th>
              <th class="cmp-th-os">On-Site Management</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th class="cmp-row-label" scope="row">Site inspections</th>
              <td class="cmp-col">On a regular, scheduled cadence</td>
              <td class="cmp-col cmp-col-os"><strong>Every day</strong>, on foot</td>
            </tr>
            <tr>
              <th class="cmp-row-label" scope="row">A manager on the property</th>
              <td class="cmp-col">For board meetings and scheduled visits</td>
              <td class="cmp-col cmp-col-os"><strong>On site daily</strong> — there for walk-up questions, not just appointments</td>
            </tr>
            <tr>
              <th class="cmp-row-label" scope="row">Maintenance</th>
              <td class="cmp-col">Coordinated through trusted, vetted vendors</td>
              <td class="cmp-col cmp-col-os"><strong>CMGT's own maintenance &amp; grounds staff</strong>, on site</td>
            </tr>
            <tr>
              <th class="cmp-row-label" scope="row">Homeowner questions</th>
              <td class="cmp-col">By phone, email &amp; portal — reliably followed up</td>
              <td class="cmp-col cmp-col-os">All of that — <strong>plus a real person on site</strong> to answer in person</td>
            </tr>
            <tr>
              <th class="cmp-row-label" scope="row">Financials, reporting &amp; ARC</th>
              <td class="cmp-col">Run by CMGT's specialist departments</td>
              <td class="cmp-col cmp-col-os">Run by the <strong>same</strong> specialist departments</td>
            </tr>
            <tr>
              <th class="cmp-row-label" scope="row">Built for</th>
              <td class="cmp-col">Most single-family, townhome &amp; master-planned HOAs</td>
              <td class="cmp-col cmp-col-os">Large master-planned, high-rise &amp; luxury communities</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- STILL BACKED BY THE POD -->
  <section class="mkt">
    <div class="container mkt-grid">
      <div class="reveal">
        <div class="eyebrow eyebrow-blue">On-site, never on an island</div>
        <h2 class="mkt-h">A team on your property — and the full specialist bench behind them.</h2>
        <p class="mkt-p">
          A daily on-property team doesn't mean a skeleton crew. <strong>Financials, monthly
          reporting, and architectural review are run by CMGT's specialist departments</strong>
          — the same accounts payable, accounts receivable, customer support, and ARC teams behind
          every community we manage, on every plan.
        </p>
        <p class="mkt-p">
          That's what lets the on-site team do what they're there for — being present, visible, and
          responsive — while the back office keeps the books clean and the financials in every
          homeowner's inbox by the 20th.
        </p>
      </div>
      <div class="mkt-media reveal">
        <ImageSlot src="/photos/on-site-cam-helping-residents.webp" alt="A CMGT on-site community manager helping residents at the clubhouse front desk" shape="rounded" radius={20} />
      </div>
    </div>
  </section>

  <!-- TWO AUDIENCES -->
  <section class="aud">
    <div class="container">
      <div class="aud-head reveal">
        <div class="eyebrow eyebrow-blue">Who On-Site is for</div>
        <h2 class="aud-h">One service, built for two kinds of community.</h2>
        <p class="aud-sub">On-Site spans both sides of our practice — large single-family communities <strong>and</strong> high-rise and condo associations. The delivery model is the same; the fit looks a little different.</p>
      </div>
      <div class="aud-grid">
        <div class="aud-card reveal">
          <div class="aud-kicker">Single-family</div>
          <h3 class="aud-card-t">On-Site for large master-planned communities</h3>
          <p class="aud-card-d">Gated, amenity-heavy, hundreds of homes. When the clubhouse, the pools, the trails, and the vendor traffic add up to a full-time job, a daily on-site team keeps the community running and looking the part.</p>
          <ul class="aud-list">
            <li>Large-scale, master-planned neighborhoods</li>
            <li>Gated communities with active amenities</li>
            <li>Developers planning the next master-planned community</li>
          </ul>
        </div>
        <div class="aud-card reveal">
          <div class="aud-kicker">High-rise &amp; condo</div>
          <h3 class="aud-card-t">On-Site for high-rises &amp; luxury condos</h3>
          <p class="aud-card-d">Shared structures and building systems don't wait for a site visit. A daily on-site presence handles the lobby, the homeowners, and the vendors in person — backed by a team that understands shared-wall living.</p>
          <ul class="aud-list">
            <li>High-rise buildings</li>
            <li>Luxury condominium communities</li>
            <li>Boards that need a visible daily point of contact</li>
          </ul>
        </div>
      </div>
      <p class="aud-note reveal"><strong>Available across all five states</strong>, including Florida, where On-Site serves large master-planned communities. Florida condominium <em>regimes</em> are the one thing we don't manage there — we're glad to handle everything else.</p>

    </div>
  </section>

  <!-- PEER -->
  <section class="peers">
    <div class="container">
      <div class="peers-head reveal">
        <div class="eyebrow eyebrow-blue">More ways we manage</div>
        <h2 class="peers-h">Every community is different. So are our plans.</h2>
        <p class="peers-sub">On-Site is a standalone plan for communities that need daily presence. Each of these is a full practice in its own right — if one's a better match for your community, start there.</p>
      </div>
      <div class="peers-grid">
        <a class="peer-card reveal" href="/hoa-management-services">
          <h3 class="peer-t">Full-Service Management</h3>
          <p class="peer-d">A dedicated manager and full specialist team, delivered remotely — the right fit for most communities.</p>
          <span class="peer-cta">Explore full-service <span class="arrow">→</span></span>
        </a>
        <a class="peer-card reveal" href="/hoa-financial-management">
          <h3 class="peer-t">HOA Financial Management</h3>
          <p class="peer-d">Professional books, collections, and transparent reporting — sized and priced for smaller communities.</p>
          <span class="peer-cta">Explore financial management <span class="arrow">→</span></span>
        </a>
        <a class="peer-card reveal" href="/condo-management">
          <h3 class="peer-t">Condo & Townhome Management</h3>
          <p class="peer-d">A dedicated practice for shared structures — where many On-Site high-rise and condo communities begin.</p>
          <span class="peer-cta">Explore condo management <span class="arrow">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="container faq-grid">
      <div class="reveal">
        <div class="eyebrow eyebrow-blue">Common questions</div>
        <h2 class="faq-h">Before you ask.</h2>
      </div>
      <div class="faq-list reveal">
        <div class="faq-item">
          <button class="faq-q" type="button">How is On-Site different from your regular management?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in">Our flagship management is comprehensive and delivered remotely — a dedicated manager and a responsive specialist team. <strong>On-Site adds a team physically on the property every day of the week</strong>: daily inspections, in-person vendor coordination, and direct homeowner interaction. It's a standalone service, not a tier you upgrade into.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" type="button">Do we need full-service management to get On-Site?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in">No. On-Site is its own plan — not an upgrade you bolt onto another one. <strong>If your community needs a daily on-property team, On-Site is the plan you choose</strong>, full stop. You don't buy full-service first.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" type="button">Does going on-site mean a smaller team handles everything?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in">No — it's the opposite. A daily on-property team is <strong>backed by our full specialist bench</strong>: financials, monthly reporting, and architectural review are still run by the same back-office departments that support every CMGT community. Choosing On-Site means more people on your community, not fewer.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" type="button">Who's on the on-site team?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in">Typically a dedicated <strong>Community Association Manager, an on-site maintenance team member, and a groundskeeper.</strong> The maintenance role is part of the team — which gives boards in-house maintenance accountability most communities can only get through an outside vendor.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" type="button">What kinds of communities is On-Site for?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in">Two kinds: <strong>large master-planned single-family communities</strong> (gated, amenity-heavy) and <strong>high-rise and luxury condo communities.</strong> Same delivery model, two audiences — boards on either side can ask for it.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" type="button">Is On-Site available in Florida?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in">Yes — On-Site is available across all five states, and in Florida it supports large master-planned and non-condo communities. The one thing we don't take on in Florida is condominium <strong>regimes</strong>, where the state's regulations aren't a fit for the service standard we hold ourselves to.</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container cta-in">
      <div class="reveal">
        <h2 class="cta-h">Need boots on the ground?</h2>
        <p class="cta-p">Tell us about the community — the size, the amenities, the building — and we'll walk through what an on-site team would look like, and what stays with the specialist bench. We'll get back within two business days.</p>
      </div>
      <div class="cta-actions reveal">
        <a class="btn btn-blue" href="/request-a-proposal">Start the conversation <span class="arrow">→</span></a>
        <a class="cta-phone" href="tel:2255032648">Or call (225) 503-2648 · Mon–Fri, 8:30a–4:30p CT</a>
      </div>
    </div>
  </section>

  <script>
    (function () {
      document.querySelectorAll('.faq-item').forEach(function (item) {
        var btn = item.querySelector('.faq-q');
        var ans = item.querySelector('.faq-a');
        btn.addEventListener('click', function () {
          var open = item.classList.toggle('open');
          ans.style.maxHeight = open ? (ans.scrollHeight + 'px') : '0';
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }

  .ph-hero { background: var(--freedom-blue); color: #fff; padding: 96px 0 0; position: relative; overflow: hidden; isolation: isolate; }
  .ph-hero::after { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 16% 18%, rgba(141,189,255,.12) 0%, transparent 55%); z-index: 0; pointer-events: none; }
  .ph-hero-top { position: relative; z-index: 2; display: grid; grid-template-columns: 1.15fr .85fr; gap: 64px; align-items: end; padding-bottom: 64px; }
  @media (max-width: 980px) { .ph-hero-top { grid-template-columns: 1fr; gap: 32px; } }
  .ph-hero .eyebrow { color: rgba(255,255,255,.65); }
  .ph-hero-display { font-family: var(--font-display); font-weight: 900; font-size: clamp(42px, 5.2vw, 78px); line-height: 1.0; letter-spacing: -.03em; color: #fff; margin: 22px 0 0; text-wrap: balance; }
  .ph-hero-display em { font-style: italic; font-weight: 300; color: var(--landscaping-green); }
  .ph-hero-lede { font-size: 17.5px; line-height: 1.7; color: rgba(255,255,255,.82); margin: 0 0 30px; }
  .ph-hero-lede strong { color: #fff; font-weight: 600; }
  .ph-hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .ph-hero-band { position: relative; z-index: 2; }
  .ph-hero-band :global(.image-slot) { display: block; width: 100%; height: clamp(280px, 32vw, 420px); }
  .ph-hero-stats { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; padding: 30px 0; border-top: 1px solid rgba(255,255,255,.18); }
  @media (max-width: 620px) { .ph-hero-stats { grid-template-columns: 1fr 1fr; gap: 22px; } }
  .ph-stat-num { font-family: var(--font-display); font-weight: 700; font-size: 34px; line-height: 1.05; letter-spacing: -.02em; color: #fff; }
  .ph-stat-label { font-size: 12.5px; color: rgba(255,255,255,.6); margin-top: 7px; }

  /* WHAT ON-SITE ADDS */
  .life { background: #fff; padding: 112px 0; }
  .life-head { max-width: 760px; margin: 0 0 56px; }
  .life-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(30px, 3.8vw, 46px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
  .life-sub { font-size: 16.5px; line-height: 1.7; color: var(--ink-500); margin: 0; }
  .life-sub strong { color: var(--freedom-blue); font-weight: 600; }
  .life-track { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  @media (max-width: 920px) { .life-track { grid-template-columns: 1fr 1fr; gap: 32px 28px; } }
  @media (max-width: 540px) { .life-track { grid-template-columns: 1fr; } }
  .life-step { border-top: 3px solid var(--landscaping-green); padding-top: 22px; }
  .life-phase { font-family: var(--font-body); font-weight: 700; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-400); }
  .life-t { font-family: var(--font-display); font-weight: 700; font-size: 21px; line-height: 1.18; color: var(--freedom-blue); margin: 10px 0 10px; }
  .life-d { font-size: 14px; line-height: 1.65; color: var(--ink-500); margin: 0; }

  /* THE ON-SITE TEAM */
  .pr { background: var(--freedom-blue); color: #fff; padding: 110px 0; position: relative; overflow: hidden; }
  .pr .leaf { position: absolute; right: -120px; bottom: -140px; width: 480px; height: 480px; opacity: .07; transform: rotate(-12deg); pointer-events: none; }
  .pr .leaf img { filter: brightness(0) invert(1); }
  .pr-in { position: relative; }
  .pr-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.14; letter-spacing: -.015em; color: #fff; max-width: 760px; margin: 16px 0 18px; text-wrap: balance; }
  .pr-lede { font-size: 16.5px; line-height: 1.7; color: rgba(255,255,255,.78); max-width: 680px; margin: 0 0 56px; }
  .pr-lede strong { color: #fff; font-weight: 600; }
  .pr-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 44px; }
  @media (max-width: 820px) { .pr-grid { grid-template-columns: 1fr; gap: 38px; } }
  .pr-big { font-family: var(--font-display); font-weight: 700; font-size: 30px; line-height: 1.1; letter-spacing: -.02em; color: var(--landscaping-green); }
  .pr-t { font-family: var(--font-display); font-weight: 700; font-size: 20px; color: #fff; margin: 14px 0 10px; }
  .pr-d { font-size: 14.5px; line-height: 1.65; color: rgba(255,255,255,.72); margin: 0; }

  /* COMPARISON: Full-Service vs On-Site */
  .cmp { background: var(--nb-lightest); padding: 112px 0; }
  .cmp-head { max-width: 720px; margin: 0 0 44px; }
  .cmp-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
  .cmp-sub { font-size: 16px; line-height: 1.7; color: var(--ink-500); margin: 0; max-width: 660px; }
  .cmp-sub strong { color: var(--freedom-blue); font-weight: 600; }
  .cmp-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 18px; box-shadow: var(--shadow-2); }
  .cmp-table { width: 100%; min-width: 660px; border-collapse: collapse; background: #fff; }
  .cmp-table th, .cmp-table td { text-align: left; padding: 18px 22px; vertical-align: top; border-bottom: 1px solid var(--hairline); }
  .cmp-table tbody tr:last-child th, .cmp-table tbody tr:last-child td { border-bottom: 0; }
