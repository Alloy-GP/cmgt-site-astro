---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';

const breadcrumb = breadcrumbSchema([
  { name: 'Home',             url: SITE.url + '/' },
  { name: 'About',            url: SITE.url + '/about' },
  { name: 'Team & Careers',   url: SITE.url + '/team-and-careers' },
]);
---
<BaseLayout
  title="Team & Careers — CMGT | People First, Everything Follows"
  description="Careers at CMGT — a people-first, remote-first Gulf South team. The mindsets we hire for, life here, and open roles. Take the work seriously, not yourself."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"About","href":"/about"},{"t":"Team & Careers"}]'></nav>

  <!-- HERO -->
  <section class="tc-hero">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container tc-hero-in">
      <div class="eyebrow">Team &amp; Careers</div>
      <h1 class="tc-hero-display">People first. <em>Everything else follows.</em></h1>
      <p class="tc-hero-lede">
        Hire great people, give them great tools, pour into them — and they make the work great.
        <strong>We figured that out the hard way, and we're never going back.</strong>
      </p>
    </div>
  </section>

  <!-- MINDSETS -->
  <section class="mind">
    <div class="container">
      <div class="eyebrow eyebrow-blue reveal">The mindsets we hire for</div>
      <h2 class="mind-h reveal">Four ideas that shape how everyone here shows up.</h2>

      <div class="mind-row reveal">
        <h3 class="mind-name"><span class="g">01</span>The Greyhound Mentality</h3>
        <p class="mind-p">
          Greyhounds chase the same rabbit every day and never catch it — and come back the
          next day to run just as hard. The joy isn't in the capture; <strong>it's in the
          chase.</strong> Greatness here is a journey, not a destination. The only constant
          is that we're always improving.
        </p>
      </div>
      <div class="mind-row reveal">
        <h3 class="mind-name"><span class="g">02</span>People First</h3>
        <p class="mind-p">
          We had our priorities backward once — process, product, profit, and people last —
          and we lost good people for it. <strong>Invest in people, and everything else
          follows.</strong> It's the realization the whole company is built on.
        </p>
      </div>
      <div class="mind-row reveal">
        <h3 class="mind-name"><span class="g">03</span>Fall Forward</h3>
        <p class="mind-p">
          If we're not making mistakes, we're not trying hard enough. Nobody here fears for
          their job over an honest mistake — <em>the best ideas we've had came with scars.</em>
          Falling forward means pushing hard, moving fast, driven to be better.
        </p>
      </div>
      <div class="mind-row reveal">
        <h3 class="mind-name"><span class="g">04</span>Interactional, Not Transactional</h3>
        <p class="mind-p">
          Too many companies go straight to the point — file the ticket, move on. We go
          <strong>straight to the heart.</strong> Every interaction should leave a person
          knowing we care about them, not just their problem.
        </p>
      </div>
    </div>
  </section>

  <!-- LIFE -->
  <section class="life">
    <div class="container">
      <div class="life-head reveal">
        <div class="eyebrow eyebrow-blue">Life at CMGT</div>
        <h2 class="life-h">Remote-first. Family-first. Gulf South at heart.</h2>
        <p class="life-sub">We're about 91 people across five states, and we'd rather you do great work and make the school recital than log hours for the sake of it.</p>
      </div>
      <div class="life-grid">
        <div class="life-card reveal">
          <h3 class="life-card-t">Work from anywhere</h3>
          <p class="life-card-d">Fully remote since 2016 — long before it was fashionable. <strong>Our culture never lived in a building.</strong></p>
        </div>
        <div class="life-card reveal">
          <h3 class="life-card-t">Family comes first</h3>
          <p class="life-card-d">Kid's event at 9 AM? Go. <strong>Quality of work matters more than hours logged</strong> — we don't micromanage.</p>
        </div>
        <div class="life-card reveal">
          <h3 class="life-card-t">Room to grow</h3>
          <p class="life-card-d">Great tools, real investment, and the freedom to turn doing into thinking. We'd rather develop people than replace them.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- EVERY ROLE -->
  <section class="role">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container role-in reveal">
      <div class="eyebrow" style="color: rgba(255,255,255,.6);">Every role matters</div>
      <p class="role-q">Every job here has a value statement tying it to our mission — <span class="g">the It's a Wonderful Life philosophy:</span> if your position didn't exist, the whole thing would crumble.</p>
    </div>
  </section>

  <!-- OPENINGS -->
  <section class="jobs">
    <div class="container">
      <div class="jobs-top">
        <div class="reveal">
          <div class="eyebrow eyebrow-blue">Open roles</div>
          <h2 class="jobs-h">Come run with us.</h2>
        </div>
        <p class="jobs-note reveal">Placeholder roles — swap in live openings, or point this section at your ATS.</p>
      </div>
      <a class="job reveal" href="#">
        <div>
          <h3 class="job-t">Community Association Manager</h3>
          <span class="job-meta">Remote — Louisiana<span class="dot">·</span>Full-time<span class="dot">·</span>Management</span>
        </div>
        <span class="job-apply">View role <span class="arrow">→</span></span>
      </a>
      <a class="job reveal" href="#">
        <div>
          <h3 class="job-t">Staff Accountant</h3>
          <span class="job-meta">Remote — Gulf South<span class="dot">·</span>Full-time<span class="dot">·</span>Accounting</span>
        </div>
        <span class="job-apply">View role <span class="arrow">→</span></span>
      </a>
      <a class="job reveal" href="#">
        <div>
          <h3 class="job-t">Fix-It Squad Technician</h3>
          <span class="job-meta">On-site — Baton Rouge<span class="dot">·</span>Full-time<span class="dot">·</span>Maintenance</span>
        </div>
        <span class="job-apply">View role <span class="arrow">→</span></span>
      </a>
      <p class="jobs-empty reveal">Don't see your role? We're always glad to meet good people — <a href="/request-a-proposal" style="color: var(--freedom-blue); font-weight: 600;">say hello</a>.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-in">
      <div class="reveal">
        <h2 class="cta-h">Take the work seriously. Not yourself.</h2>
        <p class="cta-p">If that sounds like your kind of team, we'd love to meet you.</p>
      </div>
      <div class="reveal">
        <a class="btn btn-blue" href="#">See all openings <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }

  /* HERO — green band, left */
  .tc-hero { background: var(--landscaping-green); color: var(--freedom-blue); padding: 100px 0 90px; position: relative; overflow: hidden; isolation: isolate; }
  .tc-hero .leaf { position: absolute; right: -160px; bottom: -200px; width: 760px; height: 760px; opacity: .12; transform: none; pointer-events: none; z-index: 0; }
  .tc-hero .leaf img { width: 100%; height: 100%; filter: brightness(0) saturate(100%) invert(11%) sepia(64%) saturate(4147%) hue-rotate(238deg) brightness(85%) contrast(96%); }
  .tc-hero-in { position: relative; z-index: 2; }
  .tc-hero .eyebrow { color: rgba(30,30,119,.7); }
  .tc-hero-display {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(48px, 7vw, 100px); line-height: .96; letter-spacing: -.03em;
    color: var(--freedom-blue); margin: 22px 0 26px; max-width: 920px; text-wrap: balance;
  }
  .tc-hero-display em { font-style: normal; font-weight: 700; }
  .tc-hero-lede { font-size: 18px; line-height: 1.65; color: rgba(30,30,119,.85); max-width: 560px; margin: 0; }
  .tc-hero-lede strong { color: var(--freedom-blue); font-weight: 700; }

  /* MINDSETS */
  .mind { background: #fff; padding: 116px 0; }
  .mind-h {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(30px, 3.8vw, 46px); line-height: 1.1; letter-spacing: -.015em;
    color: var(--freedom-blue); max-width: 700px; margin: 16px 0 60px; text-wrap: balance;
  }
  .mind-row {
    display: grid; grid-template-columns: 260px 1fr; gap: 48px; align-items: baseline;
    padding: 44px 0; border-top: 1.5px solid var(--hairline-strong); max-width: 1000px;
  }
  @media (max-width: 820px) { .mind-row { grid-template-columns: 1fr; gap: 14px; } }
  .mind-name {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(24px, 2.8vw, 32px); line-height: 1.08; letter-spacing: -.015em; color: var(--freedom-blue); margin: 0;
  }
  .mind-name .g { color: var(--landscaping-green); font-style: normal; font-weight: 700; display: block; font-size: .62em; margin-bottom: 6px; }
  .mind-p { font-size: 16px; line-height: 1.75; color: var(--ink-500); margin: 0; max-width: 620px; }
  .mind-p strong { color: var(--freedom-blue); font-weight: 600; }
  .mind-p em { font-style: italic; }

  /* LIFE / values cards */
  .life { background: var(--nb-lightest); padding: 110px 0; }
  .life-head { max-width: 700px; margin: 0 0 56px; }
  .life-h {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(30px, 3.8vw, 46px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance;
  }
  .life-sub { font-size: 16.5px; line-height: 1.7; color: var(--ink-500); margin: 0; }
  .life-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media (max-width: 880px) { .life-grid { grid-template-columns: 1fr; } }
  .life-card { background: #fff; border-radius: 16px; padding: 32px 30px; box-shadow: var(--shadow-2); }
  .life-card-t { font-family: var(--font-display); font-weight: 700; font-size: 21px; color: var(--freedom-blue); margin: 0 0 10px; }
  .life-card-d { font-size: 14.5px; line-height: 1.65; color: var(--ink-500); margin: 0; }
  .life-card-d strong { color: var(--freedom-blue); font-weight: 600; }

  /* EVERY ROLE pull */
  .role { background: var(--freedom-blue); color: #fff; padding: 110px 0; position: relative; overflow: hidden; }
  .role .leaf { position: absolute; right: -110px; top: -130px; width: 460px; height: 460px; opacity: .07; transform: none; pointer-events: none; }
  .role .leaf img { filter: brightness(0) invert(1); }
  .role-in { position: relative; max-width: 900px; }
  .role-q {
    font-family: var(--font-display); font-weight: 700; font-style: normal;
    font-size: clamp(26px, 3.4vw, 42px); line-height: 1.3; letter-spacing: -.01em; margin: 16px 0 0; text-wrap: balance;
  }
  .role-q .g { color: var(--landscaping-green); font-style: normal; font-weight: 700; }

  /* OPENINGS */
  .jobs { background: #fff; padding: 116px 0; }
  .jobs-top { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: 44px; }
  .jobs-h {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(30px, 3.8vw, 46px); line-height: 1.1; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 0;
  }
  .jobs-note { font-size: 13.5px; color: var(--ink-400); max-width: 320px; }
  .job {
    display: grid; grid-template-columns: 1fr auto; gap: 20px; align-items: center;
    padding: 26px 4px; border-top: 1.5px solid var(--hairline-strong); text-decoration: none;
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .job:last-of-type { border-bottom: 1.5px solid var(--hairline-strong); }
  .job:hover { border-top-color: var(--landscaping-green); }
  .job-t { font-family: var(--font-display); font-weight: 700; font-size: 20px; color: var(--freedom-blue); margin: 0 0 4px; }
  .job-meta { font-size: 13.5px; color: var(--ink-400); }
  .job-meta .dot { color: var(--hairline-strong); margin: 0 8px; }
  .job-apply { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 14px; color: var(--freedom-blue); white-space: nowrap; }
  .job-apply .arrow { color: var(--landscaping-green); transition: transform var(--dur-base) var(--ease-out); }
  .job:hover .job-apply .arrow { transform: translateX(4px); }
  .jobs-empty { font-size: 14px; color: var(--ink-400); margin-top: 22px; }

  /* CTA */
  .cta { background: var(--landscaping-green); color: var(--freedom-blue); padding: 96px 0; }
  .cta-in { display: flex; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .cta-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(32px, 4.4vw, 56px); line-height: 1.02; letter-spacing: -.02em; margin: 0 0 10px; text-wrap: balance; }
  .cta-p { font-size: 16.5px; line-height: 1.6; max-width: 480px; margin: 0; color: rgba(30,30,119,.82); }
</style>
