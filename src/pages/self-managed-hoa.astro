---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema, faqSchema, serviceSchema } from '~/lib/schema';
import ImageSlot from '~/components/ImageSlot.astro';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'Self-Managed HOA vs. Professional', url: SITE.url + '/self-managed-hoa' },
]);
// Service, per the sitemap spec's schema-by-type. areaServed is the geography this
// page actually claims; the company itself stays the one Organization node.
const service = serviceSchema({
  name: 'Support for Self-Managed HOAs',
  description: 'Self-managed HOA or professional management? An honest comparison for volunteer boards — real costs, breaking points, and a financial-only middle path.',
  url: SITE.url + '/self-managed-hoa',
});
// Mirrors the on-page FAQ word for word (Google discards answers a reader can't see).
const faq = faqSchema([
  { q: `Can an HOA be self-managed?`, a: `Yes. No state we serve requires a homeowners association to hire a management company, and plenty of small communities run themselves well. The obligations don't go away, though — the board still has to keep the books, hold the meetings, enforce the covenants, and carry the insurance. Self-management means the volunteers do all of it.` },
  { q: `How much does a self-managed HOA save?`, a: `The management fee — and that's the whole list. Everything else stays: insurance, landscaping, utilities, reserves, legal and accounting. What self-management adds back is volunteer hours and the cost of mistakes — a missed insurance renewal, an under-funded reserve, a fine the association can't defend. Run the calculator above and put an honest price on the hours.` },
  { q: `What is financial-only HOA management?`, a: `A middle path. A management company keeps the books — billing, collections, bank reconciliations, budget, reserve contribution, monthly statements, tax and audit support — while the board keeps running meetings, covenants, and vendors. It's what our HOA financial management package does, and it's built for exactly the communities on this page.` },
  { q: `How do you transition from self-managed to a management company?`, a: `More simply than switching between companies, because there's no outgoing manager to negotiate with. The board votes, signs the agreement, and hands over the records it has — governing documents, bank statements, owner roster, vendor contracts, insurance policies. The new manager brings the books current, sets up billing, and notifies owners. The same Day 1 to Day 90 plan we use for boards switching companies applies, minus the part where we chase your old manager for records.` },
  { q: `When does a self-managed HOA need professional management?`, a: `When the work depends on one or two people, when the finances have outgrown a spreadsheet, or when enforcing the rules has started to cost friendships — the three signs at the top of this page. If your board recognizes one, the question isn't whether you've failed; it's whether the volunteers should still be carrying it.` },
]);

---
<BaseLayout
  title="Self-Managed HOA vs. Professional Management — CMGT"
  description="Self-managed HOA or professional management? An honest comparison for volunteer boards — real costs, breaking points, and a financial-only middle path."
  pageSchema={[breadcrumb, service, faq]}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"Self-Managed HOA vs. Professional"}]'></nav>

  <!-- HERO -->
  <section class="sol-hero">
    <div class="container sol-hero-grid">
      <div>
        <span class="sol-tag">Solutions</span>
        <h1 class="sol-hero-display">Self-managed HOA, or <span class="u">time for help?</span></h1>
        <p class="sol-hero-lede">
          Plenty of communities run themselves well — for a while. <strong>This is an honest look</strong>
          at what self-management really costs your volunteers, when it stops working, and the
          middle path most boards don't know exists.
        </p>
        <div class="sol-hero-ctas">
          <a class="btn btn-blue" href="/request-a-proposal">Talk it through <span class="arrow">→</span></a>
          <a class="btn btn-outline-blue" href="/hoa-financial-management">See financial-only help</a>
        </div>
      </div>
      <div class="sol-hero-media">
        <div class="block" aria-hidden="true"></div>
        <ImageSlot priority src="/photos/sm-hero-photo.webp" alt="Volunteer HOA board members meeting around a kitchen table, reviewing community paperwork together" shape="rounded" radius={20} />
      </div>
    </div>
  </section>

  <!-- SIGNS -->
  <section class="sig">
    <div class="container">
      <div class="sig-head reveal">
        <div class="eyebrow eyebrow-blue">Self-management works — until it doesn't</div>
        <h2 class="sig-h">Three signs your board is carrying too much.</h2>
        <p class="sig-sub">Self-managing is a real accomplishment. But volunteer time and goodwill are finite — <strong>here's when boards usually start looking for help.</strong></p>
      </div>
      <div class="sig-grid">
        <div class="sig-card reveal"><div class="sig-n">01</div><h3 class="sig-t">The work falls on one or two people</h3><p class="sig-d">When the treasurer or president is doing 20 hours a week and burning out, the community is one resignation away from chaos.</p></div>
        <div class="sig-card reveal"><div class="sig-n">02</div><h3 class="sig-t">The finances have outgrown a spreadsheet</h3><p class="sig-d">Reserves, audits, delinquency, and tax filings get complicated fast — and mistakes get expensive.</p></div>
        <div class="sig-card reveal"><div class="sig-n">03</div><h3 class="sig-t">Enforcing rules strains friendships</h3><p class="sig-d">It's hard to send your neighbor a violation notice. A neutral third party keeps the community fair and the friendships intact.</p></div>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="cmp">
    <div class="container">
      <div class="cmp-head reveal">
        <div class="eyebrow eyebrow-blue">Self-managed HOA vs. management company</div>
        <h2 class="cmp-h">An honest side-by-side.</h2>
        <p class="cmp-sub">No scare tactics. Just the real trade-offs, so your board can make the call that fits your community.</p>
      </div>
      <div class="cmp-table reveal">
        <div class="cmp-row head">
          <div class="cmp-aspect">&nbsp;</div>
          <div class="cmp-col-h cmp-col-self">Self-managed</div>
          <div class="cmp-col-h cmp-col-pro">With CMGT</div>
        </div>
        <div class="cmp-row">
          <div class="cmp-aspect">Cost</div>
          <div class="cmp-cell self">No management fee — but real volunteer hours, and the price of mistakes.</div>
          <div class="cmp-cell pro">A management fee, offset by better collections, vendor pricing, and fewer costly errors.</div>
        </div>
        <div class="cmp-row">
          <div class="cmp-aspect">Volunteer time</div>
          <div class="cmp-cell self">High — often concentrated on one or two burned-out board members.</div>
          <div class="cmp-cell pro">Low — the board sets direction; we run the day-to-day.</div>
        </div>
        <div class="cmp-row">
          <div class="cmp-aspect">Financial rigor</div>
          <div class="cmp-cell self">As strong as your volunteers' expertise and bandwidth allow.</div>
          <div class="cmp-cell pro">Professional accounting, reserves, and statements to every owner by the 20th.</div>
        </div>
        <div class="cmp-row">
          <div class="cmp-aspect">Enforcement</div>
          <div class="cmp-cell self">Awkward — you're policing your own neighbors.</div>
          <div class="cmp-cell pro">Consistent and neutral, applied the same way for everyone.</div>
        </div>
        <div class="cmp-row">
          <div class="cmp-aspect">Continuity</div>
          <div class="cmp-cell self">At risk when a key volunteer moves or steps down.</div>
          <div class="cmp-cell pro">A whole team — no single point of failure.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- RESPONSIBILITIES -->
  <section class="sig sig-alt">
    <div class="container">
      <div class="sig-head reveal">
        <div class="eyebrow eyebrow-blue">What a self-managed HOA actually has to do</div>
        <h2 class="sig-h">The job description nobody handed you at the election.</h2>
        <p class="sig-sub">A self-managed HOA doesn't have less to do than a managed one — <strong>it has the same to-do list, spread across volunteers.</strong> Here's the whole job, so your board can see which parts it's carrying well and which parts are quietly slipping.</p>
      </div>
      <div class="sig-grid">
        <div class="sig-card reveal"><div class="sig-n">01</div><h3 class="sig-t">Money</h3><p class="sig-d">Bill and collect assessments, pay vendors, reconcile the bank every month, keep the general ledger, file the tax return, and produce <a href="/resources/hoa-financial-statements">financial statements</a> owners can actually read.</p></div>
        <div class="sig-card reveal"><div class="sig-n">02</div><h3 class="sig-t">Budget &amp; reserves</h3><p class="sig-d">Build the <a href="/resources/hoa-budget-template">annual budget</a>, fund reserves per a current <a href="/resources/hoa-reserve-study">reserve study</a>, and keep the community clear of a surprise <a href="/resources/hoa-special-assessments">special assessment</a>.</p></div>
        <div class="sig-card reveal"><div class="sig-n">03</div><h3 class="sig-t">Insurance &amp; risk</h3><p class="sig-d">Renew the <a href="/resources/hoa-master-insurance-policy">master policy</a> at the right limits, track certificates from every vendor, and have the storm plan written before June 1.</p></div>
        <div class="sig-card reveal"><div class="sig-n">04</div><h3 class="sig-t">Covenants</h3><p class="sig-d">Inspect, notice, and hear violations consistently — the same way for everyone — and document it well enough that the association can defend a fine.</p></div>
        <div class="sig-card reveal"><div class="sig-n">05</div><h3 class="sig-t">Meetings &amp; records</h3><p class="sig-d">Notice meetings the way your documents and <a href="/resources/hoa-laws/louisiana">state law</a> require, keep minutes, run elections, and answer records requests on time.</p></div>
        <div class="sig-card reveal"><div class="sig-n">06</div><h3 class="sig-t">Vendors &amp; maintenance</h3><p class="sig-d">Bid the landscaping and pool contracts, chase the gate repair, take the after-hours emergency call, and keep the common areas from quietly deteriorating.</p></div>
      </div>
    </div>
  </section>

  <!-- INTERACTIVE: True cost of self-managing -->
  <section class="calc">
    <div class="container">
      <div class="calc-head reveal">
        <div class="eyebrow eyebrow-blue">Try it</div>
        <h2 class="calc-h">What is self-managing really costing you?</h2>
        <p class="calc-sub">Not in dollars — in the one resource volunteers can't get back. Slide in your community's reality and see the hours your board is carrying every year.</p>
      </div>
      <div class="calc-card reveal">
        <div class="calc-inputs">
          <div class="calc-field">
            <div class="calc-field-top"><span class="calc-label">Homes in your community</span><span class="calc-val" id="sm-homes-v">90</span></div>
            <input class="calc-range" type="range" id="sm-homes" min="10" max="400" step="5" value="90" aria-label="Homes in your community">
          </div>
          <div class="calc-field">
            <div class="calc-field-top"><span class="calc-label">Board hours spent per week</span><span class="calc-val" id="sm-hours-v">12 hrs</span></div>
            <input class="calc-range" type="range" id="sm-hours" min="1" max="30" step="1" value="12" aria-label="Board hours spent per week">
          </div>
        </div>
        <div class="calc-output">
          <div class="calc-out-label">Volunteer hours / year</div>
          <div class="calc-out-num" id="sm-result">0</div>
          <p class="calc-out-sub" id="sm-detail"></p>
        </div>
      </div>
      <p class="calc-foot reveal">A rough estimate to start a conversation, not a precise figure. The real question isn't the number — it's whether your volunteers should be carrying it.</p>
    </div>
  </section>

  <!-- MIDDLE PATH -->
  <section class="mid">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container mid-grid">
      <div class="reveal">
        <div class="eyebrow" style="color: rgba(255,255,255,.6);">You don't have to go all-in</div>
        <h2 class="mid-h">Keep running your community — <em>let us run the books.</em></h2>
        <p class="mid-p">
          Most boards think it's all-or-nothing. It isn't. Our <strong>Financial &amp;
          Administrative package</strong> handles the accounting, bookkeeping, budgeting, and
          reporting while your board keeps doing everything else.
        </p>
        <p class="mid-p">
          We built it on a simple belief: it isn't fair that only big communities get
          professional support.
        </p>
        <a class="mid-link" href="/hoa-financial-management">Explore financial-only management <span class="arrow">→</span></a>
      </div>
      <div class="reveal">
        <p class="mid-quote">"It's not fair to only give management services to big communities. <span class="g">Small boards deserve the same rigor.</span>"</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="container faq-grid">
      <div class="reveal">
        <div class="eyebrow eyebrow-blue">Common questions</div>
        <h2 class="faq-h">What boards ask before they decide.</h2>
      </div>
      <div class="faq-list reveal">
        <div class="faq-item">
          <button class="faq-q" type="button">Can an HOA be self-managed?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in">Yes. No state we serve requires a homeowners association to hire a management company, and plenty of small communities run themselves well. The obligations don't go away, though — <strong>the board still has to keep the books, hold the meetings, enforce the covenants, and carry the insurance.</strong> Self-management means the volunteers do all of it.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" type="button">How much does a self-managed HOA save?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in">The management fee — and that's the whole list. Everything else stays: insurance, landscaping, utilities, reserves, legal and accounting. <strong>What self-management adds back is volunteer hours and the cost of mistakes</strong> — a missed insurance renewal, an under-funded reserve, a fine the association can't defend. Run the calculator above and put an honest price on the hours.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" type="button">What is financial-only HOA management?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in">A middle path. A management company keeps the books — billing, collections, bank reconciliations, budget, reserve contribution, monthly statements, tax and audit support — while the board keeps running meetings, covenants, and vendors. It's what our <a href="/hoa-financial-management">HOA financial management</a> package does, and it's built for exactly the communities on this page.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" type="button">How do you transition from self-managed to a management company?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in">More simply than switching between companies, because there's no outgoing manager to negotiate with. The board votes, signs the agreement, and hands over the records it has — governing documents, bank statements, owner roster, vendor contracts, insurance policies. The new manager brings the books current, sets up billing, and notifies owners. The same <a href="/switching-hoa-management-companies">Day 1 to Day 90 plan</a> we use for boards switching companies applies, minus the part where we chase your old manager for records.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" type="button">When does a self-managed HOA need professional management?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in">When the work depends on one or two people, when the finances have outgrown a spreadsheet, or when enforcing the rules has started to cost friendships — the three signs at the top of this page. <strong>If your board recognizes one, the question isn't whether you've failed;</strong> it's whether the volunteers should still be carrying it.</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container cta-in">
      <div class="reveal">
        <h2 class="cta-h">Not sure which way to go?</h2>
        <p class="cta-p">Tell us about your community and we'll give you a straight answer — full management, financial-only, or "you're doing great, keep going." Within one business day.</p>
      </div>
      <div class="cta-actions reveal">
        <a class="btn btn-blue" href="/request-a-proposal">Talk it through <span class="arrow">→</span></a>
        <a class="cta-phone" href="tel:2255032648">Or call (225) 503-2648 · Mon–Fri, 8:30a–4:30p CT</a>
      </div>
    </div>
  </section>

  <script>
    (function () {
      // FAQ accordion (static markup — safe to wire directly)
      document.querySelectorAll('.faq-item').forEach(function (item) {
        var btn = item.querySelector('.faq-q');
        var ans = item.querySelector<HTMLElement>('.faq-a');
        if (!btn || !ans) return;
        var panel = ans;
        btn.addEventListener('click', function () {
          var open = item.classList.toggle('open');
          panel.style.maxHeight = open ? (panel.scrollHeight + 'px') : '0';
        });
      });

      var h = document.getElementById('sm-homes'), w = document.getElementById('sm-hours');
      var hv = document.getElementById('sm-homes-v'), wv = document.getElementById('sm-hours-v');
      var res = document.getElementById('sm-result'), det = document.getElementById('sm-detail');
      function calc() {
        var homes = +h.value, hrs = +w.value;
        hv.textContent = homes.toLocaleString('en-US');
        wv.textContent = hrs + ' hr' + (hrs === 1 ? '' : 's');
        var annual = hrs * 52;
        var weeks = annual / 40;
        res.textContent = annual.toLocaleString('en-US') + ' hrs';
        det.innerHTML = 'That’s about <strong>' + weeks.toFixed(1) + ' full work-weeks</strong> a year — usually falling on one or two people. We can carry that, so they can get back to living in the community they lead.';
      }
      [h, w].forEach(function (el) { el.addEventListener('input', calc); });
      calc();
    })();
  </script>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }

  .sol-hero { background: #fff; padding: 84px 0 70px; overflow: hidden; }
  .sol-hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 64px; align-items: center; }
  @media (max-width: 980px) { .sol-hero-grid { grid-template-columns: 1fr; gap: 40px; } }
  .sol-tag { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--freedom-blue); background: var(--fb-lightest); padding: 7px 14px; border-radius: 999px; }
  .sol-hero-display { font-family: var(--font-display); font-weight: 900; font-size: clamp(42px, 5.2vw, 76px); line-height: 1.0; letter-spacing: -.025em; color: var(--freedom-blue); margin: 20px 0 24px; text-wrap: balance; }
  .sol-hero-display .u { background: linear-gradient(transparent 80%, var(--landscaping-green) 80%); padding-bottom: .04em; }
  .sol-hero-lede { font-size: 17.5px; line-height: 1.7; color: var(--ink-500); max-width: 520px; margin: 0 0 30px; }
  .sol-hero-lede strong { color: var(--freedom-blue); font-weight: 600; }
  .sol-hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .sol-hero-media { position: relative; }
  .sol-hero-media .block { position: absolute; right: -26px; bottom: -26px; width: 66%; height: 54%; background: var(--landscaping-green); border-radius: 20px; z-index: 0; }
  .sol-hero-media :global(.image-slot) { position: relative; z-index: 1; width: 100%; height: 460px; }
  @media (max-width: 980px) { .sol-hero-media :global(.image-slot) { height: 380px; } }

  /* SIGNS */
  .sig { background: var(--nb-lightest); padding: 104px 0; }
  .sig-head { max-width: 720px; margin: 0 0 48px; }
  .sig-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
  .sig-sub { font-size: 16.5px; line-height: 1.7; color: var(--ink-500); margin: 0; }
  .sig-sub strong { color: var(--freedom-blue); font-weight: 600; }
  .sig-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media (max-width: 880px) { .sig-grid { grid-template-columns: 1fr; } }
  .sig-card { background: #fff; border-radius: 14px; padding: 30px 28px; box-shadow: var(--shadow-2); }
  .sig-n { font-family: var(--font-display); font-weight: 300; font-style: italic; font-size: 26px; color: var(--landscaping-green); }
  .sig-t { font-family: var(--font-display); font-weight: 700; font-size: 19px; color: var(--freedom-blue); margin: 8px 0 8px; }
  .sig-d { font-size: 14px; line-height: 1.65; color: var(--ink-500); margin: 0; }

  /* COMPARISON */
  .cmp { background: #fff; padding: 112px 0; }
  .cmp-head { max-width: 720px; margin: 0 0 48px; }
  .cmp-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
  .cmp-sub { font-size: 16.5px; line-height: 1.7; color: var(--ink-500); margin: 0; }
  .cmp-table { border-top: 2px solid var(--freedom-blue); }
  .cmp-row { display: grid; grid-template-columns: 1.1fr 1fr 1fr; gap: 24px; padding: 22px 0; border-bottom: 1.5px solid var(--hairline); align-items: start; }
  @media (max-width: 760px) { .cmp-row { grid-template-columns: 1fr; gap: 8px; } }
  .cmp-row.head { border-bottom: 1.5px solid var(--hairline-strong); }
  .cmp-aspect { font-family: var(--font-display); font-weight: 700; font-size: 16px; color: var(--freedom-blue); }
  .cmp-col-h { font-family: var(--font-body); font-weight: 700; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; }
  .cmp-col-self { color: var(--ink-400); }
  .cmp-col-pro { color: var(--landscaping-green); }
  .cmp-cell { font-size: 14.5px; line-height: 1.6; color: var(--ink-500); }
  .cmp-cell.pro { color: var(--ink-700); font-weight: 500; }
  @media (max-width: 760px) {
    .cmp-cell::before { font-weight: 700; color: var(--freedom-blue); font-size: 12px; letter-spacing: .04em; text-transform: uppercase; display: block; margin-bottom: 2px; }
    .cmp-cell.self::before { content: "Self-managed"; color: var(--ink-400); }
    .cmp-cell.pro::before { content: "With CMGT"; color: var(--landscaping-green); }
  }

  /* INTERACTIVE CALCULATOR */
  .calc { background: var(--nb-lightest); padding: 112px 0; }
  .calc-head { max-width: 720px; margin: 0 0 40px; }
  .calc-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
  .calc-sub { font-size: 16px; line-height: 1.7; color: var(--ink-500); margin: 0; max-width: 620px; }
  .calc-card { display: grid; grid-template-columns: 1fr .9fr; gap: 0; border-radius: 20px; overflow: hidden; box-shadow: var(--shadow-3); background: #fff; }
  @media (max-width: 820px) { .calc-card { grid-template-columns: 1fr; } }
  .calc-inputs { padding: 40px 40px 44px; }
  .calc-field { margin-bottom: 30px; }
  .calc-field:last-child { margin-bottom: 0; }
  .calc-field-top { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
  .calc-label { font-family: var(--font-display); font-weight: 700; font-size: 16px; color: var(--freedom-blue); }
  .calc-val { font-family: var(--font-display); font-weight: 700; font-size: 20px; color: var(--landscaping-green); white-space: nowrap; }
  .calc-range { -webkit-appearance: none; appearance: none; width: 100%; height: 6px; border-radius: 999px; background: var(--fb-lightest); outline: none; cursor: pointer; }
