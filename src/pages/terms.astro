---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'Terms of Service', url: SITE.url + '/terms' },
]);
---
<BaseLayout
  title="Terms of Service — CMGT"
  description="The terms of service governing use of the CMGT website — acceptable use, intellectual property, disclaimers, and limitations, in plain language."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"Terms of Service"}]'></nav>

  <section class="lg-hero">
    <div class="container lg-hero-in">
      <div class="lg-eyebrow">Legal</div>
      <h1 class="lg-h1">Terms of Service</h1>
      <p class="lg-intro">These terms govern your use of the CMGT website. By using the site, you agree to them. They are written to be clear, not to trip you up.</p>
    </div>
  </section>

  <section class="lg-body">
    <div class="container lg-wrap">
      <p class="lg-updated">Last updated: June 2026</p>
      <h2 class="lg-h2">Use of this site</h2><p class="lg-p">You may use this site for lawful, personal, and business purposes related to community management. You agree not to misuse the site, attempt to disrupt it, or use it to infringe on others’ rights.</p><h2 class="lg-h2">Not professional advice</h2><p class="lg-p">Content on this site — including guides and resources — is general information, not legal, financial, or professional advice. Always consult a qualified professional for your specific situation.</p><h2 class="lg-h2">Intellectual property</h2><p class="lg-p">The CMGT name, logo, content, and design are owned by CMGT and protected by applicable law. You may not reproduce them without permission.</p><h2 class="lg-h2">Third-party links</h2><p class="lg-p">Our site may link to third-party sites we don’t control. We’re not responsible for their content or practices.</p><h2 class="lg-h2">Limitation of liability</h2><p class="lg-p">The site is provided “as is.” To the extent permitted by law, CMGT is not liable for damages arising from your use of the site.</p><h2 class="lg-h2">Changes to these terms</h2><p class="lg-p">We may update these terms from time to time. Continued use of the site means you accept the current version, dated below.</p>
      <div class="lg-foot">
        Questions about this policy? Contact us <a href="/request-a-proposal">through our contact page</a>.
        <p class="lg-note">This document is a template provided for the site build and should be reviewed by legal counsel before publication.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  body { background: #fff; }
  .lg-hero { background: var(--nb-lightest); padding: 72px 0 56px; }
  .lg-hero-in { max-width: 760px; }
  .lg-eyebrow { font-family: var(--font-body); font-weight: 700; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--landscaping-green); }
  .lg-h1 { font-family: var(--font-display); font-weight: 900; font-size: clamp(34px, 4.4vw, 58px); line-height: 1.05; letter-spacing: -.025em; color: var(--freedom-blue); margin: 14px 0 18px; }
  .lg-intro { font-size: 17px; line-height: 1.7; color: var(--ink-700); margin: 0; max-width: 640px; }
  .lg-body { background: #fff; padding: 64px 0 96px; }
  .lg-wrap { max-width: 720px; }
  .lg-h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(21px, 2.4vw, 27px); line-height: 1.2; letter-spacing: -.01em; color: var(--freedom-blue); margin: 38px 0 12px; }
  .lg-p { font-size: 16px; line-height: 1.75; color: var(--ink-700); margin: 0; }
  .lg-updated { font-size: 13.5px; color: var(--ink-400); margin: 0 0 8px; }
  .lg-foot { border-top: 1px solid var(--hairline); margin-top: 48px; padding-top: 24px; font-size: 14px; line-height: 1.7; color: var(--ink-500); }
  .lg-foot a { color: var(--freedom-blue); font-weight: 600; text-decoration: none; }
  .lg-note { font-size: 12.5px; color: var(--ink-400); font-style: italic; margin-top: 14px; }
</style>
