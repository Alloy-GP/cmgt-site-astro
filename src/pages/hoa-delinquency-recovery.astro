---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';
import ImageSlot from '~/components/ImageSlot.astro';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'HOA Delinquency Recovery', url: SITE.url + '/hoa-delinquency-recovery' },
]);
---
<BaseLayout
  title="HOA Delinquency Recovery — Bring Collections Current — CMGT"
  description="HOA delinquency recovery from CMGT — a fair, consistent, done-for-you collections process that brings unpaid assessments current and keeps them there. Our communities average around 10% delinquency."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"HOA Delinquency Recovery"}]'></nav>

  <!-- HERO -->
  <section class="sol-hero">
    <div class="container sol-hero-grid">
      <div>
        <span class="sol-tag">Solutions</span>
        <h1 class="sol-hero-display">Delinquency recovery, <span class="u">without turning neighbor against neighbor.</span></h1>
        <p class="sol-hero-lede">
          Unpaid assessments drain the budget and fall on the owners who pay on time — and rising delinquency is one of the two most common reasons boards change managers.
          <strong>We bring your collections current and keep them there</strong>, with a fair, consistent process our communities average around 10% delinquency on.
        </p>
        <div class="sol-hero-ctas">
          <a class="btn btn-blue" href="/request-a-proposal">Request a proposal <span class="arrow">→</span></a>
          <a class="btn btn-outline-blue" href="/hoa-management-services">See full-service HOA management</a>
        </div>
      </div>
      <div class="sol-hero-media">
        <div class="block" aria-hidden="true"></div>
        <ImageSlot src="/photos/dq-hero-photo.webp" alt="A healthy, well-kept Gulf South neighborhood where dues stay current and common areas are cared for" shape="rounded" radius={20} />
      </div>
    </div>
  </section>

  <!-- WHAT IT COSTS -->
  <section class="trg">
    <div class="container">
      <div class="trg-head reveal">
        <div class="eyebrow eyebrow-blue">Why it's worth solving now</div>
        <h2 class="trg-h">Delinquency costs more than the unpaid balance.</h2>
        <p class="trg-sub">Left to grow, it quietly reshapes the whole community's finances — and its patience. Both problems are fixable with the right process.</p>
      </div>
      <div class="trg-grid">
        <div class="trg-card reveal">
          <h3 class="trg-t">It drains the budget</h3>
          <p class="trg-d">Every unpaid assessment is a hole in the budget that paying owners quietly cover. Let it grow and you get thinned reserves, deferred maintenance, and eventually a <strong>special assessment that punishes the responsible majority.</strong></p>
        </div>
        <div class="trg-card reveal">
          <h3 class="trg-t">It's a top reason boards switch</h3>
          <p class="trg-d">Rising delinquency sits right alongside poor communication as the most common reason boards fire their manager. <strong>A consistent process should keep it low</strong> — ours averages around 10%.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW WE SOLVE IT -->
  <section class="sec">
    <div class="container">
      <div class="sec-head reveal">
        <div class="eyebrow eyebrow-green">How we bring your collections current</div>
        <h2 class="sec-h">Consistency lowers delinquency. We make it automatic.</h2>
        <p class="sec-sub">Low delinquency comes from applying the same fair process to everyone, every cycle — not from harsher penalties. Here's what that looks like when we run it.</p>
      </div>
      <div class="feat-grid reveal">
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">One policy, applied to everyone</h3><p class="feat-p">We put a written collections policy in place and enforce it identically for every owner. Consistency is what lowers delinquency — and what keeps your board out of disputes.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">We make paying the easy option</h3><p class="feat-p">Online payments, autopay, clear statements, and reminders before the due date recover more than late fees ever will. Most delinquency is friction — we remove it before it escalates.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">Escalation, handled for you</h3><p class="feat-p">When an account goes past due we run a documented, predictable ladder — reminder through lien through counsel — so your board never has to make the awkward call to a neighbor.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">Compassion built in</h3><p class="feat-p">Owners facing genuine hardship are offered a structured payment plan within policy. We protect the budget and the relationship at the same time.</p></div>
      </div>
    </div>
  </section>

  <!-- RECOVERY LADDER -->
  <section class="sec sec-alt">
    <div class="container">
      <div class="sec-head reveal">
        <div class="eyebrow eyebrow-green">A predictable path</div>
        <h2 class="sec-h">The recovery ladder we run for you.</h2>
        <p class="sec-sub">Every account climbs the same rungs in the same order — handled by our team and documented at each step, so your board isn't chasing payments or making the hard calls.</p>
      </div>
      <div class="dq-ladder reveal">
        <div class="dq-rung"><div class="n">Rung 01</div><h3>Friendly reminder</h3><p>A nudge before or just after the due date — no fee. Most "delinquency" is friction, and a reminder clears it early.</p></div>
        <div class="dq-rung"><div class="n">Rung 02</div><h3>Late notice &amp; fee</h3><p>Only the fee your governing documents and state law allow, applied on the same day in the cycle for every owner.</p></div>
        <div class="dq-rung"><div class="n">Rung 03</div><h3>Formal demand</h3><p>A certified letter stating the balance, the deadline, and what happens next — documented for a clean record.</p></div>
        <div class="dq-rung"><div class="n">Rung 04</div><h3>Lien</h3><p>Recorded per state law to keep the association's claim ahead of the line — protection, not punishment.</p></div>
        <div class="dq-rung"><div class="n">Rung 05</div><h3>Legal referral</h3><p>A last resort handled by counsel, reserved for accounts that ignore every earlier rung.</p></div>
        <div class="dq-rung"><div class="n">Throughout</div><h3>Payment plans</h3><p>A structured plan within policy is available at any stage for owners in genuine hardship. Compassion and consistency aren't opposites.</p></div>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section class="sec">
    <div class="container">
      <div class="dq-stats reveal">
        <div class="dq-stat"><div class="num">~10%</div><div class="lab">average delinquency across CMGT communities</div></div>
        <div class="dq-stat"><div class="num">96%</div><div class="lab">client retention, by dollar value</div></div>
        <div class="dq-stat"><div class="num">By the 20th</div><div class="lab">full financials to every owner, every month</div></div>
      </div>
    </div>
  </section>

  <!-- HANDOFF -->
  <section class="ho">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container ho-in reveal">
      <div class="eyebrow" style="color: rgba(255,255,255,.6);">Who does the work</div>
      <p class="ho-q">The reminders, the late notices, the certified demands, the lien filings, the calls to counsel — <span class="g">we run all of it.</span> Your board approves the policy; we do the work.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec sec-alt">
    <div class="container">
      <div class="sec-head reveal">
        <div class="eyebrow eyebrow-green">Before you switch</div>
        <h2 class="sec-h">Questions boards ask about delinquency.</h2>
      </div>
      <div class="acc-list reveal">
        <div class="acc-item"><button class="acc-q" type="button">Will switching managers fix our delinquency?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">Not on its own — a consistent process does, and that's exactly what we bring. When you move to CMGT we carry open balances over cleanly rather than resetting them, and put the recovery ladder to work from day one. <a href="/switching-hoa-management-companies">See how the switch works.</a></div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">How low can delinquency realistically go?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">Around 10% is our portfolio average — and it's just that, an average, with many communities running lower. It comes from applying the same process every cycle, not from harsher penalties. We won't promise a specific number for your community, but the direction is consistently down.</div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">What about an owner in genuine hardship?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">They're offered a structured payment plan within policy. Treating people fairly and keeping the budget whole are not in conflict — that's the whole point of a documented process.</div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">Who actually does the work — us or the board?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">We do. Notices, fees, demands, liens, and coordination with counsel are run by our team and documented at every step. Your board sets and approves policy; we execute it — and it ties directly into <a href="/hoa-financial-management">financial management</a> and reserve health.</div></div></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container cta-in">
      <div class="reveal">
        <h2 class="cta-h">Delinquency climbing?</h2>
        <p class="cta-p">Tell us where your collections stand. We'll show you exactly how we'd bring them current — within two business days.</p>
      </div>
      <div class="cta-actions reveal">
        <a class="btn btn-blue" href="/request-a-proposal">Request a proposal <span class="arrow">→</span></a>
        <a class="cta-phone" href="tel:2255032648">Or call (225) 503-2648 · Mon–Thu 8:30a–4:30p · Fri 8:30a–4:00p CT</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }

  /* HERO — white solution treatment (matches other solutions pages) */
  .sol-hero { background: #fff; padding: 84px 0 70px; overflow: hidden; }
  .sol-hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 64px; align-items: center; }
  @media (max-width: 980px) { .sol-hero-grid { grid-template-columns: 1fr; gap: 40px; } }
  .sol-tag { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--freedom-blue); background: var(--fb-lightest); padding: 7px 14px; border-radius: 999px; }
  .sol-hero-display { font-family: var(--font-display); font-weight: 900; font-size: clamp(42px, 5.2vw, 76px); line-height: 1.0; letter-spacing: -.025em; color: var(--freedom-blue); margin: 20px 0 24px; text-wrap: balance; }
  .sol-hero-display .u { background: linear-gradient(transparent 80%, var(--landscaping-green) 80%); padding-bottom: .04em; }
  .sol-hero-lede { font-size: 17.5px; line-height: 1.7; color: var(--ink-500); max-width: 520px; margin: 0 0 30px; }
  .sol-hero-lede strong { color: var(--freedom-blue); font-weight: 600; }
  .sol-hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .sol-hero-media { position: relative; }
  .sol-hero-media .block { position: absolute; right: -26px; bottom: -26px; width: 66%; height: 54%; background: var(--landscaping-green); border-radius: 20px; z-index: 0; }
  .sol-hero-media :global(.image-slot) { position: relative; z-index: 1; width: 100%; height: 460px; }
  @media (max-width: 980px) { .sol-hero-media :global(.image-slot) { height: 380px; } }

  /* WHAT IT COSTS YOU — two-card problem framing */
  .trg { background: var(--nb-lightest); padding: 104px 0; }
  .trg-head { max-width: 720px; margin: 0 0 48px; }
  .trg-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
  .trg-sub { font-size: 16.5px; line-height: 1.7; color: var(--ink-500); margin: 0; }
  .trg-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media (max-width: 820px) { .trg-grid { grid-template-columns: 1fr; } }
  .trg-card { background: #fff; border-radius: 16px; padding: 38px 36px; box-shadow: var(--shadow-2); border-left: 4px solid var(--landscaping-green); }
  .trg-t { font-family: var(--font-display); font-weight: 700; font-size: 24px; line-height: 1.14; color: var(--freedom-blue); margin: 0 0 12px; }
  .trg-d { font-size: 15px; line-height: 1.7; color: var(--ink-500); margin: 0; }
  .trg-d strong { color: var(--freedom-blue); font-weight: 600; }

  /* RECOVERY LADDER */
  .dq-ladder { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 8px 0 0; }
  @media (max-width: 760px) { .dq-ladder { grid-template-columns: 1fr; } }
  .dq-rung { background: #fff; border: 1.5px solid var(--hairline-strong); border-radius: 14px; padding: 24px 26px; }
  .dq-rung .n { font-family: var(--font-display); font-weight: 700; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--landscaping-green); }
  .dq-rung h3 { font-family: var(--font-display); font-weight: 700; font-size: 18px; color: var(--freedom-blue); margin: 7px 0 8px; }
  .dq-rung p { font-size: 14.5px; line-height: 1.62; color: var(--ink-500); margin: 0; }

  /* PROOF STAT BAND */
  .dq-stats { background: var(--freedom-blue); border-radius: 20px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 40px 44px; }
  @media (max-width: 720px) { .dq-stats { grid-template-columns: 1fr; gap: 26px; } }
  .dq-stat .num { font-family: var(--font-display); font-weight: 700; font-size: 40px; line-height: 1; letter-spacing: -.02em; color: var(--landscaping-green); }
  .dq-stat .lab { font-size: 13.5px; line-height: 1.5; color: rgba(255,255,255,.72); margin-top: 10px; }

  /* HANDOFF reassurance */
  .ho { background: var(--freedom-blue); color: #fff; padding: 100px 0; position: relative; overflow: hidden; }
  .ho .leaf { position: absolute; right: -110px; top: -130px; width: 460px; height: 460px; opacity: .07; transform: rotate(-12deg); pointer-events: none; }
  .ho .leaf img { filter: brightness(0) invert(1); }
  .ho-in { position: relative; max-width: 880px; }
  .ho-q { font-family: var(--font-display); font-weight: 300; font-style: italic; font-size: clamp(26px, 3.4vw, 40px); line-height: 1.3; letter-spacing: -.01em; margin: 16px 0 0; text-wrap: balance; }
  .ho-q .g { color: var(--landscaping-green); font-style: normal; font-weight: 700; }

  /* CTA */
  .cta { background: var(--landscaping-green); color: var(--freedom-blue); padding: 100px 0; position: relative; overflow: hidden; }
  .cta .leaf { position: absolute; left: -110px; bottom: -150px; width: 460px; height: 460px; opacity: .14; transform: rotate(14deg); pointer-events: none; }
  .cta .leaf img { filter: brightness(0) saturate(100%) invert(11%) sepia(64%) saturate(4147%) hue-rotate(238deg) brightness(85%) contrast(96%); }
  .cta-in { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .cta-h { font-family: var(--font-display); font-weight: 900; font-size: clamp(34px, 4.6vw, 58px); line-height: 1.02; letter-spacing: -.02em; margin: 0 0 12px; text-wrap: balance; }
  .cta-p { font-size: 17px; line-height: 1.6; max-width: 500px; margin: 0; color: rgba(30,30,119,.82); }
  .cta-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .cta-phone { font-size: 14px; font-weight: 600; color: rgba(30,30,119,.75); text-decoration: none; }
</style>
