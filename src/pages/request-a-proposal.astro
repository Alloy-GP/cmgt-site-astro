---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';
import FormWidget from '~/components/proposal/FormWidget.jsx';

const breadcrumb = breadcrumbSchema([
  { name: 'Home',                url: SITE.url + '/' },
  { name: 'Request a Proposal',  url: SITE.url + '/request-a-proposal' },
]);
---
<BaseLayout
  title="Contact CMGT — Proposals, Questions & More"
  description="Request a proposal from CMGT. Tell us about your community and a real person reaches out within one business day — no pitch deck, no pressure."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"Contact"}]'></nav>

  <!-- HERO + FORM -->
  <section class="prop-hero ai-scope" data-screen-label="Request a Proposal">
    <div class="prop-hero-deco" aria-hidden="true">
      <div class="leaf"><img src="/assets/leaf-mark.svg" alt=""></div>
    </div>
    <div class="container prop-grid">
      <div class="prop-copy">
        <div class="eyebrow">Get in touch</div>
        <h1 class="prop-h1">One place to <span class="accent">reach us.</span></h1>
        <div class="prop-rule"></div>
        <p class="prop-lede">
          Proposal, question, or just hello — it all starts here. No pitch deck, no pressure.
          Tell us a little about your community and <strong>a real person will reach out
          within one business day.</strong>
        </p>

        <ol class="prop-steps">
          <li class="prop-step">
            <span class="prop-step-num">01</span>
            <div>
              <h3 class="prop-step-title">The right person sees it fast.</h3>
              <p class="prop-step-body">Your request routes straight to the team for your region the moment you hit send — no inbox black holes.</p>
            </div>
          </li>
          <li class="prop-step">
            <span class="prop-step-num">02</span>
            <div>
              <h3 class="prop-step-title">We talk. Mostly, we listen.</h3>
              <p class="prop-step-body">A conversation about your community — what's working, what's not, and what you wish were different.</p>
            </div>
          </li>
          <li class="prop-step">
            <span class="prop-step-num">03</span>
            <div>
              <h3 class="prop-step-title">You get a proposal built for your community.</h3>
              <p class="prop-step-body">Not a template. Scope, team, and pricing shaped around your community — and a clear plan for the transition.</p>
            </div>
          </li>
        </ol>

      </div>

      <div class="prop-form-col" id="intake-root">
        <FormWidget client:load clientName="CMGT" />
      </div>
    </div>

    <div class="container prop-bar-wrap">
      <div class="prop-bar">
        <div class="prop-bar-item">
          <span class="prop-bar-k">Call</span>
          <a class="prop-bar-v" href="tel:2255032648">(225) 503-2648</a>
          <span class="prop-bar-s">Mon–Fri, 8a–5p CT</span>
        </div>
        <div class="prop-bar-item">
          <span class="prop-bar-k">Markets</span>
          <span class="prop-bar-v" style="font-size:15px;line-height:1.4;">Louisiana · Mississippi · Alabama · Florida · Texas</span>
        </div>
        <div class="prop-bar-item">
          <span class="prop-bar-k">Headquarters</span>
          <span class="prop-bar-v" style="font-size:15px;line-height:1.4;">Denham Springs, LA</span>
          <span class="prop-bar-s">By appointment</span>
        </div>
      </div>
      <div class="prop-portal">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <span>Already with us? <a href="#">Log in to the portal</a> for payments, requests &amp; documents.</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Request a Proposal page ─────────────────────────────────── */
  body { background: var(--freedom-blue); }

  .prop-hero {
    position: relative;
    background: var(--freedom-blue);
    color: #fff;
    padding: 90px 0 110px;
    isolation: isolate;
    min-height: 100vh;
  }
  .prop-hero-deco { position: absolute; inset: 0; overflow: hidden; z-index: 0; pointer-events: none; }
  .prop-hero::after {
    content: "";
    position: absolute; inset: 0;
    background: radial-gradient(circle at 18% 20%, rgba(141,189,255,.12) 0%, transparent 55%);
    z-index: 0; pointer-events: none;
  }
  .prop-hero .leaf {
    position: absolute; left: -130px; bottom: -160px;
    width: 620px; height: 620px;
    opacity: .07; transform: none;
    z-index: 0; pointer-events: none;
  }
  .prop-hero .leaf img { width: 100%; height: 100%; filter: brightness(0) invert(1); }

  .prop-grid {
    position: relative; z-index: 2;
    display: grid; grid-template-columns: minmax(0, 1fr) 560px;
    gap: 72px; align-items: start;
  }
  @media (max-width: 1100px) { .prop-grid { grid-template-columns: 1fr; gap: 56px; } }

  .prop-copy .eyebrow { color: rgba(255,255,255,.7); }
  .prop-h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(44px, 5.2vw, 76px);
    line-height: .98; letter-spacing: -.025em;
    color: #fff;
    margin: 22px 0 0;
    text-wrap: balance;
  }
  .prop-h1 .accent { color: var(--landscaping-green); }
  .prop-rule { width: 88px; height: 5px; background: var(--landscaping-green); border-radius: 3px; margin: 32px 0 28px; }
  .prop-lede {
    font-size: 17.5px; line-height: 1.65;
    color: rgba(255,255,255,.8);
    max-width: 460px;
    margin: 0 0 48px;
  }
  .prop-lede strong { color: #fff; font-weight: 600; }

  .prop-steps { display: flex; flex-direction: column; gap: 26px; margin: 0 0 52px; padding: 0; list-style: none; }
  .prop-step { display: flex; gap: 18px; align-items: flex-start; max-width: 460px; }
  .prop-step-num {
    flex: none;
    font-family: var(--font-display); font-weight: 700; font-style: normal;
    font-size: 34px; line-height: 1;
    color: var(--landscaping-green);
    width: 44px;
  }
  .prop-step-title { font-family: var(--font-display); font-weight: 700; font-size: 19px; color: #fff; margin: 0 0 5px; }
  .prop-step-body { font-size: 14.5px; line-height: 1.6; color: rgba(255,255,255,.66); margin: 0; }

  .prop-form-col { min-width: 0; position: sticky; top: 40px; align-self: start; }
  .prop-form-col .ai-widget { width: 100%; }

  /* full-width contact bar spanning both columns */
  .prop-bar-wrap { position: relative; z-index: 2; margin-top: 56px; padding-top: 30px; border-top: 1px solid rgba(255,255,255,.16); }
  .prop-bar { display: grid; grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 720px) { .prop-bar { grid-template-columns: 1fr 1fr; gap: 26px 0; } }
  @media (max-width: 420px) { .prop-bar { grid-template-columns: 1fr; } }
  .prop-bar-item { padding: 0 28px; border-left: 1px solid rgba(255,255,255,.14); }
  .prop-bar-item:first-child { padding-left: 0; border-left: 0; }
  @media (max-width: 720px) { .prop-bar-item { padding: 0 0 0 24px; } .prop-bar-item:nth-child(odd) { padding-left: 0; border-left: 0; } }
  .prop-bar-k { display: block; font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--landscaping-green); margin-bottom: 9px; }
  .prop-bar-v { display: block; font-family: var(--font-display); font-weight: 700; font-size: 18px; line-height: 1.25; color: #fff; }
  a.prop-bar-v { text-decoration: none; transition: color var(--dur-base) var(--ease-out); }
  a.prop-bar-v:hover { color: var(--landscaping-green); }
  .prop-bar-s { display: block; font-size: 12.5px; line-height: 1.45; color: rgba(255,255,255,.55); margin-top: 5px; }
  .prop-portal { display: inline-flex; align-items: center; gap: 9px; margin-top: 26px; font-size: 13px; color: rgba(255,255,255,.6); }
  .prop-portal svg { flex: none; color: var(--neighborly-blue); }
  .prop-portal a { color: #fff; font-weight: 600; text-decoration: none; border-bottom: 1.5px solid var(--landscaping-green); padding-bottom: 1px; }
</style>
