<style>
  body { background:#fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity:.6; }
  .mp-sec { padding:80px 0 96px; }
  .mp-h { font-family:var(--font-display); font-weight:900; font-size:clamp(36px,4.6vw,64px); line-height:1.02; letter-spacing:-.03em; color:var(--freedom-blue); margin:14px 0 12px; }
  .mp-sub { font-size:16.5px; line-height:1.7; color:var(--ink-500); max-width:640px; margin:0 0 40px; }
  .mp-sub em { font-style:italic; color:var(--freedom-blue); }
  .mp-grid { display:grid; grid-template-columns:1.5fr .9fr; gap:48px; align-items:center; }
  @media (max-width:900px) { .mp-grid { grid-template-columns:1fr; gap:28px; } }
  .mp-mapwrap { background:#fff; border:1px solid var(--hairline); border-radius:20px; padding:28px; }
  .mp-svg { width:100%; height:auto; display:block; }
  .mp-base { fill:#EDEFF4; stroke:#fff; stroke-width:2; transition:fill .18s ease; cursor:pointer; }
  .mp-base:hover, .mp-base.on { fill:#DDE4F1; }
  .mp-tint { fill:#1E1E77; opacity:.14; }
  .mp-region { transition:opacity .18s ease; pointer-events:none; }
  .mp-region.on .mp-tint { opacity:.24; }
  .mp-rail { display:flex; flex-direction:column; gap:10px; }
  .mp-row { text-align:left; background:#fff; border:1.5px solid var(--hairline-strong); border-radius:12px; padding:13px 16px; cursor:pointer; transition:border-color .18s ease, transform .18s ease; font-family:inherit; }
  .mp-row:hover, .mp-row.on { border-color:var(--landscaping-green); transform:translateY(-1px); }
  .mp-row-top { display:flex; align-items:center; gap:9px; font-family:var(--font-display); font-weight:700; font-size:16px; color:var(--freedom-blue); }
  .mp-dot { width:9px;height:9px;border-radius:50%;background:var(--freedom-blue);flex-shrink:0; }
  .mp-hq { font-size:10px;font-weight:800;letter-spacing:.08em;background:var(--landscaping-green);color:var(--freedom-blue);padding:2px 7px;border-radius:100px; }
  .mp-row-note { display:block;margin-top:4px;font-size:13px;color:var(--ink-500); }
</style>
<script is:inline>
  (function() {
    function link(k,on){document.querySelectorAll('[data-state="'+k+'"]').forEach(function(el){el.classList.toggle('on',on);});}
    document.querySelectorAll('.mp-base, .mp-row').forEach(function(el){
      var k=el.getAttribute('data-state');
      el.addEventListener('mouseenter',function(){link(k,true);});
      el.addEventListener('mouseleave',function(){link(k,false);});
    });
  })();
</script>
