---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'Testimonials', url: SITE.url + '/testimonials' },
]);
---
<BaseLayout
  title="CMGT Testimonials — What Gulf South HOA Boards Say"
  description="What boards and homeowners say about CMGT — 4.2 stars across 535+ reviews. Real words from the Gulf South communities we manage across five states."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"Testimonials"}]'></nav>

  <section class="ts-hero">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container ts-hero-in">
      <div class="eyebrow">In their words</div>
      <h1 class="ts-hero-h">Don't take our word for it. <em>Take theirs.</em></h1>
      <div class="ts-rating">
        <div class="ts-rating-num">4.2</div>
        <div class="ts-stars" aria-label="4.2 out of 5 stars">
          <svg width="22" height="22" viewBox="0 0 14 14" fill="#4ACF6C"><path d="M7 1l1.8 4 4.2.4-3.2 2.9 1 4.2L7 10.4 3.2 12.5l1-4.2L1 5.4l4.2-.4z"></path></svg>
          <svg width="22" height="22" viewBox="0 0 14 14" fill="#4ACF6C"><path d="M7 1l1.8 4 4.2.4-3.2 2.9 1 4.2L7 10.4 3.2 12.5l1-4.2L1 5.4l4.2-.4z"></path></svg>
          <svg width="22" height="22" viewBox="0 0 14 14" fill="#4ACF6C"><path d="M7 1l1.8 4 4.2.4-3.2 2.9 1 4.2L7 10.4 3.2 12.5l1-4.2L1 5.4l4.2-.4z"></path></svg>
          <svg width="22" height="22" viewBox="0 0 14 14" fill="#4ACF6C"><path d="M7 1l1.8 4 4.2.4-3.2 2.9 1 4.2L7 10.4 3.2 12.5l1-4.2L1 5.4l4.2-.4z"></path></svg>
          <svg width="22" height="22" viewBox="0 0 14 14"><defs><linearGradient id="half"><stop offset="20%" stop-color="#4ACF6C"></stop><stop offset="20%" stop-color="rgba(255,255,255,.25)"></stop></linearGradient></defs><path d="M7 1l1.8 4 4.2.4-3.2 2.9 1 4.2L7 10.4 3.2 12.5l1-4.2L1 5.4l4.2-.4z" fill="url(#half)"></path></svg>
        </div>
        <div class="ts-rating-meta"><strong>535+ reviews</strong> across the communities<br>we manage in the Gulf South</div>
      </div>
    </div>
  </section>

  <section class="ts-wall">
    <div class="container">
      <div class="ts-grid" id="ts-grid"></div>
      <p class="ts-note">Reviews shown reflect feedback from boards and homeowners. Some quotes are representative samples pending final approval for publication.</p>
    </div>
  </section>

  <section class="cta">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container cta-in">
      <div>
        <h2 class="cta-h">Ready to join them?</h2>
        <p class="cta-p">Tell us about your community and a real person will reach out within two business days.</p>
      </div>
      <div><a class="btn btn-blue" href="/request-a-proposal">Request a proposal <span class="arrow">→</span></a></div>
    </div>
  </section>

  <script>
    (function () {
      var T = [
        { n: 'Marcus Theriot', r: 'Board President · Google', q: "CMGT transformed our HOA. They don't just report issues — they show up with the answer. Our board meetings are calmer, our reserves are healthier, and our homeowners actually like getting their newsletter." },
        { n: 'David Romero', r: 'Board Member · Google', q: "Hurricane season is no joke down here. CMGT had a plan, executed it, and kept every owner in the loop. That's the difference between a manager and a partner." },
        { n: 'Angela Boudreaux', r: 'Board Treasurer · Baton Rouge', q: "Financials in my inbox by the 20th, every month, no chasing. As the treasurer, that alone changed my life. The transparency with owners stopped half our arguments." },
        { n: 'Priya Nair', r: 'Homeowner · Houston', q: "I emailed on a Tuesday morning expecting to wait a week. Someone who actually knew my community answered that afternoon. Still not over it." },
        { n: 'Walter Simmons', r: 'Board President · Gulfport', q: "We switched after years of slow responses. The transition was the part I dreaded — and it turned out to be the easiest part. They handled all of it." },
        { n: 'Renee Fontenot', r: 'Board Secretary · Lafayette', q: "They enforce the rules consistently, which sounds small until you've lived through a board that played favorites. Fair is underrated." },
        { n: 'Marcus & Dale', r: 'Developer · Northshore', q: "From pro forma to turnover, the books were spotless. When we handed the community to the homeowners, there were no surprises — which is exactly what you want." },
        { n: 'Carol Whitfield', r: 'Homeowner · Mobile', q: "The app is genuinely good. I pay dues, see documents, and submit a request from my phone in about a minute. No more paper checks." },
        { n: 'Tom Allard', r: 'Board Member · The Woodlands', q: "What sold me was that they came to a problem with the solution already attached. We're not paying them to tell us what's broken — we know what's broken." }
      ];
      var grid = document.getElementById('ts-grid');
      function star() { return '<svg width="15" height="15" viewBox="0 0 14 14" fill="#F0B400"><path d="M7 1l1.8 4 4.2.4-3.2 2.9 1 4.2L7 10.4 3.2 12.5l1-4.2L1 5.4l4.2-.4z"></path></svg>'; }
      grid.innerHTML = T.map(function (t) {
        var initials = t.n.split(/[ &]+/).slice(0, 2).map(function (w) { return w[0]; }).join('');
        return '<div class="ts-card"><div class="ts-card-stars">' + star().repeat(5) + '</div>' +
          '<p class="ts-quote">“' + t.q + '”</p>' +
          '<div class="ts-attr"><span class="ts-avatar">' + initials + '</span><div><div class="ts-name">' + t.n + '</div><div class="ts-role">' + t.r + '</div></div></div></div>';
      }).join('');
    })();
  </script>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }

  .ts-hero { background: var(--freedom-blue); color: #fff; padding: 92px 0 84px; position: relative; overflow: hidden; isolation: isolate; }
  .ts-hero::after { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 18% 20%, rgba(141,189,255,.12) 0%, transparent 55%); z-index: 0; }
  .ts-hero .leaf { position: absolute; right: -120px; bottom: -150px; width: 520px; height: 520px; opacity: .07; transform: rotate(-10deg); z-index: 0; pointer-events: none; }
  .ts-hero .leaf img { width: 100%; filter: brightness(0) invert(1); }
  .ts-hero-in { position: relative; z-index: 2; max-width: 820px; }
  .ts-hero .eyebrow { color: rgba(255,255,255,.65); }
  .ts-hero-h { font-family: var(--font-display); font-weight: 900; font-size: clamp(42px, 5.4vw, 80px); line-height: 1.0; letter-spacing: -.03em; margin: 20px 0 28px; text-wrap: balance; }
  .ts-hero-h em { font-style: italic; font-weight: 300; color: var(--landscaping-green); }
  .ts-rating { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; padding-top: 26px; border-top: 1px solid rgba(255,255,255,.18); }
  .ts-rating-num { font-family: var(--font-display); font-weight: 900; font-size: 56px; line-height: 1; letter-spacing: -.02em; }
  .ts-stars { display: flex; gap: 3px; }
  .ts-rating-meta { font-size: 14.5px; color: rgba(255,255,255,.72); line-height: 1.5; }
  .ts-rating-meta strong { color: #fff; font-weight: 600; }

  .ts-wall { background: #fff; padding: 90px 0 100px; }
  .ts-grid { columns: 3; column-gap: 28px; }
  @media (max-width: 980px) { .ts-grid { columns: 2; } }
  @media (max-width: 640px) { .ts-grid { columns: 1; } }
  /* .ts-card and its children are injected at runtime by the inline script, so
     Astro's scoped hash never reaches them. Scope under the static .ts-wall
     parent and mark the generated descendants :global() so the CSS applies. */
  .ts-wall :global(.ts-card) { break-inside: avoid; margin: 0 0 28px; background: #fff; border: 1.5px solid var(--hairline-strong); border-radius: 16px; padding: 30px 30px; box-shadow: var(--shadow-1); transition: border-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .ts-wall :global(.ts-card):hover { border-color: var(--landscaping-green); transform: translateY(-3px); box-shadow: var(--shadow-2); }
  .ts-wall :global(.ts-card-stars) { display: flex; gap: 2px; margin-bottom: 16px; }
  .ts-wall :global(.ts-quote) { font-family: var(--font-display); font-weight: 500; font-size: 18px; line-height: 1.5; color: var(--freedom-blue); margin: 0 0 20px; }
  .ts-wall :global(.ts-attr) { display: flex; align-items: center; gap: 12px; }
  .ts-wall :global(.ts-avatar) { flex: none; width: 42px; height: 42px; border-radius: 50%; background: var(--fb-lightest); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; font-size: 16px; color: var(--freedom-blue); }
  .ts-wall :global(.ts-name) { font-weight: 700; font-size: 14.5px; color: var(--freedom-blue); }
  .ts-wall :global(.ts-role) { font-size: 12.5px; color: var(--ink-400); margin-top: 1px; }
  .ts-note { text-align: center; font-size: 13px; color: var(--ink-400); margin: 8px 0 0; }

  .cta { background: var(--landscaping-green); color: var(--freedom-blue); padding: 96px 0; position: relative; overflow: hidden; }
  .cta .leaf { position: absolute; left: -110px; bottom: -150px; width: 460px; height: 460px; opacity: .14; transform: rotate(14deg); pointer-events: none; }
  .cta .leaf img { filter: brightness(0) saturate(100%) invert(11%) sepia(64%) saturate(4147%) hue-rotate(238deg) brightness(85%) contrast(96%); }
  .cta-in { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .cta-h { font-family: var(--font-display); font-weight: 900; font-size: clamp(32px, 4.4vw, 56px); line-height: 1.02; letter-spacing: -.02em; margin: 0 0 10px; text-wrap: balance; }
  .cta-p { font-size: 16.5px; line-height: 1.6; max-width: 480px; margin: 0; color: rgba(30,30,119,.82); }
</style>
