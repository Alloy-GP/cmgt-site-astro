---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';
import ImageSlot from '~/components/ImageSlot.astro';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'Developer HOA Management', url: SITE.url + '/developer-hoa-management' },
]);
---
<BaseLayout
  title="Developer HOA Management, Groundbreaking to Turnover — CMGT"
  description="Developer HOA management from groundbreaking to homeowner turnover — flat $50/month pre-occupancy, funds through the HOA, multi-year pro forma."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"Developer HOA Management"}]'></nav>

  <!-- HERO -->
  <section class="ph-hero">
    <div class="container">
      <div class="ph-hero-top">
        <div>
          <div class="eyebrow">Developer HOA Management</div>
          <h1 class="ph-hero-display">From groundbreaking <em>to turnover.</em></h1>
        </div>
        <div>
          <p class="ph-hero-lede">
            Developer HOA management is a long game — and the decisions made on day one shape
            the community for decades. <strong>We're a lifecycle partner</strong> from the first
            pro forma through declarant control to a clean homeowner turnover.
          </p>
          <div class="ph-hero-ctas">
            <a class="btn btn-green" href="/request-a-proposal">Start the conversation <span class="arrow">→</span></a>
            <a class="btn btn-outline-light" href="/how-we-work">How we work</a>
          </div>
        </div>
      </div>
    </div>
    <div class="ph-hero-band">
      <ImageSlot src="/photos/dev-hero-photo.webp" alt="A Gulf South new-home development under construction — framed houses and graded lots in an emerging CMGT-managed community" shape="rect" />
    </div>
    <div class="container">
      <div class="ph-hero-stats">
        <div><div class="ph-stat-num">$50<span style="font-size:18px;">/mo</span></div><div class="ph-stat-label">flat fee until the first home is occupied</div></div>
        <div><div class="ph-stat-num">Day 1</div><div class="ph-stat-label">all funds flow through the HOA</div></div>
        <div><div class="ph-stat-num" data-count-to="5" data-duration="900">0</div><div class="ph-stat-label">states across the South</div></div>
        <div><div class="ph-stat-num" data-count-to="2007" data-plain data-duration="1700">0</div><div class="ph-stat-label">building communities since</div></div>
      </div>
    </div>
  </section>

  <!-- LIFECYCLE -->
  <section class="life">
    <div class="container">
      <div class="life-head reveal">
        <div class="eyebrow eyebrow-blue">The community lifecycle</div>
        <h2 class="life-h">One partner, from raw land to homeowner-run.</h2>
        <p class="life-sub">Developer-controlled community management isn't a single job — it's four phases, each with different risks. <strong>We structure all four from the start.</strong></p>
      </div>
      <div class="life-track">
        <div class="life-step reveal"><div class="life-phase">Phase 01</div><h3 class="life-t">Pro Forma &amp; Setup</h3><p class="life-d">A multi-year financial pro forma, governing documents, and budget architecture — built before the first slab is poured.</p></div>
        <div class="life-step reveal"><div class="life-phase">Phase 02</div><h3 class="life-t">Declarant Control</h3><p class="life-d">During construction, we run the association on your behalf — funds, vendors, and compliance — keeping the books clean from day one.</p></div>
        <div class="life-step reveal"><div class="life-phase">Phase 03</div><h3 class="life-t">Sales &amp; Buildout</h3><p class="life-d">As homes sell, we onboard owners, stand up communication, and protect the resident experience that sells the next phase.</p></div>
        <div class="life-step reveal"><div class="life-phase">Phase 04</div><h3 class="life-t">Homeowner Turnover</h3><p class="life-d">A transparent, well-documented handoff to the homeowner-led board — no surprises, no scramble, no deferred mess.</p></div>
      </div>
    </div>
  </section>

  <!-- PRINCIPLES -->
  <section class="pr">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container pr-in">
      <div class="eyebrow reveal" style="color: rgba(255,255,255,.6);">How we structure the deal</div>
      <h2 class="pr-h reveal">Built to protect the community — and your reputation in it.</h2>
      <div class="pr-grid">
        <div class="reveal">
          <div class="pr-big">$50<span style="font-size:24px;">/mo</span></div>
          <h3 class="pr-t">Flat fee, pre-occupancy</h3>
          <p class="pr-d">Until the first home is occupied, management is a flat $50/month. Your carrying costs stay predictable while the community is still dirt and framing.</p>
        </div>
        <div class="reveal">
          <div class="pr-big">100%</div>
          <h3 class="pr-t">Funds through the HOA</h3>
          <p class="pr-d">Every dollar flows through the association from day one — clean books, clear audit trail, and a turnover that survives scrutiny.</p>
        </div>
        <div class="reveal">
          <div class="pr-big">Multi-year</div>
          <h3 class="pr-t">Pro forma planning</h3>
          <p class="pr-d">We model assessments, reserves, and amenity costs across the full buildout, so the budget the homeowners inherit actually holds.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MARKET -->
  <section class="mkt">
    <div class="container mkt-grid">
      <div class="reveal">
        <div class="eyebrow eyebrow-blue">Where we partner with developers</div>
        <h2 class="mkt-h">Across our five-state footprint — including the Florida Panhandle.</h2>
        <p class="mkt-p">
          We partner with developers throughout our five-state footprint. <strong>That includes
          the Florida Panhandle — for developer-run communities</strong> — even though we don't
          take on Florida condominium regimes.
        </p>
        <p class="mkt-p">
          Wherever you're building, we license properly before we enter the market, so your
          community starts on solid legal footing.
        </p>
      </div>
      <div class="mkt-media reveal">
        <ImageSlot src="/photos/dev-mkt-photo.webp" alt="An aerial view of a Southern master-planned community with new streets, homes, and green common areas" shape="rounded" radius={20} />
      </div>
    </div>
  </section>

  <!-- INTERACTIVE: Turnover timeline visualizer -->
  <section class="viz">
    <div class="container">
      <div class="viz-head reveal">
        <div class="eyebrow eyebrow-blue">Scrub the timeline</div>
        <h2 class="viz-h">From dirt to homeowner-run — at a glance.</h2>
        <p class="viz-sub">Drag the slider (or tap a phase) to see what we're handling at each stage of the community's life — and who's in control.</p>
      </div>
      <div class="viz-card reveal">
        <div class="viz-track-wrap">
          <input class="viz-scrub" type="range" id="viz-scrub" min="0" max="3" step="1" value="0" aria-label="Community lifecycle phase">
          <div class="viz-ticks" id="viz-ticks"></div>
        </div>
        <div class="viz-panel">
          <div class="viz-left">
            <div class="viz-phase-n" id="viz-n">Phase 01</div>
            <h3 class="viz-phase-t" id="viz-t"></h3>
            <p class="viz-phase-d" id="viz-d"></p>
          </div>
          <div class="viz-right">
            <p class="viz-right-h">What we're handling</p>
            <ul class="viz-list" id="viz-list"></ul>
            <p class="viz-who" id="viz-who"></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PEER -->
  <section class="peers">
    <div class="container">
      <div class="peers-head reveal">
        <div class="eyebrow eyebrow-blue">After turnover</div>
        <h2 class="peers-h">The community's in good hands for the long haul.</h2>
        <p class="peers-sub">When control passes to the homeowners, the same team keeps managing — no disruptive re-bid, no new learning curve.</p>
      </div>
      <div class="peers-grid">
        <a class="peer-card reveal" href="/hoa-management-services">
          <h3 class="peer-t">HOA Management Services</h3>
          <p class="peer-d">Full-service management for the homeowner-led board after turnover.</p>
          <span class="peer-cta">Explore HOA management <span class="arrow">→</span></span>
        </a>
        <a class="peer-card reveal" href="/condo-management">
          <h3 class="peer-t">Condo & Townhome Management</h3>
          <p class="peer-d">Building a condo or townhome community? A dedicated practice for shared structures.</p>
          <span class="peer-cta">Explore condo management <span class="arrow">→</span></span>
        </a>
        <a class="peer-card reveal" href="/hoa-financial-management">
          <h3 class="peer-t">Financial &amp; Administrative Management</h3>
          <p class="peer-d">Financials and reporting with full transparency to every homeowner.</p>
          <span class="peer-cta">Explore the package <span class="arrow">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="container faq-grid">
      <div class="reveal">
        <div class="eyebrow eyebrow-blue">Common questions</div>
        <h2 class="faq-h">Before you ask.</h2>
      </div>
      <div class="faq-list reveal">
        <div class="faq-item">
          <button class="faq-q" type="button">What does management cost during construction?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in">A flat <strong>$50/month until the first home is occupied.</strong> It keeps your carrying costs predictable while the community is still being built, and scales into standard management as homes sell.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" type="button">Who controls the association's money before turnover?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in"><strong>All funds flow through the HOA from day one.</strong> That keeps the books clean and the eventual homeowner turnover transparent — no commingling, no surprises.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" type="button">Do you work with developers in Florida?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in">Yes — we manage <strong>developer-run communities in the Florida Panhandle.</strong> Note that's distinct from Florida condominium regimes, which we don't take on.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" type="button">What happens at homeowner turnover?<span class="faq-sign" aria-hidden="true"></span></button>
          <div class="faq-a"><div class="faq-a-in">We hand a well-documented, fully-funded association to the new homeowner-led board — and typically keep managing it, so there's <strong>no disruptive transition for residents.</strong></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container cta-in">
      <div class="reveal">
        <h2 class="cta-h">Building something? Let's structure it right.</h2>
        <p class="cta-p">Tell us about your development and we'll walk through the pro forma, the governance, and the path to turnover — within two business days.</p>
      </div>
      <div class="cta-actions reveal">
        <a class="btn btn-blue" href="/request-a-proposal">Start the conversation <span class="arrow">→</span></a>
        <a class="cta-phone" href="tel:2255032648">Or call (225) 503-2648 · Mon–Fri, 8:30a–4:30p CT</a>
      </div>
    </div>
  </section>

  <script>
    (function () {
      var P = [
        { tick: 'Pro Forma', n: 'Phase 01', t: 'Pro Forma & Setup', d: 'Before the first slab is poured, we build the financial architecture the whole community will stand on.', items: ['Multi-year financial pro forma', 'Governing documents & budget design', 'Reserve strategy from day one'], who: 'In control: <strong>the developer</strong>, with CMGT structuring the foundation.' },
        { tick: 'Declarant', n: 'Phase 02', t: 'Declarant Control', d: 'During construction we run the association on your behalf — clean books, clear compliance.', items: ['All funds flow through the HOA', 'Vendor setup & oversight', 'Flat $50/month until first occupancy'], who: 'In control: <strong>the developer</strong>, association managed by CMGT.' },
        { tick: 'Buildout', n: 'Phase 03', t: 'Sales & Buildout', d: 'As homes sell, we onboard owners and protect the homeowner experience that sells the next phase.', items: ['Homeowner onboarding', 'Communication & portal stand-up', 'Amenity & common-area management'], who: 'In control: <strong>shared</strong> — developer majority, homeowners joining in.' },
        { tick: 'Turnover', n: 'Phase 04', t: 'Homeowner Turnover', d: 'A transparent, well-documented handoff to the homeowner-led board — no surprises, no deferred mess.', items: ['Fully-funded, audit-ready handoff', 'Board training & orientation', 'CMGT typically stays on — no disruption'], who: 'In control: <strong>the homeowners</strong>, with the same team still managing.' }
      ];
      var scrub = document.getElementById('viz-scrub'), ticks = document.getElementById('viz-ticks');
      var n = document.getElementById('viz-n'), t = document.getElementById('viz-t'), d = document.getElementById('viz-d'), list = document.getElementById('viz-list'), who = document.getElementById('viz-who');
      ticks.innerHTML = P.map(function (p, i) { return '<button class="viz-tick" data-i="' + i + '">' + p.tick + '</button>'; }).join('');
      function render(i) {
        var p = P[i];
        n.textContent = p.n; t.textContent = p.t; d.textContent = p.d;
        list.innerHTML = p.items.map(function (x) { return '<li>' + x + '</li>'; }).join('');
        who.innerHTML = p.who;
        [].forEach.call(ticks.children, function (c, ci) { c.classList.toggle('on', ci === i); });
      }
      scrub.addEventListener('input', function () { render(+scrub.value); });
      [].forEach.call(ticks.children, function (b) { b.addEventListener('click', function () { scrub.value = b.dataset.i; render(+b.dataset.i); }); });
      render(0);
    })();
  </script>

  <script>
    (function () {
      document.querySelectorAll('.faq-item').forEach(function (item) {
        var btn = item.querySelector('.faq-q');
        var ans = item.querySelector('.faq-a');
        btn.addEventListener('click', function () {
          var open = item.classList.toggle('open');
          ans.style.maxHeight = open ? (ans.scrollHeight + 'px') : '0';
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }

  .ph-hero { background: var(--freedom-blue); color: #fff; padding: 96px 0 0; position: relative; overflow: hidden; isolation: isolate; }
  .ph-hero::after { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 16% 18%, rgba(141,189,255,.12) 0%, transparent 55%); z-index: 0; pointer-events: none; }
  .ph-hero-top { position: relative; z-index: 2; display: grid; grid-template-columns: 1.15fr .85fr; gap: 64px; align-items: end; padding-bottom: 64px; }
  @media (max-width: 980px) { .ph-hero-top { grid-template-columns: 1fr; gap: 32px; } }
  .ph-hero .eyebrow { color: rgba(255,255,255,.65); }
  .ph-hero-display { font-family: var(--font-display); font-weight: 900; font-size: clamp(42px, 5.2vw, 78px); line-height: 1.0; letter-spacing: -.03em; color: #fff; margin: 22px 0 0; text-wrap: balance; }
  .ph-hero-display em { font-style: italic; font-weight: 300; color: var(--landscaping-green); }
  .ph-hero-lede { font-size: 17.5px; line-height: 1.7; color: rgba(255,255,255,.82); margin: 0 0 30px; }
  .ph-hero-lede strong { color: #fff; font-weight: 600; }
  .ph-hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .ph-hero-band { position: relative; z-index: 2; }
  .ph-hero-band :global(.image-slot) { display: block; width: 100%; height: clamp(280px, 32vw, 420px); }
  .ph-hero-stats { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; padding: 30px 0; border-top: 1px solid rgba(255,255,255,.18); }
  @media (max-width: 620px) { .ph-hero-stats { grid-template-columns: 1fr 1fr; gap: 22px; } }
  .ph-stat-num { font-family: var(--font-display); font-weight: 700; font-size: 38px; line-height: 1; letter-spacing: -.02em; color: #fff; }
  .ph-stat-label { font-size: 12.5px; color: rgba(255,255,255,.6); margin-top: 7px; }

  /* LIFECYCLE */
  .life { background: #fff; padding: 112px 0; }
  .life-head { max-width: 760px; margin: 0 0 56px; }
  .life-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(30px, 3.8vw, 46px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
  .life-sub { font-size: 16.5px; line-height: 1.7; color: var(--ink-500); margin: 0; }
  .life-sub strong { color: var(--freedom-blue); font-weight: 600; }
  .life-track { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  @media (max-width: 920px) { .life-track { grid-template-columns: 1fr 1fr; gap: 32px 28px; } }
  @media (max-width: 540px) { .life-track { grid-template-columns: 1fr; } }
  .life-step { border-top: 3px solid var(--landscaping-green); padding-top: 22px; }
  .life-phase { font-family: var(--font-body); font-weight: 700; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-400); }
  .life-t { font-family: var(--font-display); font-weight: 700; font-size: 21px; line-height: 1.18; color: var(--freedom-blue); margin: 10px 0 10px; }
  .life-d { font-size: 14px; line-height: 1.65; color: var(--ink-500); margin: 0; }

  /* PRINCIPLES (pricing + funds + pro forma) */
  .pr { background: var(--freedom-blue); color: #fff; padding: 110px 0; position: relative; overflow: hidden; }
  .pr .leaf { position: absolute; right: -120px; bottom: -140px; width: 480px; height: 480px; opacity: .07; transform: rotate(-12deg); pointer-events: none; }
  .pr .leaf img { filter: brightness(0) invert(1); }
  .pr-in { position: relative; }
  .pr-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.14; letter-spacing: -.015em; color: #fff; max-width: 760px; margin: 16px 0 56px; text-wrap: balance; }
  .pr-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 44px; }
  @media (max-width: 820px) { .pr-grid { grid-template-columns: 1fr; gap: 38px; } }
  .pr-big { font-family: var(--font-display); font-weight: 700; font-size: 46px; line-height: 1; letter-spacing: -.02em; color: var(--landscaping-green); }
  .pr-t { font-family: var(--font-display); font-weight: 700; font-size: 20px; color: #fff; margin: 16px 0 10px; }
  .pr-d { font-size: 14.5px; line-height: 1.65; color: rgba(255,255,255,.72); margin: 0; }

  /* MARKET note */
  .mkt { background: var(--nb-lightest); padding: 100px 0; }
  .mkt-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  @media (max-width: 920px) { .mkt-grid { grid-template-columns: 1fr; gap: 32px; } }
  .mkt-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(26px, 3.2vw, 38px); line-height: 1.14; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 16px; text-wrap: balance; }
  .mkt-p { font-size: 16px; line-height: 1.75; color: var(--ink-500); margin: 0 0 16px; max-width: 540px; }
  .mkt-p strong { color: var(--freedom-blue); font-weight: 600; }
  .mkt-media :global(.image-slot) { width: 100%; height: 400px; }

  .peers { background: #fff; padding: 110px 0; }
  .peers-head { max-width: 680px; margin: 0 0 44px; }
  .peers-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
  .peers-sub { font-size: 16px; line-height: 1.7; color: var(--ink-500); margin: 0; }
  .peers-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media (max-width: 880px) { .peers-grid { grid-template-columns: 1fr; } }
  .peer-card { display: block; border: 1.5px solid var(--hairline-strong); border-radius: 16px; padding: 30px 28px; text-decoration: none; transition: border-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .peer-card:hover { border-color: var(--landscaping-green); transform: translateY(-3px); box-shadow: var(--shadow-2); }
  .peer-t { font-family: var(--font-display); font-weight: 700; font-size: 21px; color: var(--freedom-blue); margin: 0 0 8px; }
  .peer-d { font-size: 14px; line-height: 1.6; color: var(--ink-500); margin: 0 0 16px; }
  .peer-cta { display: inline-flex; align-items: center; gap: 7px; font-weight: 600; font-size: 14px; color: var(--freedom-blue); }
  .peer-cta .arrow { color: var(--landscaping-green); transition: transform var(--dur-base) var(--ease-out); }
  .peer-card:hover .peer-cta .arrow { transform: translateX(4px); }

  .faq { background: var(--nb-lightest); padding: 110px 0; }
  .faq-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 56px; align-items: start; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; gap: 24px; } }
  .faq-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.1; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 0; text-wrap: balance; }
  .faq-list { border-top: 1.5px solid var(--hairline-strong); }
  .faq-item { border-bottom: 1.5px solid var(--hairline-strong); }
  .faq-q { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 20px; background: transparent; border: 0; cursor: pointer; text-align: left; padding: 24px 2px; font-family: var(--font-display); font-weight: 700; font-size: 19px; color: var(--freedom-blue); }
  .faq-sign { flex: none; width: 26px; height: 26px; position: relative; }
  .faq-sign::before, .faq-sign::after { content: ""; position: absolute; background: var(--landscaping-green); border-radius: 2px; transition: transform var(--dur-base) var(--ease-out); }
  .faq-sign::before { left: 0; right: 0; top: 12px; height: 2.5px; }
  .faq-sign::after { top: 0; bottom: 0; left: 12px; width: 2.5px; }
  .faq-item.open .faq-sign::after { transform: scaleY(0); }
  .faq-a { max-height: 0; overflow: hidden; transition: max-height var(--dur-base) var(--ease-out); }
  .faq-a-in { font-size: 15.5px; line-height: 1.7; color: var(--ink-500); padding: 0 2px 24px; max-width: 640px; }
  .faq-a-in strong { color: var(--freedom-blue); font-weight: 600; }

  .cta { background: var(--landscaping-green); color: var(--freedom-blue); padding: 100px 0; position: relative; overflow: hidden; }
  .cta .leaf { position: absolute; left: -110px; bottom: -150px; width: 460px; height: 460px; opacity: .14; transform: rotate(14deg); pointer-events: none; }
  .cta .leaf img { filter: brightness(0) saturate(100%) invert(11%) sepia(64%) saturate(4147%) hue-rotate(238deg) brightness(85%) contrast(96%); }
  .cta-in { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
