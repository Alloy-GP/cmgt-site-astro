---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';
import ImageSlot from '~/components/ImageSlot.astro';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'Florida', url: SITE.url + '/hoa-management/florida' },
]);
---
<BaseLayout
  title="Florida Panhandle HOA Management — Full-Service for Non-Condo Communities — CMGT"
  description="Full-service HOA management on the Florida Panhandle for non-condo communities — including On-Site management for large master-planned communities. Backed by nearly 400 communities of experience; financials shared with every homeowner by the 20th."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"Florida"}]'></nav>

  <section class="geo-hero">
    <div class="container">
      <div class="geo-hero-top">
        <div>
          <div class="eyebrow">Florida HOA Management</div>
          <h1 class="geo-hero-h">Florida HOA management, <em>the full-service kind.</em></h1>
        </div>
        <div>
          <p class="geo-hero-lede">CMGT manages Florida Panhandle communities the way we do everywhere — full-service, with the finances shared openly with every homeowner. We’re new to Florida, and every community here gets the full specialist bench from day one.</p>
          <div class="geo-hero-ctas">
            <a class="btn btn-green" href="/request-a-proposal">Request a proposal <span class="arrow">→</span></a>
            <a class="btn btn-outline-light" href="/hoa-management-services">Our HOA services</a>
          </div>
        </div>
      </div>
    </div>
    <div class="geo-band">
      <ImageSlot src="/photos/fl-geo-hero-photo.webp" alt="A Florida Panhandle master-planned community near Pensacola with single-family homes and lush coastal landscaping" shape="rect" />
    </div>
    <div class="container">
      <div class="geo-stats">
        <div><div class="geo-stat-num">Est. 2007</div><div class="geo-stat-label">managing HOAs across five states — now in Florida</div></div>
        <div><div class="geo-stat-num">96%</div><div class="geo-stat-label">client retention</div></div>
        <div><div class="geo-stat-num">Full-service</div><div class="geo-stat-label">HOA management, including On-Site for large communities</div></div>
      </div>
    </div>
  </section>

  <section class="geo-intro">
    <div class="container geo-intro-grid">
      <p class="geo-intro-label reveal">New here. Not new at this.</p>
      <div class="reveal">
        <p class="geo-intro-p">On the Florida Panhandle, CMGT provides full HOA management for non-condo communities — single-family HOAs and master-planned communities, including On-Site management for the large ones. It’s the same team-based model and radical financial transparency our communities have trusted for years, brought to Florida.</p>
        <p class="geo-intro-p">We’ve grown the same way from the start — <strong>community by community, through referrals and reputation.</strong> No acquisitions, no private-equity money, no outside investors. Just service worth recommending.</p>
      </div>
    </div>
  </section>

  <section class="geo-cities">
    <div class="container">
      <div class="eyebrow eyebrow-blue reveal">Where we’re expanding in Florida</div>
      <h2 class="geo-cities-h reveal">Early on the Florida Panhandle.</h2>
      <p class="geo-cities-sub reveal">We re-entered the Florida Panhandle in late 2025 — a two-community start, with room to take on more non-condo communities across the region.</p>
      <div class="geo-chips reveal"><a class="geo-chip" href="#">Pensacola</a><a class="geo-chip" href="#">Panama City</a></div>
    </div>
  </section>

  <section class="geo-why">
    <div class="container geo-why-grid">
      <div class="reveal">
        <div class="eyebrow eyebrow-blue">Why Florida boards choose CMGT</div>
        <h2 class="geo-why-h">Big enough to protect you. Close enough to know you.</h2>
        <p class="geo-why-p">You’re early with us in Florida — but you’re not a test case. You get the full specialist bench and a management model proven across five states, plus the discipline we bring to every new market: proper licensing and local knowledge before we take on a community, so your board isn’t the one catching the details.</p>
        <ul class="geo-svc">
          <li><a href="/hoa-management-services">Full-service HOA management</a></li>
          <li><a href="/on-site-management">On-Site management for large communities</a></li>
          <li><a href="/hoa-financial-management">Financial &amp; Administrative Management</a></li>
          <li><a href="/developer-hoa-management">Developer &amp; new-community services</a></li>
        </ul>
      </div>
      <div class="geo-why-media reveal">
        <ImageSlot src="/photos/fl-geo-why-photo.webp" alt="A CMGT on-site manager meeting with Florida Panhandle homeowners outside a community clubhouse" shape="rounded" radius={20} />
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="sec-head reveal">
        <div class="eyebrow eyebrow-green">What a Florida board hands off</div>
        <h2 class="sec-h">Everything that used to land on a volunteer’s kitchen table.</h2>
        <p class="sec-sub">A dedicated Community Association Manager owns the relationship — backed by in-house specialists so nothing falls through the cracks between meetings.</p>
      </div>
      <div class="feat-grid reveal">
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">Finances &amp; reporting</h3><p class="feat-p">Full P&amp;L and balance sheet to the entire membership by the 20th of every month — it’s written into our management agreement, not promised verbally.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">Dues &amp; collections</h3><p class="feat-p">A consistent, compassionate billing process keeps our communities at roughly 10% delinquency — without souring neighbor relationships.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">Covenants &amp; ARC</h3><p class="feat-p">Fair, documented enforcement and architectural review that follows Florida’s community-association statutes — we educate before the first violation rather than leading with a fine.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">Vendors &amp; maintenance</h3><p class="feat-p">Bidding, oversight, and site visits so common areas stay in the shape your homeowners expect — and so the board isn’t chasing contractors.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">Homeowner communication</h3><p class="feat-p">Plain-language answers you can actually get, a board portal, and an app — 70% of our owners use the portal and over half pay online.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">On-Site management</h3><p class="feat-p">For large master-planned communities, we place a dedicated on-site team — the full-service model our biggest communities rely on, run from inside your neighborhood.</p></div>
      </div>
    </div>
  </section>

  <section class="proof-band">
    <div class="container proof-in">
      <h2 class="proof-h">A manager who knows your name — with a <em>full team</em> behind every answer.</h2>
      <div class="proof-grid reveal">
        <div><div class="proof-num"><span data-prefix="Nearly " data-count-to="400">Nearly 400</span></div><div class="proof-label">communities across five states</div></div>
        <div><div class="proof-num"><span data-count-to="96" data-suffix="%">96%</span></div><div class="proof-label">client retention, by dollar value</div></div>
        <div><div class="proof-num"><span data-prefix="~" data-count-to="10" data-suffix="%">~10%</span></div><div class="proof-label">average delinquency across our communities</div></div>
        <div><div class="proof-num">Responsive</div><div class="proof-label">real answers and steady follow-through</div></div>
      </div>
    </div>
  </section>

  <section class="sec sec-alt">
    <div class="container">
      <div class="sec-head reveal">
        <div class="eyebrow eyebrow-green">Built for Florida</div>
        <h2 class="sec-h">Full-service management on the Florida Panhandle.</h2>
      </div>
      <div class="prose reveal">
        <p>On the Florida Panhandle we provide <strong>full HOA management for established, non-condo communities</strong> — a dedicated manager backed by the specialist departments behind every CMGT community — plus On-Site teams for large master-planned communities.</p>
        <p>Here’s the one thing we don’t take on in Florida: <strong>condominium regimes.</strong> Florida condo law is its own regulatory discipline, and we’d rather be straight with you than stretch into something we can’t do to our standard. Large master-planned and high-rise communities are a different matter — those we serve through On-Site management.</p>
        <p>We’re honest about being new here: we re-entered the Florida Panhandle in late 2025 with a small footprint. But a Florida community isn’t a test case — from day one you get the full specialist bench and a management model proven across five states. See <a href="/hoa-management-services">how full-service management works</a>, or <a href="/on-site-management">on-site management for large communities</a>.</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="sec-head reveal">
        <div class="eyebrow eyebrow-green">Questions Florida boards ask</div>
        <h2 class="sec-h">Straight answers, no industry-speak.</h2>
      </div>
      <div class="acc-list reveal">
        <div class="acc-item"><button class="acc-q" type="button">What does CMGT manage in Florida?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">On the Florida Panhandle we provide <strong>full HOA management for non-condo communities</strong> — single-family HOAs and master-planned communities — including On-Site management for large communities. It’s the complete CMGT model our communities rely on across five states.</div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">Do you manage condos in Florida?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">Condominium regimes are the one thing we don’t take on in Florida — Florida condo law is a regulatory discipline of its own, and we’d rather be straight with you than stretch into something we can’t do to our standard. <strong>Large master-planned and high-rise communities are different</strong> — those we serve through <a href="/on-site-management">On-Site management</a>.</div></div></div>
        {/* PENDING: Florida CAM-licensing claim awaiting Jeff's confirmation of licensed-manager status. Do not publish this answer until confirmed. */}
        <div class="acc-item"><button class="acc-q" type="button">Are you licensed to manage HOAs in Florida?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">Yes — CMGT is a Florida CAM-licensed management company, and we require proper state licensing before we operate in any market. It’s a standard we hold everywhere, not a box we check after the fact.</div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">How established is CMGT in Florida?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">We’re newest here — a small Panhandle footprint, re-entered in late 2025 — so we won’t pretend to have decades of Florida history. What every Florida community gets from day one is the <strong>full specialist bench and a management model proven across five states.</strong> You’re early with us, but you’re not a test case.</div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">When do we see our financials?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in"><strong>By the 20th of every month</strong>, and we share the full P&amp;L and balance sheet with the entire membership — not just the board. That radical transparency is the core of how we work, and it travels to every market we serve.</div></div></div>
      </div>
    </div>
  </section>

  <section class="sec sec-alt">
    <div class="container">
      <div class="sec-head reveal">
        <div class="eyebrow eyebrow-green">Keep reading</div>
        <h2 class="sec-h">Resources for Florida boards.</h2>
      </div>
      <div class="rel-grid reveal">
        <a class="rel-card" href="/on-site-management"><div class="rel-kicker">Service</div><h3 class="rel-h">On-Site management</h3><p class="rel-p">A dedicated on-site team for large master-planned and high-rise communities — the full-service model, run from inside your neighborhood.</p><span class="rel-go">See on-site <span class="arrow">→</span></span></a>
        <a class="rel-card" href="/switching-hoa-management-companies"><div class="rel-kicker">Guide</div><h3 class="rel-h">Switching management companies</h3><p class="rel-p">The 90-day transition plan that moves records, vendors, and finances without the trauma.</p><span class="rel-go">See the timeline <span class="arrow">→</span></span></a>
        <a class="rel-card" href="/hoa-financial-management"><div class="rel-kicker">Service</div><h3 class="rel-h">Financial &amp; Administrative Management</h3><p class="rel-p">Professional books, transparent reporting, and lower delinquency for smaller communities.</p><span class="rel-go">See the package <span class="arrow">→</span></span></a>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container cta-in">
      <div class="reveal">
        <h2 class="cta-h">Managing a community in Florida?</h2>
        <p class="cta-p">Tell us about it and a real person will reach out within two business days. No pitch deck, no pressure.</p>
      </div>
      <div class="cta-actions reveal">
        <a class="btn btn-blue" href="/request-a-proposal">Request a proposal <span class="arrow">→</span></a>
        <a class="cta-phone" href="tel:2255032648">Or call (225) 503-2648 · Mon–Thu 8:30a–4:30p · Fri 8:30a–4:00p CT</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }
  .geo-hero { background: var(--freedom-blue); color: #fff; padding: 92px 0 0; position: relative; overflow: hidden; isolation: isolate; }
  .geo-hero::after { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 16% 18%, rgba(141,189,255,.12) 0%, transparent 55%); z-index: 0; pointer-events: none; }
  .geo-hero-top { position: relative; z-index: 2; display: grid; grid-template-columns: 1.15fr .85fr; gap: 64px; align-items: end; padding-bottom: 60px; }
  @media (max-width: 980px) { .geo-hero-top { grid-template-columns: 1fr; gap: 30px; } }
  .geo-hero .eyebrow { color: rgba(255,255,255,.65); }
  .geo-hero-h { font-family: var(--font-display); font-weight: 900; font-size: clamp(42px, 5.4vw, 80px); line-height: 1.0; letter-spacing: -.03em; margin: 20px 0 0; text-wrap: balance; }
  .geo-hero-h em { font-style: italic; font-weight: 300; color: var(--landscaping-green); }
  .geo-hero-lede { font-size: 17.5px; line-height: 1.7; color: rgba(255,255,255,.82); margin: 0 0 30px; }
  .geo-hero-lede strong { color: #fff; font-weight: 600; }
  .geo-hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .geo-band :global(.image-slot) { display: block; width: 100%; height: clamp(280px, 32vw, 400px); position: relative; z-index: 2; }
  .geo-stats { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; padding: 30px 0; border-top: 1px solid rgba(255,255,255,.18); }
  @media (max-width: 620px) { .geo-stats { grid-template-columns: 1fr; gap: 18px; } }
  .geo-stat-num { font-family: var(--font-display); font-weight: 700; font-size: 38px; line-height: 1; letter-spacing: -.02em; color: #fff; }
  .geo-stat-label { font-size: 12.5px; color: rgba(255,255,255,.6); margin-top: 7px; }

  .geo-intro { background: #fff; padding: 104px 0; }
  .geo-intro-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 64px; align-items: start; }
  @media (max-width: 860px) { .geo-intro-grid { grid-template-columns: 1fr; gap: 22px; } }
  .geo-intro-label { font-family: var(--font-display); font-weight: 300; font-style: italic; font-size: clamp(24px, 2.8vw, 34px); color: var(--landscaping-green); line-height: 1.15; }
  .geo-intro-p { font-size: 17px; line-height: 1.75; color: var(--ink-700); margin: 0 0 18px; }
  .geo-intro-p:last-child { margin-bottom: 0; }
  .geo-intro-p strong { color: var(--freedom-blue); font-weight: 600; }

  .geo-cities { background: var(--nb-lightest); padding: 100px 0; }
  .geo-cities-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
  .geo-cities-sub { font-size: 16px; line-height: 1.7; color: var(--ink-500); margin: 0 0 36px; max-width: 600px; }
  .geo-chips { display: flex; flex-wrap: wrap; gap: 12px; }
  .geo-chip { font-family: var(--font-display); font-weight: 700; font-size: 17px; color: var(--freedom-blue); background: #fff; border: 1.5px solid var(--hairline-strong); border-radius: 999px; padding: 12px 22px; text-decoration: none; transition: border-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .geo-chip:hover { border-color: var(--landscaping-green); transform: translateY(-2px); }

  .geo-why { background: #fff; padding: 104px 0; }
  .geo-why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  @media (max-width: 920px) { .geo-why-grid { grid-template-columns: 1fr; gap: 32px; } }
  .geo-why-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(26px, 3.2vw, 40px); line-height: 1.14; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 16px; text-wrap: balance; }
  .geo-why-p { font-size: 16px; line-height: 1.75; color: var(--ink-500); margin: 0 0 16px; max-width: 540px; }
  .geo-why-p strong { color: var(--freedom-blue); font-weight: 600; }
  .geo-why-media :global(.image-slot) { width: 100%; height: 400px; }
  .geo-svc { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .geo-svc li { font-size: 15px; color: var(--ink-700); padding-left: 26px; position: relative; }
  .geo-svc li::before { content: ""; position: absolute; left: 0; top: 7px; width: 9px; height: 9px; border-radius: 50%; background: var(--landscaping-green); }
  .geo-svc a { color: var(--freedom-blue); font-weight: 600; text-decoration: none; border-bottom: 2px solid transparent; transition: border-color var(--dur-base) var(--ease-out); }
  .geo-svc a:hover { border-bottom-color: var(--landscaping-green); }

  .cta { background: var(--landscaping-green); color: var(--freedom-blue); padding: 100px 0; position: relative; overflow: hidden; }
  .cta .leaf { position: absolute; left: -110px; bottom: -150px; width: 460px; height: 460px; opacity: .14; transform: rotate(14deg); pointer-events: none; }
  .cta .leaf img { filter: brightness(0) saturate(100%) invert(11%) sepia(64%) saturate(4147%) hue-rotate(238deg) brightness(85%) contrast(96%); }
  .cta-in { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .cta-h { font-family: var(--font-display); font-weight: 900; font-size: clamp(32px, 4.4vw, 56px); line-height: 1.02; letter-spacing: -.02em; margin: 0 0 10px; text-wrap: balance; }
  .cta-p { font-size: 16.5px; line-height: 1.6; max-width: 480px; margin: 0; color: rgba(30,30,119,.82); }
  .cta-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .cta-phone { font-size: 14px; font-weight: 600; color: rgba(30,30,119,.75); text-decoration: none; }
</style>
