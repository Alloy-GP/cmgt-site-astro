---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';
import ImageSlot from '~/components/ImageSlot.astro';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'Louisiana', url: SITE.url + '/hoa-management/louisiana' },
]);
---
<BaseLayout
  title="Louisiana HOA Management — Rooted Here Since 2007 — CMGT"
  description="Louisiana HOA management from a team that started here — 300+ communities across Baton Rouge, New Orleans, Lafayette and beyond. Local roots, statewide."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"Louisiana"}]'></nav>

  <section class="geo-hero">
    <div class="container">
      <div class="geo-hero-top">
        <div>
          <div class="eyebrow">Louisiana HOA Management</div>
          <h1 class="geo-hero-h">Louisiana HOA management, <em>rooted right here.</em></h1>
        </div>
        <div>
          <p class="geo-hero-lede">CMGT started with one community in Denham Springs in 2007. Today we’re the largest HOA management company in the state — still independently owned, still answering the phone.</p>
          <div class="geo-hero-ctas">
            <a class="btn btn-green" href="/request-a-proposal">Request a proposal <span class="arrow">→</span></a>
            <a class="btn btn-outline-light" href="/hoa-management-services">Our HOA services</a>
          </div>
        </div>
      </div>
    </div>
    <div class="geo-band">
      <ImageSlot src="/photos/la-geo-hero-photo.webp" alt="An established Louisiana residential community near Baton Rouge with mature oaks, well-kept homes, and manicured common areas under a bright Gulf South sky" shape="rect" />
    </div>
    <div class="container">
      <div class="geo-stats">
        <div><div class="geo-stat-num">300+</div><div class="geo-stat-label">Louisiana communities</div></div>
        <div><div class="geo-stat-num">96%</div><div class="geo-stat-label">client retention</div></div>
        <div><div class="geo-stat-num">HQ</div><div class="geo-stat-label">headquartered in Denham Springs</div></div>
      </div>
    </div>
  </section>

  <section class="geo-intro">
    <div class="container geo-intro-grid">
      <p class="geo-intro-label reveal">Local roots, real reach.</p>
      <div class="reveal">
        <p class="geo-intro-p">From the Northshore to Acadiana to the capital region, we manage communities of every size across Louisiana — and our headquarters is right here in Denham Springs.</p>
        <p class="geo-intro-p">We grew across the Gulf South the same way we grew at home — <strong>community by community, through referrals and reputation.</strong> No acquisitions, no private-equity money, no outside investors. Just service worth recommending.</p>
      </div>
    </div>
  </section>

  <section class="geo-cities">
    <div class="container">
      <div class="eyebrow eyebrow-blue reveal">Where we work in Louisiana</div>
      <h2 class="geo-cities-h reveal">Communities across the state.</h2>
      <p class="geo-cities-sub reveal">A snapshot of the Louisiana markets our teams serve — and we’re always growing.</p>
      <div class="geo-chips reveal"><a class="geo-chip" href="/hoa-management/louisiana/baton-rouge">Baton Rouge</a><a class="geo-chip" href="#">Denham Springs</a><a class="geo-chip" href="#">New Orleans</a><a class="geo-chip" href="/hoa-management/louisiana/lafayette">Lafayette</a><a class="geo-chip" href="#">Lake Charles</a><a class="geo-chip" href="/hoa-management/louisiana/shreveport">Shreveport</a></div>
    </div>
  </section>

  <section class="geo-why">
    <div class="container geo-why-grid">
      <div class="reveal">
        <div class="eyebrow eyebrow-blue">Why Louisiana boards choose CMGT</div>
        <h2 class="geo-why-h">Big enough to protect you. Close enough to know you.</h2>
        <p class="geo-why-p">We know Louisiana’s parishes, its insurance realities, and its weather. When a storm is in the Gulf, we’re not learning your community on the fly — we already know it.</p>
        <ul class="geo-svc">
          <li><a href="/hoa-management-services">Full-service HOA management</a></li>
          <li><a href="/condo-management">Condo &amp; townhome management</a></li>
          <li><a href="/hoa-financial-management">Financial &amp; Administrative Management</a></li>
          <li><a href="/developer-hoa-management">Developer &amp; new-community services</a></li>
        </ul>
      </div>
      <div class="geo-why-media reveal">
        <ImageSlot src="/photos/la-geo-why-photo.webp" alt="A CMGT community manager meeting warmly with Louisiana homeowners outside a neighborhood clubhouse" shape="rounded" radius={20} />
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="sec-head reveal">
        <div class="eyebrow eyebrow-green">What a Louisiana board hands off</div>
        <h2 class="sec-h">Everything that used to land on a volunteer’s kitchen table.</h2>
        <p class="sec-sub">A dedicated Community Association Manager owns the relationship — backed by in-house specialists so nothing falls through the cracks between meetings.</p>
      </div>
      <div class="feat-grid reveal">
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">Finances &amp; reporting</h3><p class="feat-p">Full P&amp;L and balance sheet to the entire membership by the 20th of every month — it’s written into our management agreement, not promised verbally.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">Dues &amp; collections</h3><p class="feat-p">A consistent, compassionate billing process keeps our communities at roughly 10% delinquency — without souring neighbor relationships.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">Covenants &amp; ARC</h3><p class="feat-p">Fair, documented enforcement and architectural review — we educate before the first violation rather than leading with a fine.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">Vendors &amp; maintenance</h3><p class="feat-p">Bidding, oversight, and site visits so common areas stay in the shape your homeowners expect — and so the board isn’t chasing contractors.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">Homeowner communication</h3><p class="feat-p">Plain-language answers you can actually get, a board portal, and an app — 70% of our owners use the portal and over half pay online.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">Insurance &amp; reserves</h3><p class="feat-p">A dedicated Insurance &amp; Reserve department tracks coverage and reserve health year-round — critical in a state where one storm can reprice a master policy.</p></div>
      </div>
    </div>
  </section>

  <section class="proof-band">
    <div class="container proof-in">
      <h2 class="proof-h">Your manager lives here. The <em>whole team</em> has their back.</h2>
      <div class="proof-grid reveal">
        <div><div class="proof-num"><span data-count-to="300" data-suffix="+">300+</span></div><div class="proof-label">communities right here in Louisiana</div></div>
        <div><div class="proof-num"><span data-count-to="96" data-suffix="%">96%</span></div><div class="proof-label">client retention, by dollar value</div></div>
        <div><div class="proof-num"><span data-prefix="~" data-count-to="10" data-suffix="%">~10%</span></div><div class="proof-label">average delinquency across our communities</div></div>
        <div><div class="proof-num">Responsive</div><div class="proof-label">real answers and steady follow-through</div></div>
      </div>
    </div>
  </section>

  <section class="sec sec-alt">
    <div class="container">
      <div class="sec-head reveal">
        <div class="eyebrow eyebrow-green">Built for Louisiana</div>
        <h2 class="sec-h">We didn’t move here for the market. We started here.</h2>
      </div>
      <div class="prose reveal">
        <p>CMGT opened with a single community in Denham Springs in 2007 and grew across the state one referral at a time. When the <strong>2016 flood</strong> put much of the capital region underwater, we were closed for four days — then back at work for the communities that needed us most. That’s not a case study we bought; it’s our own backyard.</p>
        <p>Louisiana management is its own discipline. Coverage and reserves move with every Gulf storm season, parish rules and recording practices vary, and homeowners expect a manager who already understands all of it. Because our managers live in the markets they serve, <strong>we’re not learning your community when the storm is already in the Gulf</strong> — we know it before the first cone is drawn.</p>
        <p>Want the details? See <a href="/hoa-management-services">how full-service management works</a>.</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="sec-head reveal">
        <div class="eyebrow eyebrow-green">Questions Louisiana boards ask</div>
        <h2 class="sec-h">Straight answers, no industry-speak.</h2>
      </div>
      <div class="acc-list reveal">
        <div class="acc-item"><button class="acc-q" type="button">Where in Louisiana does CMGT actually operate?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">We manage communities from the Northshore through Acadiana and the capital region, with teams serving Baton Rouge, Denham Springs, New Orleans, Lafayette, Lake Charles, and Shreveport. Our headquarters is in Denham Springs — <strong>we’re a Louisiana company, not a national brand with a satellite office.</strong></div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">How does CMGT handle hurricane season?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">Storm planning, vendor mobilization, and owner communication are built in before the season starts, and our Insurance &amp; Reserve department monitors coverage year-round. See our <a href="/resources/hurricane-preparedness-for-hoas">hurricane preparedness guide for HOA communities</a>.</div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">We’re a small community — are we too small for you?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">No. Our <a href="/hoa-financial-management">Financial &amp; Administrative package</a> was built for 30–100-home communities that want professional books and reporting without full-service overhead.</div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">What does it take to switch from our current manager?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">We handle records, vendors, finances, and homeowner communication on a clear Day 1 to Day 90 timeline. <a href="/switching-hoa-management-companies">See exactly how the transition works.</a></div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">When do we see our financials?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in"><strong>By the 20th of every month</strong>, and we share the full P&amp;L and balance sheet with the entire membership — not just the board. Transparency is the whole point.</div></div></div>
      </div>
    </div>
  </section>

  <section class="sec sec-alt">
    <div class="container">
      <div class="sec-head reveal">
        <div class="eyebrow eyebrow-green">Keep reading</div>
        <h2 class="sec-h">Resources for Louisiana boards.</h2>
      </div>
      <div class="rel-grid reveal">
        <a class="rel-card" href="/resources/hoa-reserve-study"><div class="rel-kicker">Guide</div><h3 class="rel-h">HOA reserve studies, explained</h3><p class="rel-p">When to do one, how often, and how it protects your community from surprise assessments.</p><span class="rel-go">Read the guide <span class="arrow">→</span></span></a>
        <a class="rel-card" href="/resources/hurricane-preparedness-for-hoas"><div class="rel-kicker">Seasonal</div><h3 class="rel-h">Hurricane prep for HOAs</h3><p class="rel-p">The board plan and homeowner communications that get a Gulf South community through a storm.</p><span class="rel-go">Get ready <span class="arrow">→</span></span></a>
        <a class="rel-card" href="/hoa-financial-management"><div class="rel-kicker">Service</div><h3 class="rel-h">Financial &amp; Administrative Management</h3><p class="rel-p">Professional books, transparent reporting, and lower delinquency for smaller communities.</p><span class="rel-go">See the package <span class="arrow">→</span></span></a>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container cta-in">
      <div class="reveal">
        <h2 class="cta-h">On the board of a Louisiana community?</h2>
        <p class="cta-p">Tell us what your community needs and we'll put together a proposal — a real person follows up within two business days. No pitch deck, no pressure.</p>
      </div>
      <div class="cta-actions reveal">
        <a class="btn btn-blue" href="/request-a-proposal">Request a proposal <span class="arrow">→</span></a>
        <a class="cta-phone" href="tel:2255032648">Or call (225) 503-2648 · Mon–Fri, 8:30a–4:30p CT</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }
  .geo-hero { background: var(--freedom-blue); color: #fff; padding: 92px 0 0; position: relative; overflow: hidden; isolation: isolate; }
  .geo-hero::after { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 16% 18%, rgba(141,189,255,.12) 0%, transparent 55%); z-index: 0; pointer-events: none; }
  .geo-hero-top { position: relative; z-index: 2; display: grid; grid-template-columns: 1.15fr .85fr; gap: 64px; align-items: end; padding-bottom: 60px; }
  @media (max-width: 980px) { .geo-hero-top { grid-template-columns: 1fr; gap: 30px; } }
  .geo-hero .eyebrow { color: rgba(255,255,255,.65); }
  .geo-hero-h { font-family: var(--font-display); font-weight: 900; font-size: clamp(42px, 5.4vw, 80px); line-height: 1.0; letter-spacing: -.03em; margin: 20px 0 0; text-wrap: balance; }
  .geo-hero-h em { font-style: italic; font-weight: 300; color: var(--landscaping-green); }
  .geo-hero-lede { font-size: 17.5px; line-height: 1.7; color: rgba(255,255,255,.82); margin: 0 0 30px; }
  .geo-hero-lede strong { color: #fff; font-weight: 600; }
  .geo-hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .geo-band :global(.image-slot) { display: block; width: 100%; height: clamp(280px, 32vw, 400px); position: relative; z-index: 2; }
  .geo-stats { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; padding: 30px 0; border-top: 1px solid rgba(255,255,255,.18); }
  @media (max-width: 620px) { .geo-stats { grid-template-columns: 1fr; gap: 18px; } }
  .geo-stat-num { font-family: var(--font-display); font-weight: 700; font-size: 38px; line-height: 1; letter-spacing: -.02em; color: #fff; }
  .geo-stat-label { font-size: 12.5px; color: rgba(255,255,255,.6); margin-top: 7px; }

  .geo-intro { background: #fff; padding: 104px 0; }
  .geo-intro-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 64px; align-items: start; }
  @media (max-width: 860px) { .geo-intro-grid { grid-template-columns: 1fr; gap: 22px; } }
  .geo-intro-label { font-family: var(--font-display); font-weight: 300; font-style: italic; font-size: clamp(24px, 2.8vw, 34px); color: var(--landscaping-green); line-height: 1.15; }
  .geo-intro-p { font-size: 17px; line-height: 1.75; color: var(--ink-700); margin: 0 0 18px; }
  .geo-intro-p:last-child { margin-bottom: 0; }
  .geo-intro-p strong { color: var(--freedom-blue); font-weight: 600; }

  .geo-cities { background: var(--nb-lightest); padding: 100px 0; }
  .geo-cities-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
  .geo-cities-sub { font-size: 16px; line-height: 1.7; color: var(--ink-500); margin: 0 0 36px; max-width: 600px; }
  .geo-chips { display: flex; flex-wrap: wrap; gap: 12px; }
  .geo-chip { font-family: var(--font-display); font-weight: 700; font-size: 17px; color: var(--freedom-blue); background: #fff; border: 1.5px solid var(--hairline-strong); border-radius: 999px; padding: 12px 22px; text-decoration: none; transition: border-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .geo-chip:hover { border-color: var(--landscaping-green); transform: translateY(-2px); }

  .geo-why { background: #fff; padding: 104px 0; }
  .geo-why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  @media (max-width: 920px) { .geo-why-grid { grid-template-columns: 1fr; gap: 32px; } }
  .geo-why-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(26px, 3.2vw, 40px); line-height: 1.14; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 16px; text-wrap: balance; }
  .geo-why-p { font-size: 16px; line-height: 1.75; color: var(--ink-500); margin: 0 0 16px; max-width: 540px; }
  .geo-why-p strong { color: var(--freedom-blue); font-weight: 600; }
  .geo-why-media :global(.image-slot) { width: 100%; height: 400px; }
  .geo-svc { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .geo-svc li { font-size: 15px; color: var(--ink-700); padding-left: 26px; position: relative; }
  .geo-svc li::before { content: ""; position: absolute; left: 0; top: 7px; width: 9px; height: 9px; border-radius: 50%; background: var(--landscaping-green); }
  .geo-svc a { color: var(--freedom-blue); font-weight: 600; text-decoration: none; border-bottom: 2px solid transparent; transition: border-color var(--dur-base) var(--ease-out); }
  .geo-svc a:hover { border-bottom-color: var(--landscaping-green); }

  .cta { background: var(--landscaping-green); color: var(--freedom-blue); padding: 100px 0; position: relative; overflow: hidden; }
  .cta .leaf { position: absolute; left: -110px; bottom: -150px; width: 460px; height: 460px; opacity: .14; transform: rotate(14deg); pointer-events: none; }
  .cta .leaf img { filter: brightness(0) saturate(100%) invert(11%) sepia(64%) saturate(4147%) hue-rotate(238deg) brightness(85%) contrast(96%); }
  .cta-in { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .cta-h { font-family: var(--font-display); font-weight: 900; font-size: clamp(32px, 4.4vw, 56px); line-height: 1.02; letter-spacing: -.02em; margin: 0 0 10px; text-wrap: balance; }
  .cta-p { font-size: 16.5px; line-height: 1.6; max-width: 480px; margin: 0; color: rgba(30,30,119,.82); }
  .cta-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .cta-phone { font-size: 14px; font-weight: 600; color: rgba(30,30,119,.75); text-decoration: none; }

  /* Law-page callout band */
  @media (max-width: 720px) { .law-band { padding: 0 0 64px; } .law-band-in { padding: 30px 26px; gap: 24px; } }
</style>
