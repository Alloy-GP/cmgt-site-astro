    },
    {
      "@type": "City",
      "name": "Central"
    },
    {
      "@type": "City",
      "name": "Walker"
    }
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday"
      ],
