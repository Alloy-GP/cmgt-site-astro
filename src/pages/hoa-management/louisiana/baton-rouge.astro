    }
  ]
};

// Composed from the visible FAQ below — the handoff template's {FAQ_JSONLD} token had
// no value in city-pages-data.json, so regenerating from it would emit a literal token.
const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Are you actually based in the Baton Rouge area?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Our office is at 140 Aspen Square Ste H in Denham Springs, and it has been our home since the company started in 2007. We're a Louisiana company with a Louisiana office — not a national brand with a satellite listing."
      }
    },
    {
      "@type": "Question",
      "name": "Which communities near Baton Rouge do you manage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We manage communities throughout East Baton Rouge, Livingston, and Ascension parishes — including Baton Rouge, Denham Springs, Prairieville, Gonzales, Zachary, Central, and Walker. Ask us for references in your specific area; we will happily connect you with a nearby board."
      }
    },
    {
      "@type": "Question",
      "name": "How does CMGT handle hurricane season here?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Storm planning, vendor mobilization, and owner communication are in place before the season starts, and our Insurance &amp; Reserve department monitors coverage year-round. See our hurricane preparedness guide for HOA communities."
      }
    },
    {
      "@type": "Question",
      "name": "We're a small community — are we too small for you?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Our Financial &amp; Administrative package was built for 30–100-home communities that want professional books and reporting without full-service overhead."
      }
