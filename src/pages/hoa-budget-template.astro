---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';

const breadcrumb = breadcrumbSchema([
  { name: 'Home',                url: SITE.url + '/' },
  { name: 'Resources',           url: SITE.url + '/resources' },
  { name: 'Finances & Reserves', url: SITE.url + '/hoa-budget-template' },
]);
---
<BaseLayout
  title="Free HOA Budget Template + How to Build One — CMGT"
  description="A free HOA budget template plus a plain-English guide to building an annual operating budget that funds reserves and avoids surprise assessments."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"Resources","href":"/resources"},{"t":"Finances & Reserves"}]'></nav>

  <article>
    <header class="art-hero">
      <div class="container art-hero-in">
        <div class="art-cat">Finances &amp; Reserves</div>
        <h1 class="art-h1">Build an HOA budget that actually holds.</h1>
        <p class="art-lede">A good annual budget is the difference between a calm year and a special assessment. Here’s how to build one — and a free template to start from.</p>
        <div class="art-meta"><span>6 min read</span><span class="dot"></span><span>Updated June 2026</span></div>
      </div>
    </header>

    <div class="art-body">
      <div class="container art-wrap">
        <div class="art-take reveal">
          <p class="art-take-h">The short version</p>
          <p class="art-take-p">Budget from last year’s actuals, fund reserves as a fixed line (not leftovers), and leave room for contingencies. Our free template walks your board through every category.</p>
        </div>
        <h2 class="art-h2">Start from actuals, not optimism</h2><p class="art-p">The most common budgeting mistake is wishful thinking — assuming costs will hold flat or that delinquency will magically improve. Start from what you actually spent last year, adjust for known increases (insurance, utilities, contracts), and be honest about collection rates.</p><h2 class="art-h2">Treat reserves as a fixed cost</h2><p class="art-p">Reserve contributions belong at the top of the budget as a non-negotiable line, funded at the level your reserve study recommends — not whatever’s left at the bottom. A budget that shortchanges reserves is just borrowing from your future self.</p><h2 class="art-h2">Leave room for the unexpected</h2><p class="art-p">A contingency line — even a small percentage — keeps a single surprise from blowing up the whole year. In the Gulf South, that buffer earns its place every storm season.</p>

      <div class="art-dl reveal">
        <div class="art-dl-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg></div>
        <div class="art-dl-body">
          <h3 class="art-dl-t">Get the free HOA budget template</h3>
          <p class="art-dl-d">A board-ready spreadsheet with every category laid out — operating costs, reserves, and contingency. Yours, no strings.</p>
        </div>
        <a class="btn btn-green" href="/request-a-proposal">Get the template <span class="arrow">→</span></a>
      </div>

      </div>
    </div>
  </article>

  <section class="rel">
    <div class="container">
      <h2 class="rel-h">Keep reading.</h2>
      <div class="rel-grid"><a class="rel-card" href="/hoa-financial-management"><span class="rel-t">HOA Financial Management</span><span class="rel-ar">→</span></a><a class="rel-card" href="/hoa-management-services"><span class="rel-t">Full-Service HOA Management</span><span class="rel-ar">→</span></a><a class="rel-card" href="/request-a-proposal"><span class="rel-t">Talk to our team</span><span class="rel-ar">→</span></a></div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta-in">
      <div><h2 class="cta-h">Want this handled for you?</h2><p class="cta-p">A real person will walk through your community’s situation — within one business day.</p></div>
      <div><a class="btn btn-blue" href="/request-a-proposal">Request a proposal <span class="arrow">→</span></a></div>
    </div>
  </section>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }
  .art-hero { background: var(--nb-lightest); padding: 76px 0 64px; }
  .art-hero-in { max-width: 820px; }
  .art-cat { font-family: var(--font-body); font-weight: 700; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--landscaping-green); }
  .art-h1 { font-family: var(--font-display); font-weight: 400; font-size: clamp(34px, 4.6vw, 60px); line-height: 1.04; letter-spacing: -.025em; color: var(--freedom-blue); margin: 16px 0 20px; text-wrap: balance; }
  .art-lede { font-size: clamp(17px, 2vw, 21px); line-height: 1.6; color: var(--ink-700); margin: 0 0 24px; text-wrap: pretty; }
  .art-meta { display: flex; gap: 18px; align-items: center; font-size: 13.5px; color: var(--ink-400); }
  .art-meta .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--hairline-strong); }
  .art-body { background: #fff; padding: 70px 0 100px; }
  .art-wrap { max-width: 720px; }
  .art-take { background: var(--fb-lightest); border-left: 4px solid var(--landscaping-green); border-radius: 0 12px 12px 0; padding: 24px 28px; margin: 0 0 44px; }
  .art-take-h { font-family: var(--font-body); font-weight: 700; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--freedom-blue); opacity: .6; margin: 0 0 8px; }
  .art-take-p { font-family: var(--font-display); font-weight: 500; font-size: 18px; line-height: 1.5; color: var(--freedom-blue); margin: 0; }
  .art-h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(24px, 2.8vw, 32px); line-height: 1.18; letter-spacing: -.015em; color: var(--freedom-blue); margin: 44px 0 16px; text-wrap: balance; }
  .art-p { font-size: 17px; line-height: 1.75; color: var(--ink-700); margin: 0 0 18px; }
  .art-p strong { color: var(--freedom-blue); font-weight: 600; }
  .art-dl { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; background: var(--freedom-blue); color: #fff; border-radius: 16px; padding: 30px 32px; margin: 44px 0; }
  .art-dl-ico { flex: none; width: 56px; height: 56px; border-radius: 14px; background: rgba(255,255,255,.1); display: flex; align-items: center; justify-content: center; color: var(--landscaping-green); }
  .art-dl-body { flex: 1; min-width: 200px; }
  .art-dl-t { font-family: var(--font-display); font-weight: 400; font-size: 21px; margin: 0 0 6px; }
  .art-dl-d { font-size: 14.5px; line-height: 1.6; color: rgba(255,255,255,.78); margin: 0; }
  .art-disclaimer { font-size: 13.5px; line-height: 1.6; color: var(--ink-400); border-top: 1px solid var(--hairline); padding-top: 20px; margin: 44px 0 0; font-style: italic; }
  .rel { background: var(--nb-lightest); padding: 90px 0; }
  .rel-h { font-family: var(--font-display); font-weight: 400; font-size: clamp(24px, 3vw, 36px); letter-spacing: -.015em; color: var(--freedom-blue); margin: 0 0 32px; }
  .rel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 760px) { .rel-grid { grid-template-columns: 1fr; } }
  .rel-card { display: flex; align-items: center; justify-content: space-between; gap: 16px; background: #fff; border: 1.5px solid var(--hairline-strong); border-radius: 14px; padding: 24px 26px; text-decoration: none; transition: border-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .rel-card:hover { border-color: var(--landscaping-green); transform: translateY(-2px); }
  .rel-t { font-family: var(--font-display); font-weight: 400; font-size: 17px; color: var(--freedom-blue); }
  .rel-ar { color: var(--landscaping-green); font-size: 18px; }
  .cta { background: var(--landscaping-green); color: var(--freedom-blue); padding: 90px 0; }
  .cta-in { display: flex; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .cta-h { font-family: var(--font-display); font-weight: 400; font-size: clamp(30px, 4vw, 50px); line-height: 1.04; letter-spacing: -.02em; margin: 0 0 10px; text-wrap: balance; }
  .cta-p { font-size: 16.5px; line-height: 1.6; max-width: 460px; margin: 0; color: rgba(30,30,119,.82); }
</style>
