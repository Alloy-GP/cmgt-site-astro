---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/config/site';
import { breadcrumbSchema } from '~/lib/schema';
import ImageSlot from '~/components/ImageSlot.astro';

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'How We Work', url: SITE.url + '/how-we-work' },
  { name: 'The Fix-It Squad', url: SITE.url + '/fix-it-squad' },
]);
---
<BaseLayout
  title="The Fix-It Squad — CMGT's In-House Maintenance Team"
  description="The Fix-It Squad is CMGT's in-house maintenance team — trusted technicians, fast response, and fair pricing, accountable to the same standard. Since 2019."
  pageSchema={breadcrumb}
>
  <nav id="site-breadcrumbs" aria-label="Breadcrumb" data-crumbs='[{"t":"Home","href":"/"},{"t":"How We Work","href":"/how-we-work"},{"t":"The Fix-It Squad"}]'></nav>

  <section class="fs-hero">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container fs-hero-in">
      <div class="eyebrow">In-house since 2019</div>
      <h1 class="fs-hero-h">The Fix-It Squad.</h1>
      <div class="fs-loc">Greater Baton Rouge &amp; surrounding areas</div>
      <p class="fs-hero-p">Our own maintenance crew for the communities we manage in the <strong>Greater Baton Rouge area</strong> — <strong>not a rolodex of subcontractors.</strong> Trusted technicians, fast response, and fair pricing, accountable to the same standard as the rest of the team.</p>
      <div class="fs-hero-ctas">
        <a class="btn btn-blue" href="https://fixitsquad.org/" target="_blank" rel="noopener noreferrer">Submit a maintenance request <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- SCOPE -->
  <section class="fs-scope">
    <div class="container">
      <p class="fs-scope-note"><strong>A benefit of CMGT management in the Greater Baton Rouge area and surrounding markets</strong> — not a standalone service you buy separately. For the communities we manage elsewhere, the same accountability comes through managed vendor coordination, and On-Site communities have a dedicated on-site maintenance lead.</p>
    </div>
  </section>

  <!-- DIFFERENCE -->
  <section class="diff">
    <div class="container diff-grid">
      <div class="reveal">
        <div class="eyebrow eyebrow-blue">Why in-house matters</div>
        <h2 class="diff-h">When the crew works for us, <em>they answer to you.</em></h2>
        <p class="diff-p">
          Most management companies hand your work order to whichever vendor picks up the phone.
          We built our own team instead. <strong>That means accountability runs straight back to
          CMGT</strong> — the same people managing your community also stand behind the repair.
        </p>
        <p class="diff-p">
          No mystery markups, no finger-pointing between manager and contractor, no waiting a
          week for a callback. Just our people, doing the work, owning the result.
        </p>
      </div>
      <div class="diff-media reveal">
        <ImageSlot src="/photos/baton-rouge-maintenance-service.webp" alt="A CMGT Fix-It Squad maintenance technician arriving with a tool bag to help a homeowner at a Greater Baton Rouge home" shape="rounded" radius={20} />
      </div>
    </div>
  </section>

  <!-- POINTS -->
  <section class="pts">
    <div class="container pts-grid">
      <div class="reveal"><h3 class="pt-t">Fast <span class="g">response</span></h3><p class="pt-d">In-house scheduling means we're not waiting on a third party to call you back. Urgent issues get triaged quickly.</p></div>
      <div class="reveal"><h3 class="pt-t">Fair <span class="g">pricing</span></h3><p class="pt-d">Transparent rates with no hidden vendor markups. You see what the work costs, and why.</p></div>
      <div class="reveal"><h3 class="pt-t">Trusted <span class="g">hands</span></h3><p class="pt-d">Background-checked technicians who represent CMGT — and treat your community like it's their own.</p></div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="svc">
    <div class="container">
      <div class="svc-head reveal">
        <div class="eyebrow eyebrow-blue">What the Squad handles</div>
        <h2 class="svc-h">The everyday work that keeps a community sharp.</h2>
        <p class="svc-sub">From routine upkeep to the storm-season scramble — handled by people who already know your property.</p>
      </div>
      <div class="svc-grid">
        <div class="svc-item reveal"><h3 class="svc-t">Common-Area Upkeep</h3><p class="svc-d">Clubhouses, gates, fences, signage, and lighting — kept clean, safe, and working.</p></div>
        <div class="svc-item reveal"><h3 class="svc-t">Repairs & Punch Lists</h3><p class="svc-d">The running list of small fixes that otherwise pile up between board meetings.</p></div>
        <div class="svc-item reveal"><h3 class="svc-t">Preventive Maintenance</h3><p class="svc-d">Scheduled upkeep that catches problems early — before they become special assessments.</p></div>
        <div class="svc-item reveal"><h3 class="svc-t">Turn & Make-Ready</h3><p class="svc-d">For our <a href="/rentals">Baton Rouge rental</a> owners: getting a unit rent-ready between tenants, fast.</p></div>
        <div class="svc-item reveal"><h3 class="svc-t">Storm Prep & Response</h3><p class="svc-d">Securing common areas ahead of Gulf weather and mobilizing quickly afterward.</p></div>
        <div class="svc-item reveal"><h3 class="svc-t">Vendor Coordination</h3><p class="svc-d">When a job needs a licensed specialty trade, we manage and stand behind that work too.</p></div>
      </div>
    </div>
  </section>

  <!-- QUOTE -->
  <section class="fq">
    <div class="container fq-in reveal">
      <div class="eyebrow eyebrow-blue">The whole idea</div>
      <p class="fq-q">We don't just report the issue. <span class="g">We come with the solution</span> — and the crew to fix it.</p>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="sec-head reveal">
        <div class="eyebrow eyebrow-green">How it works</div>
        <h2 class="sec-h">From reported to resolved — without the middleman.</h2>
        <p class="sec-sub">Because scheduling, the crew, and the manager all sit under one roof, a work order doesn’t bounce between companies waiting for someone to pick up.</p>
      </div>
      <div class="feat-grid reveal">
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">1 · Report</h3><p class="feat-p">A board member, homeowner, or resident logs the issue through the portal or a quick call — no chasing a vendor’s voicemail.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">2 · Triage</h3><p class="feat-p">We assess priority quickly. Anything urgent — safety, water, access — jumps the line immediately.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">3 · Fix</h3><p class="feat-p">A background-checked CMGT technician handles it on site. No third-party scheduling, no week-long callback gap.</p></div>
        <div class="feat-card"><div class="feat-ic" aria-hidden="true"></div><h3 class="feat-h">4 · Close-out</h3><p class="feat-p">The work is documented, the board sees what was done and what it cost, and the record lives with your community’s file.</p></div>
      </div>
    </div>
  </section>

  <section class="sec sec-alt">
    <div class="container">
      <div class="sec-head reveal">
        <div class="eyebrow eyebrow-green">Common questions</div>
        <h2 class="sec-h">Straight answers about the Squad.</h2>
      </div>
      <div class="acc-list reveal">
        <div class="acc-item"><button class="acc-q" type="button">Is the Fix-It Squad an extra cost?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">Having the Squad available <strong>comes standard with CMGT management.</strong> Actual repair work is billed at transparent rates with no hidden vendor markup — you see what the work costs and why.</div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">Do you still use outside contractors?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">When a job needs a licensed specialty trade — major electrical, roofing, elevators — we bring one in, manage the work, and stand behind the result. The accountability still runs back to CMGT.</div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">How fast is “fast response”?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">Urgent issues are triaged quickly. Because scheduling is in-house, we’re never waiting on a third party to call your community back.</div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">Can rental owners use the Squad?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">Yes — for our Greater Baton Rouge rental owners, the Squad handles turn and make-ready between tenants. <a href="/rentals">See rental management.</a></div></div></div>
        <div class="acc-item"><button class="acc-q" type="button">What happens during storm season?<span class="acc-sign" aria-hidden="true"></span></button><div class="acc-panel"><div class="acc-panel-in">We secure common areas ahead of Gulf weather and mobilize quickly afterward — one of the clearest advantages of a crew that already knows your property.</div></div></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="leaf" aria-hidden="true"><img src="/assets/leaf-mark.svg" alt=""></div>
    <div class="container cta-in">
      <div class="reveal">
        <h2 class="cta-h">Need something fixed?</h2>
        <p class="cta-p">Homeowners, boards, and residents in the communities we manage across the Greater Baton Rouge area — submit a request and our in-house crew takes it from there.</p>
        <p class="cta-sub">Not a CMGT community yet? <a href="/hoa-management-services">See HOA management →</a></p>
      </div>
      <div class="reveal"><a class="btn btn-blue" href="https://fixitsquad.org/" target="_blank" rel="noopener noreferrer">Submit a maintenance request <span class="arrow">→</span></a></div>
    </div>
  </section>
</BaseLayout>

<style>
  body { background: #fff; }
  .eyebrow-blue { color: var(--freedom-blue); opacity: .6; }

  /* HERO — green band */
  .fs-hero { background: var(--landscaping-green); color: var(--freedom-blue); padding: 92px 0 84px; position: relative; overflow: hidden; isolation: isolate; }
  .fs-hero .leaf { position: absolute; right: -150px; bottom: -190px; width: 700px; height: 700px; opacity: .13; transform: rotate(-8deg); z-index: 0; pointer-events: none; }
  .fs-hero .leaf img { width: 100%; filter: brightness(0) saturate(100%) invert(11%) sepia(64%) saturate(4147%) hue-rotate(238deg) brightness(85%) contrast(96%); }
  .fs-hero-in { position: relative; z-index: 2; max-width: 760px; }
  .fs-hero .eyebrow { color: rgba(30,30,119,.7); }
  .fs-hero-h { font-family: var(--font-display); font-weight: 900; font-size: clamp(46px, 6.2vw, 96px); line-height: .96; letter-spacing: -.03em; color: var(--freedom-blue); margin: 20px 0 22px; text-wrap: balance; }
  .fs-hero-h em { font-style: italic; font-weight: 300; }
  .fs-hero-p { font-size: 18px; line-height: 1.65; color: rgba(30,30,119,.85); max-width: 560px; margin: 0; }
  .fs-hero-p strong { color: var(--freedom-blue); font-weight: 700; }
  .fs-loc { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,.55); color: var(--freedom-blue); font-weight: 700; font-size: 13px; letter-spacing: .01em; padding: 7px 15px; border-radius: 999px; margin: 0 0 22px; }
  .fs-loc::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--landscaping-green); flex-shrink: 0; }
  .fs-hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; margin: 28px 0 0; }

  /* SCOPE NOTE */
  .fs-scope { background: #fff; padding: 40px 0 0; }
  .fs-scope-note { max-width: 760px; font-size: 15px; line-height: 1.7; color: var(--ink-700); margin: 0; padding: 20px 24px; background: var(--nb-lightest); border-left: 3px solid var(--landscaping-green); border-radius: 0 10px 10px 0; }
  .fs-scope-note strong { color: var(--freedom-blue); font-weight: 700; }

  /* DIFFERENCE */
  .diff { background: #fff; padding: 112px 0; }
  .diff-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  @media (max-width: 920px) { .diff-grid { grid-template-columns: 1fr; gap: 36px; } }
  .diff-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 18px; text-wrap: balance; }
  .diff-h em { font-style: italic; font-weight: 500; }
  .diff-p { font-size: 16.5px; line-height: 1.75; color: var(--ink-500); margin: 0 0 16px; max-width: 540px; }
  .diff-p strong { color: var(--freedom-blue); font-weight: 600; }
  .diff-media :global(.image-slot) { width: 100%; height: 440px; }

  /* STAT ROW */
  .pts { background: var(--freedom-blue); color: #fff; padding: 70px 0; }
  .pts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  @media (max-width: 760px) { .pts-grid { grid-template-columns: 1fr; gap: 32px; } }
  .pt-t { font-family: var(--font-display); font-weight: 700; font-size: 24px; color: #fff; margin: 0 0 8px; }
  .pt-t .g { color: var(--landscaping-green); }
  .pt-d { font-size: 14.5px; line-height: 1.6; color: rgba(255,255,255,.72); margin: 0; }

  /* SERVICES */
  .svc { background: #fff; padding: 112px 0; }
  .svc-head { max-width: 700px; margin: 0 0 56px; }
  .svc-h { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.12; letter-spacing: -.015em; color: var(--freedom-blue); margin: 16px 0 14px; text-wrap: balance; }
  .svc-sub { font-size: 16.5px; line-height: 1.7; color: var(--ink-500); margin: 0; }
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 44px; }
  @media (max-width: 880px) { .svc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .svc-grid { grid-template-columns: 1fr; } }
  .svc-item { border-top: 3px solid var(--landscaping-green); padding-top: 22px; }
  .svc-t { font-family: var(--font-display); font-weight: 700; font-size: 20px; line-height: 1.15; color: var(--freedom-blue); margin: 0 0 9px; }
  .svc-d { font-size: 14.5px; line-height: 1.65; color: var(--ink-500); margin: 0; }

  /* QUOTE */
  .fq { background: var(--nb-lightest); padding: 104px 0; }
  .fq-in { max-width: 900px; }
  .fq-q { font-family: var(--font-display); font-weight: 300; font-style: italic; font-size: clamp(26px, 3.4vw, 40px); line-height: 1.3; letter-spacing: -.01em; color: var(--freedom-blue); margin: 16px 0 0; text-wrap: balance; }
  .fq-q .g { color: var(--landscaping-green); font-style: normal; font-weight: 700; }

  /* CTA */
  .cta { background: var(--landscaping-green); color: var(--freedom-blue); padding: 100px 0; position: relative; overflow: hidden; }
  .cta .leaf { position: absolute; left: -110px; bottom: -150px; width: 460px; height: 460px; opacity: .14; transform: rotate(14deg); pointer-events: none; }
  .cta .leaf img { filter: brightness(0) saturate(100%) invert(11%) sepia(64%) saturate(4147%) hue-rotate(238deg) brightness(85%) contrast(96%); }
  .cta-in { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .cta-h { font-family: var(--font-display); font-weight: 900; font-size: clamp(32px, 4.4vw, 56px); line-height: 1.02; letter-spacing: -.02em; margin: 0 0 10px; text-wrap: balance; }
  .cta-p { font-size: 16.5px; line-height: 1.6; max-width: 480px; margin: 0; color: rgba(30,30,119,.82); }
  .cta-sub { font-size: 14.5px; line-height: 1.5; margin: 14px 0 0; color: rgba(30,30,119,.72); }
  .cta-sub a { color: var(--freedom-blue); font-weight: 600; text-decoration: none; border-bottom: 2px solid transparent; transition: border-color var(--dur-base) var(--ease-out); }
  .cta-sub a:hover { border-bottom-color: var(--freedom-blue); }
</style>
