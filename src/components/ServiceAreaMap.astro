---
/**
 * ServiceAreaMap.astro — a real Google map, styled to CMGT, showing where a
 * market's service areas actually are.
 *
 * Uses the Maps JavaScript API (not Static Maps): the site's existing key is
 * already authorised for Maps JS + Places — the one we use for the proposal
 * form's address autocomplete — whereas Static Maps is not in the key's API
 * restrictions and 403s. This avoids asking anyone to change key settings.
 *
 * Kept off the critical path: the SDK is only loaded when the map scrolls into
 * view (IntersectionObserver), so it can't block LCP the way an always-on embed
 * iframe would — a risk the city-page handoff explicitly calls out.
 *
 * Styled down to the CMGT palette (off-white land, brand-blue water, quiet
 * roads, no POI clutter) so it reads as part of the page. Markers are placed at
 * real coordinates: the office in brand green, each coverage area in brand blue.
 *
 * If the key is missing or the SDK fails, the static fallback panel stays
 * visible, so the section never renders as a broken box.
 */
export interface Props {
  /** Marker points, office first. */
  points: { name: string; lat: number; lng: number }[];
  zoom?: number;
  caption?: string;
  ariaLabel: string;
}
const { points, zoom = 9, caption, ariaLabel } = Astro.props;

// This project has two Google keys. The older "API key" is restricted to the
// Places APIs only — it powers the proposal form's address autocomplete, and using
// it for a map returns ApiTargetBlockedMapError. The "Maps Platform API Key" is the
// one authorised for Maps JavaScript. Prefer it, and fall back to the Places key so
// nothing hard-fails if only the one var is set.
// Read import.meta.env (inlined at build) and process.env (available at request
// time under the Vercel adapter). Vercel had the var set for Production+Preview yet
// it arrived undefined through import.meta.env alone, so check both rather than
// silently falling back to the Places key.
const env: Record<string, string | undefined> = {
  ...(typeof process !== 'undefined' && process.env ? process.env : {}),
  ...(import.meta.env as unknown as Record<string, string | undefined>),
};
const key =
  env.PUBLIC_GOOGLE_MAPS_PLATFORM_KEY ||
  env.PUBLIC_GOOGLE_MAPS_API_KEY ||
  '';
const id = 'svcmap-' + Math.random().toString(36).slice(2, 9);
---
<figure class="svcmap reveal" aria-label={ariaLabel}>
  <!-- Height is set inline as well as in CSS for two reasons: the host page's own
       scoped styles were collapsing the canvas, and an inline value can't be
       out-ranked. It must be `height`, not just `min-height` — the SDK's injected
       container uses height:100%, which resolves to 0 against a parent whose
       height is auto, so the map initialises but paints nothing. -->
  <div
    class="svcmap-canvas"
    style="height:clamp(260px,32vw,380px)"
    id={id}
    data-points={JSON.stringify(points)}
    data-zoom={zoom}
    data-key={key}
    role="img"
    aria-label={`Map showing ${points.map((p) => p.name).join(', ')}`}
  >
    <!-- Shown until (or unless) the map initialises. -->
    <div class="svcmap-idle">
      <span class="svcmap-idle-t">{points[0]?.name}</span>
      <span class="svcmap-idle-s">{points.length > 1 ? `+ ${points.length - 1} more areas` : 'Our office'}</span>
    </div>
  </div>
  <ul class="svcmap-key">
    {points.map((p, i) => (
      <li class={i === 0 ? 'is-office' : ''}>
        <span class="svcmap-dot" aria-hidden="true"></span>{p.name}{i === 0 ? ' — our office' : ''}
      </li>
    ))}
  </ul>
  {caption && <figcaption class="svcmap-cap">{caption}</figcaption>}
</figure>

<script is:inline>
  /* Lazy Google map init. One shared loader for the SDK; each map boots when it
     scrolls into view. Silent no-op without a key, leaving the idle panel up. */
  (function () {
    if (window.__cmgtMapInit) return;
    window.__cmgtMapInit = true;

    var STYLES = [
      { elementType: 'labels.icon', stylers: [{ visibility: 'off' }] },
      { elementType: 'labels.text.fill', stylers: [{ color: '#1E1E77' }] },
      { elementType: 'labels.text.stroke', stylers: [{ color: '#ffffff' }] },
      { featureType: 'administrative', elementType: 'geometry.stroke', stylers: [{ color: '#C9D8F0' }] },
      { featureType: 'administrative.land_parcel', stylers: [{ visibility: 'off' }] },
      { featureType: 'landscape', elementType: 'geometry', stylers: [{ color: '#F4F6FB' }] },
      { featureType: 'poi', stylers: [{ visibility: 'off' }] },
      { featureType: 'road', elementType: 'geometry.fill', stylers: [{ color: '#ffffff' }] },
      { featureType: 'road', elementType: 'geometry.stroke', stylers: [{ color: '#E2E6F0' }] },
      { featureType: 'road.highway', elementType: 'geometry.fill', stylers: [{ color: '#EAF1FF' }] },
      { featureType: 'road.highway', elementType: 'geometry.stroke', stylers: [{ color: '#C9D8F0' }] },
      { featureType: 'transit', stylers: [{ visibility: 'off' }] },
      { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#A1C8E7' }] },
      { featureType: 'water', elementType: 'labels.text.fill', stylers: [{ color: '#5B6079' }] },
    ];

    /* Resolves once google.maps.importLibrary actually exists.
       The bootstrap script's onload is NOT a reliable signal under
       loading=async: the namespace is attached before importLibrary is, so
       onload-then-call produced "importLibrary is not a function". Polling for
       the function itself is the only dependable gate — it also covers the
       proposal form's Places loader having already put a partial google.maps
       on the page. */
    function whenReady() {
      return new Promise(function (res, rej) {
        var t0 = Date.now();
        (function check() {
          if (window.google && window.google.maps && window.google.maps.importLibrary) return res();
          if (Date.now() - t0 > 10000) return rej(new Error('Maps SDK did not become ready'));
          setTimeout(check, 50);
        })();
      });
    }

    var injected = false;
    function loadSdk(key) {
      if (!injected && !(window.google && window.google.maps && window.google.maps.importLibrary)) {
        injected = true;
        var s = document.createElement('script');
        s.src = 'https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(key) + '&loading=async&v=weekly';
        s.async = true;
        document.head.appendChild(s);
      }
      return whenReady();
    }

    function pin(map, p, isOffice) {
      return new google.maps.Marker({
        map: map,
        position: { lat: p.lat, lng: p.lng },
        title: p.name,
        zIndex: isOffice ? 10 : 1,
        icon: {
          path: google.maps.SymbolPath.CIRCLE,
          scale: isOffice ? 9 : 6.5,
          fillColor: isOffice ? '#4ACF6C' : '#1E1E77',
          fillOpacity: 1,
          strokeColor: '#ffffff',
          strokeWeight: isOffice ? 3 : 2,
        },
      });
    }

    function boot(el) {
      var key = el.getAttribute('data-key');
      if (!key) return;
      var pts;
      try { pts = JSON.parse(el.getAttribute('data-points') || '[]'); } catch (e) { return; }
      if (!pts.length) return;

      loadSdk(key).then(function () {
        // With loading=async the bootstrap resolves before the map library is
        // present, so importLibrary must be awaited before constructing a Map.
        return google.maps.importLibrary('maps');
      }).then(function () {
        var map = new google.maps.Map(el, {
          zoom: parseInt(el.getAttribute('data-zoom'), 10) || 9,
          center: { lat: pts[0].lat, lng: pts[0].lng },
          styles: STYLES,
          disableDefaultUI: true,
          zoomControl: true,
          gestureHandling: 'cooperative',
          keyboardShortcuts: false,
        });
        pts.forEach(function (p, i) { pin(map, p, i === 0); });
        // Frame every marker, but don't zoom past the requested level on singles.
        if (pts.length > 1) {
          var b = new google.maps.LatLngBounds();
          pts.forEach(function (p) { b.extend({ lat: p.lat, lng: p.lng }); });
          map.fitBounds(b, 48);
        }
        el.classList.add('is-live');
      }).catch(function (err) {
        // Leave the idle panel visible, but say why — silently swallowing this
        // made a script-ordering bug look like a Google/key problem.
        if (window.console) console.warn('[ServiceAreaMap] map init failed:', err);
      });
    }

    function observeAll() {
      var maps = document.querySelectorAll('.svcmap-canvas');
      if (!maps.length) return;
      if (!('IntersectionObserver' in window)) {
        Array.prototype.forEach.call(maps, boot);
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { io.unobserve(e.target); boot(e.target); }
        });
      }, { rootMargin: '200px' });
      Array.prototype.forEach.call(maps, function (m) {
        if (!m.dataset.mapObserved) { m.dataset.mapObserved = '1'; io.observe(m); }
      });
    }

    // This script can execute before the canvases are in the DOM (Astro may place
    // it ahead of the markup, and there are several instances per page), so wait
    // for the document rather than querying immediately — that ordering bug is why
    // the maps silently never booted.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', observeAll);
    } else {
      observeAll();
    }
  })();
</script>

<style>
  .svcmap {
    margin: 30px 0 0;
    border: 1px solid var(--rule, #E2E6F0);
    border-radius: 14px;
    overflow: hidden;
    background: #F4F6FB;
  }
  .svcmap-canvas {
    position: relative;
    width: 100%;
    height: clamp(260px, 32vw, 380px);
    background: linear-gradient(135deg, #F4F6FB, #EAF1FF);
  }
  /* Idle state: a quiet branded panel until the map boots (or if it can't). */
  .svcmap-idle {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
  }
  .svcmap-canvas.is-live .svcmap-idle { display: none; }
  .svcmap-idle-t {
    font-family: var(--font-heading, inherit); font-weight: 800; font-size: 17px;
    color: var(--freedom-blue, #1E1E77);
  }
  .svcmap-idle-s { font-size: 13px; color: var(--muted, #5B6079); }
  .svcmap-key {
    display: flex; flex-wrap: wrap; gap: 8px 18px;
    margin: 0; padding: 14px 16px; list-style: none;
    background: #fff; border-top: 1px solid var(--rule, #E2E6F0);
  }
  .svcmap-key li {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-heading, inherit); font-weight: 600;
    font-size: 12.5px; color: var(--muted, #5B6079);
  }
  .svcmap-key li.is-office { color: var(--freedom-blue, #1E1E77); font-weight: 700; }
  .svcmap-dot { width: 9px; height: 9px; border-radius: 50%; flex: none; background: var(--freedom-blue, #1E1E77); }
  .svcmap-key li.is-office .svcmap-dot { background: var(--landscaping-green, #4ACF6C); }
  .svcmap-cap { margin: 0; padding: 0 16px 14px; font-size: 12px; color: var(--muted, #5B6079); background: #fff; }
</style>
