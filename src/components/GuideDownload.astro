---
/**
 * GuideDownload.astro — the free-spreadsheet callout used on Board Education Hub
 * guides that rank for "template" queries (reserve study, budget).
 *
 * Ungated on purpose: the reader arrived looking for a template, and a form in
 * front of the file costs more clicks than it captures. The footer newsletter form
 * is on every page for the soft ask, and GA4 enhanced measurement records the
 * .xlsx click as a file_download event without extra wiring.
 *
 * The files live in public/downloads and are generated by
 * scripts/build_templates.py — edit the numbers there, never by hand in Excel,
 * so the download and the article never disagree.
 */
interface Props {
  title: string;
  blurb: string;
  /** /downloads/*.xlsx */
  href: string;
  cta?: string;
  meta?: string;
}
const {
  title,
  blurb,
  href,
  cta = 'Download the template',
  meta = 'Excel file · opens in Google Sheets · free, no email required',
} = Astro.props;
const file = href.split('/').pop();
---
<aside class="gdl reveal" aria-label={title}>
  <div class="gdl-icon" aria-hidden="true">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 18 15 15"/></svg>
  </div>
  <div class="gdl-body">
    <p class="gdl-kicker">Free template</p>
    <h3 class="gdl-t">{title}</h3>
    <p class="gdl-d">{blurb}</p>
    <p class="gdl-meta">{meta}</p>
  </div>
  <a class="btn btn-green gdl-btn" href={href} download={file} data-download={file}>{cta} <span class="arrow">↓</span></a>
</aside>

<style>
  .gdl { display: grid; grid-template-columns: auto 1fr auto; gap: 22px; align-items: center; background: var(--fb-lightest); border: 1.5px solid var(--hairline-strong); border-left: 5px solid var(--landscaping-green); border-radius: 16px; padding: 26px 28px; margin: 30px 0; }
  @media (max-width: 720px) { .gdl { grid-template-columns: 1fr; gap: 14px; } .gdl-icon { display: none; } }
  .gdl-icon { width: 54px; height: 54px; border-radius: 14px; background: var(--freedom-blue); color: #fff; display: flex; align-items: center; justify-content: center; }
  .gdl-kicker { font-size: 11.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--freedom-blue); opacity: .65; margin: 0 0 6px; }
  .gdl-t { font-family: var(--font-display); font-weight: 700; font-size: 20px; line-height: 1.2; color: var(--freedom-blue); margin: 0 0 8px; }
  .gdl-d { font-size: 15px; line-height: 1.6; color: var(--ink-700); margin: 0 0 8px; }
  .gdl-meta { font-size: 12.5px; color: var(--ink-400); margin: 0; }
  .gdl-btn { white-space: nowrap; }
</style>
