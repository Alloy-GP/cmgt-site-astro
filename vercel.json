{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://usepastel.com https://*.usepastel.com"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "meet.cmgt.org"
        }
      ],
      "destination": "https://cmgt.org/meet?utm_source=meet.cmgt.org&utm_medium=redirect&utm_campaign=meet-cmgt",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/reviews?city=baton-rouge",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/reviews?city=shreveport",
      "schedule": "5 8 * * *"
    },
    {
      "path": "/api/reviews?city=lafayette",
      "schedule": "10 8 * * *"
    },
    {
      "path": "/api/reviews?city=daphne",
      "schedule": "15 8 * * *"
    },
    {
      "path": "/api/reviews?city=biloxi",
      "schedule": "20 8 * * *"
    },
    {
      "path": "/api/form-health",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/partial-sweep",
      "schedule": "*/5 * * * *"
    }
  ]
}
