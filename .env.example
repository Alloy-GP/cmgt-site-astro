# Copy this file to .env and fill in real values. Never commit .env to git.

# ── Resend ──────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Form send-failure alerts (Slack) ────────────────────────────
# Same Slack Incoming Webhook URL as the resend-slack-alerts project, so
# submission-side failures land in the same channel. Leave blank to disable
# (forms keep working; the helper just no-ops and logs a warning).
FORM_ALERT_SLACK_URL=https://hooks.slack.com/services/xxxx/xxxx/xxxx

# ── Mailchimp (delete these 3 lines if not using Mailchimp) ─────
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
MAILCHIMP_SERVER_PREFIX=us21
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxxxx

# ── Newsletter landing page (/newsletter) ───────────────────────
# Id of the Mailchimp CAMPAIGN folder named "CMGT Newsletter". The current
# issue + archive are read from the sent campaigns in this folder at build
# time. Unset → the page falls back to the seed in src/data/newsletter/current.json.
# Find it:  curl -s -u "anystring:$MAILCHIMP_API_KEY" \
#   "https://$MAILCHIMP_SERVER_PREFIX.api.mailchimp.com/3.0/campaign-folders?count=100" | jq '.folders[]|{id,name}'
MAILCHIMP_NEWSLETTER_FOLDER_ID=
# Vercel Deploy Hook URL — cmgt-site-astro → Settings → Git → Deploy Hooks
# (branch main). Fired by /api/newsletter-webhook when Mailchimp reports a
# campaign send, so the page rebuilds and the archive updates itself.
VERCEL_DEPLOY_HOOK_URL=
# Long random string. Append ?secret=<this> to the webhook URL you register in
# Mailchimp so only Mailchimp can trigger a rebuild. Optional but recommended.
MAILCHIMP_WEBHOOK_SECRET=

# ── Internal notifications ──────────────────────────────────────
INTERNAL_NOTIFY_EMAIL=owner@clientsite.com

# ── Google Analytics (leave blank to skip GA entirely) ──────────
GA_MEASUREMENT_ID=G-XXXXXXXXXX
